@inject IHttpContextAccessor HttpContextAccessor
@model DTOTokenRequestForIAM
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" type="image/x-icon" asp-href-include="/images/AFSAC.png">
    <title> E-ISAC </title>
    @*  <link asp-href-include="/Fonts/css/all.min.css" rel="stylesheet" type="text/css"> *@

    <link asp-href-include="~/css/style.css" rel="stylesheet" />
    <link asp-href-include="~/css/nunito.css" rel="stylesheet" />
    <link asp-href-include="~/css/roboto.css" rel="stylesheet" />
    <link asp-href-include="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <link asp-href-include="~/css/login.css" rel="stylesheet" />

    <link asp-href-include="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link asp-href-include="~/css/feed.css" rel="stylesheet" />

    <link asp-href-include="~/css/normalize.min.css" rel="stylesheet" />
    @*   <link asp-href-include="~/css/swiper.min.css" rel="stylesheet" /> *@
    <link asp-href-include="~/css/feed.css" rel="stylesheet" />
    <link asp-href-include="~/css/main.css" rel="stylesheet" />
    @*     <link asp-href-include="~/css/sliders/style.css" rel="stylesheet" /> *@
    <link asp-href-include="~/developercss/tokenvalidateforiam.css" rel="stylesheet" />
</head>
@{
    DTOTempSession? dTOTempSession = new DTOTempSession();
    StringBuilder m1 = new StringBuilder();
    StringBuilder m2 = new StringBuilder();
    if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("IMData")))
    {
        dTOTempSession = SessionHeplers.GetObject<DTOTempSession>(HttpContextAccessor.HttpContext.Session, "IMData");
        m1.Append("Status : " + dTOTempSession.Status);
        m1.Append(",<br/> AdminFlag : " + dTOTempSession.AdminFlag);
        m1.Append(",<br/> DomainId : " + dTOTempSession.DomainId);
        m1.Append(",<br/> RoleName : " + dTOTempSession.RoleName);
        m1.Append(",<br/> ICNO : " + dTOTempSession.ICNO);
        m1.Append(",<br/> UserId : " + dTOTempSession.UserId);
        m1.Append(",<br/> TDMUnitMapId : " + dTOTempSession.TDMUnitMapId);
        m1.Append(",<br/> TDMId : " + dTOTempSession.TDMId);
        m1.Append(",<br/> AspNetUsersId : " + dTOTempSession.AspNetUsersId);

        m2.Append("ICNoDomainId : " + dTOTempSession.ICNoDomainId);
        m2.Append(",<br/> ICNoTrnDomainMappingUnitId : " + dTOTempSession.ICNoTDMUnitMapId);
    }
}
<body>
@*     <div class="watermark">
        <div>
            <img src="/Images/dgislogo.png" alt="Watermark" loading="lazy">
        </div>
    </div> *@
    <div class="page">
        <div class="container-fluid">
            <partial name="~/Views/Shared/_CommonHeader.cshtml" />
            <span class="d-none" id="spnlogoutDomainId">@ViewBag.DomainId</span>
            <span class="d-none" id="spnlogoutAppName">@ViewBag.AppName</span>
            <span class="d-none" id="spnlogoutRoleName">@ViewBag.RoleName</span>
            <div class="row">
                <div class="bg-white login-wrap align-items-center">
                    <div class="login py-2 py-sm-4">
                        <div class="row">
                            <div class="col-md-10 col-lg-10 col-xl-9 mx-auto">
                                <div class="card-sigin">
                                    <div class="main-signup-header login-form">
                                        <span id="spnhdns" class="d-none">@ViewBag.hdns</span>
                                        <p class="font-weight-normal font-weight-700 text-center mb-4 mt-1 ">Kindly Validate your IC Number here.</p>
                                        <div class="pb-3 mt-3">
                                            <form asp-antiforgery="true" method="post" asp-action="TokenValidate" autocomplete="off" role="form">
                                                <div class="form-group">
                                                    <label class="labeltoken">Army No</label>
                                                    @if (dTOTempSession.IsToken==true)
                                                    {
                                                        <input asp-for="ICNo" class="form-control js-uppercase" placeholder="Enter IC No Ex.IC/SS/SLXXXXXP" autocomplete="off" readonly />
                                                    }
                                                    else
                                                    {
                                                        <input asp-for="ICNo" class="form-control js-uppercase" placeholder="Enter IC No Ex.IC/SS/SLXXXXXP" autocomplete="off" />
                                                    }

                                                    <span asp-validation-for="ICNo" class="text-danger"></span>
                                                    <label id="tokenmsg"></label>
                                                </div>
                                                <div class="text-center" >
                                                    @if (dTOTempSession != null && dTOTempSession.IsToken == true)
                                                    {
                                                        <button type="button" class="btn btn-primary mt-2" id="btnTokenFetchDetails">Refresh To Fetch Token Details</button>
                                                    }
                                                    @if (dTOTempSession != null)
                                                    {
                                                        <button type="submit" id="btnProceed" class="btn btn-primary mt-2">Proceed</button>
                                                    } 
                                                </div>
                                                
                                                @if (TempData["success"] != null)
                                                {
                                                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                                                        <span class="text-success">@Html.Raw(@TempData["success"])</span>
                                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                                    </div>
                                                }
                                                @if (TempData["error"] != null)
                                                {
                                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                        <span class="text-danger">@Html.Raw(@TempData["error"])</span>
                                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                                    </div>
                                                }
                                               
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer class="fixed-bottom">
        <section class="page_copyright ls section_padding_25">
            <div class="container">
                <div class="row">
                    <div class="col-sm-12 text-center">
                        <div class="footer-content">
                            @if (ViewBag.Footer != null)
                            {
                                @ViewBag.Footer
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </footer>
    <script asp-src-include="~/lib/jquery/jquery.min.js"></script>
    <script asp-src-include="~/lib/jquery-validate/jquery.validate.js" defer></script>
    <script asp-src-include="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" defer></script>
    <script asp-src-include="~/developerjs/KeyConstants.js"></script>
    <script asp-src-include="~/developerjs/token.js"></script>
    <script asp-src-include="~/bootstrap/js/bootstrap.min.js"></script> 
    <script asp-src-include="~/sweetalert2/sweetalert2.min.js"></script>
    <script asp-src-include="~/lib/crypto-js/crypto-js.min.js"></script>
    <script asp-src-include="~/developerjs/logoutlog.js"></script>

</body>
</html>

@section Scripts{
}
