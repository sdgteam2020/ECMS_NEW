@inject IConfiguration configuration;
@{
    ViewData["Title"] = "User Regn";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<link href="@($"{Cdn}/developercss/userregn.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > User Registration

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        User Registration Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row">
                <div class="col-xl-6">
                </div>
                <div class="col-xl-6">
                    <div class="d-flex d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            &nbsp;
                        </h6>
                        <div class="d-flex">
                        </div>
                    </div>
                </div>
                <div class="d-flex mt-1 mb-1">
                    <button class="count-label" id="btnUser" name="btnUser">Total Users <br /><span id="lblUser">0</span></button>
                    <button class="count-label" id="btnMappedUser" name="btnMappedUser">Mapped <br /><span id="lblMappedUser">0</span></button>
                    <button class="count-label" id="btnUnMappedUser" name="btnUnMappedUser">Not Mapped <br /><span id="lblUnMappedUser">0</span></button>
                    <button class="count-label" id="btnActiveUser" name="btnActiveUser">Active <br /><span id="lblActiveUser">0</span></button>
                    <button class="count-label" id="btnInActiveUser" name="btnActiveUser">Inactive <br /><span id="lblInActiveUser">0</span></button>
                    <button class="count-label" id="btnVerified" name="btnVerified">Verified <br /><span id="lblVerifiedUser">0</span></button>
                    <button class="count-label" id="btnNotVerifiedUser" name="btnNotVerifiedUser">Not Verified <br /><span id="lblNotVerifiedUser">0</span></button>
                    
                </div>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/mtables.js?v={configuration["StaticVersion"]}")"></script>
<script src="@($"{Cdn}/developerjs/userregn.js?v={configuration["StaticVersion"]}")"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="AddDomainFlag" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Update Approval / Active of Domain</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="UpdateDomainFlag" name="UpdateDomainFlag" method="post">
                        <div class="row">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Domain ID</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDomainId"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Role<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblRole"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label col-sm-4 fw-bold">Approval<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtapproval" value="true" id="txtapprovalyes" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="txtapprovalyes">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtapproval" value="false" id="txtapprovalno" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="txtapprovalno">
                                            No
                                        </label>
                                    </div>
                                    <span class="text-danger field-validation-valid" id="txtapproval-error"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label col-sm-4 fw-bold">Active<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtactive" value="true" id="txtactiveyes" data-val="true" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="txtactiveyes">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtactive" value="false" id="txtactiveno" data-val="true" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="txtactiveno">
                                            No
                                        </label>
                                    </div>
                                    <span class="text-danger field-validation-valid" id="txtactive-error"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Message for User</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1 textarea-auto-height" name="txtadminmessage" id="txtadminmessage" rows="3" maxlength="200" data-val-maxlength="Maximum length of Message is 200 character." data-val-maxlength-max="200" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtadminmessage" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Appointment Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblAppointmentName"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblUnitName"></label>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <label id="lblSusno" class="col-form-label unit-label-background"></label>
                                </div>
                            </div>
                            <div id="lbl1" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">PSO / Dte</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblPso"></label>
                                </div>
                            </div>
                            <div id="lbl2" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">DG / Sub Dte</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDG"></label>
                                </div>
                            </div>
                            <div id="lbl3" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Comd / PSO</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblComd"></label>
                                </div>
                            </div>
                            <div id="lbl4" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Corps / Dte / Area</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblCorps"></label>
                                </div>
                            </div>
                            <div id="lbl5" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Div / Branch / Sub Area</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDiv"></label>
                                </div>
                            </div>
                            <div id="lbl6" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Bde</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblBde"></label>
                                </div>
                            </div>
                            <div id="lbl7" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Type of Fmn / Branch</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblFmn"></label>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnDomainFlag" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>

<div class="modal fade" id="AddMapping" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel_AddMapping">Mapping Add / Remove</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body model-body-background">
                <div class="row">
                    <form action="" id="SaveMapping" name="SaveMapping" method="post">
                        <div class="row">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 model-body-label fw-bold">Domain ID</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDomainIdForMapping"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Role</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblRoleForMapping"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label col-sm-4 fw-bold">Approval</label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtapproval" value="true" id="txtapprovalyesForMapping" disabled>
                                        <label class="form-check-label" for="txtapprovalyesForMapping">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtapproval" value="false" id="txtapprovalnoForMapping" disabled>
                                        <label class="form-check-label" for="txtapprovalnoForMapping">
                                            No
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label col-sm-4 fw-bold">Active</label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtactive" value="true" id="txtactiveyesForMapping" disabled>
                                        <label class="form-check-label" for="txtactiveyesForMapping">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="txtactive" value="false" id="txtactivenoForMapping" disabled>
                                        <label class="form-check-label" for="txtactivenoForMapping">
                                            No
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Appointment Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblAppointmentNameForMapping"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblUnitNameForMapping"></label>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <label id="lblSusnoForMapping" class="col-form-label unit-label-background"></label>
                                </div>
                            </div>
                            <div id="lblM1" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">PSO / Dte</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblPsoForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM2" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">DG / Sub Dte</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDGForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM3" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Comd / PSO</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblComdForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM4" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Corps / Dte / Area</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblCorpsForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM5" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Div / Branch / Sub Area</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblDivForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM6" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Bde</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblBdeForMapping"></label>
                                </div>
                            </div>
                            <div id="lblM7" class="row mb-2 d-none">
                                <label class="col-form-label col-sm-4 fw-bold">Type of Fmn / Branch</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblFmnForMapping"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Army No</label>
                                <div class="col-sm-8">
                                    <input class="form-control alpha-num-only" placeholder="Enter Army No" id="txtArmyNo" name="txtArmyNo" minlength="7" maxlength="15" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-regex-pattern="^[\w\-]+$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Rank</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblRank"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblName"></label>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnAddMapping" />
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>

<div class="modal fade" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel_DataTableDialog"><span id="lblModelTitle"></span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                     <table class="table table-striped table-hover border border-purple" role="grid" id="tbldatadialog">
                    </table>
                </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>