@{
    ViewData["Title"] = "User Regn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/userregn.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>User Registration</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-screen-stage ecms-bg">
    <main class="ecms-page ecms-page-full ecms-fit-screen ecms-userregn-page">
        <section class="ecms-card ecms-userregn-shell">
            <div class="ecms-page-title ecms-user-title-row">
                <div class="ecms-user-title-content">
                    <span class="ecms-title-icon" aria-hidden="true"><i class="fa fa-user-plus"></i></span>
                    <div class="ecms-user-title-copy">
                        <h3>User Registration Details</h3>
                        <p class="ecms-title-subtitle">Update, approve, activate and map user registration records</p>
                    </div>
                </div>
                <span class="ecms-user-title-pill"><i class="fa fa-users-cog mr-1"></i>User Config</span>
            </div>

            <section class="ecms-user-stats" aria-label="User registration summary">
                <button type="button" class="ecms-tile ecms-stat-card" id="btnUser" name="btnUser">
                    <span class="ecms-stat-icon"><i class="fa fa-users"></i></span>
                    <span class="ecms-stat-title">Total Users</span>
                    <span class="ecms-stat-count" id="lblUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnMappedUser" name="btnMappedUser">
                    <span class="ecms-stat-icon"><i class="fa fa-link"></i></span>
                    <span class="ecms-stat-title">Mapped</span>
                    <span class="ecms-stat-count" id="lblMappedUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnUnMappedUser" name="btnUnMappedUser">
                    <span class="ecms-stat-icon"><i class="fa fa-unlink"></i></span>
                    <span class="ecms-stat-title">Not Mapped</span>
                    <span class="ecms-stat-count" id="lblUnMappedUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnActiveUser" name="btnActiveUser">
                    <span class="ecms-stat-icon"><i class="fa fa-check-circle"></i></span>
                    <span class="ecms-stat-title">Active</span>
                    <span class="ecms-stat-count" id="lblActiveUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnInActiveUser" name="btnActiveUser">
                    <span class="ecms-stat-icon"><i class="fa fa-times-circle"></i></span>
                    <span class="ecms-stat-title">Inactive</span>
                    <span class="ecms-stat-count" id="lblInActiveUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnVerified" name="btnVerified">
                    <span class="ecms-stat-icon"><i class="fa fa-shield-alt"></i></span>
                    <span class="ecms-stat-title">Verified</span>
                    <span class="ecms-stat-count" id="lblVerifiedUser">0</span>
                </button>

                <button type="button" class="ecms-tile ecms-stat-card" id="btnNotVerifiedUser" name="btnNotVerifiedUser">
                    <span class="ecms-stat-icon"><i class="fa fa-exclamation-circle"></i></span>
                    <span class="ecms-stat-title">Not Verified</span>
                    <span class="ecms-stat-count" id="lblNotVerifiedUser">0</span>
                </button>
            </section>

            <section class="ecms-section ecms-user-table-section">
                <h2 class="ecms-section-title">
                    <i class="fa fa-table" aria-hidden="true"></i>
                    User Registration Records
                </h2>

                <div class="ecms-dt-wrap ecms-user-table-wrap">
                    <table id="tbldata"
                           class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           aria-label="User registration records"></table>
                </div>
            </section>
        </section>
    </main>
</div>

<div class="modal fade ecms-userregn-modal ecms-userregn-flag-modal" id="AddDomainFlag" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ecms-modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-user-check"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">Update Approval / Active of Domain</h5>
                        <small>Review domain details and update approval / active status</small>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <form action="" id="UpdateDomainFlag" name="UpdateDomainFlag" method="post">
                    <div class="ecms-form-grid">
                        <div class="ecms-form-field">
                            <label>Domain ID</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDomainId"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>Role<i class="fas fa-asterisk mand1"></i></label>
                            <label class="unit-label-background ecms-readonly-box" id="lblRole"></label>
                        </div>

                        <div class="ecms-radio-card">
                            <label>Approval<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="true" id="txtapprovalyes" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtapprovalyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="false" id="txtapprovalno" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtapprovalno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="txtapproval-error"></span>
                        </div>

                        <div class="ecms-radio-card">
                            <label>Active<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="true" id="txtactiveyes" data-val="true" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtactiveyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="false" id="txtactiveno" data-val="true" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtactiveno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="txtactive-error"></span>
                        </div>

                        <div class="ecms-form-field ecms-span-2">
                            <label>Message for User</label>
                            <textarea class="form-control1 textarea-auto-height" name="txtadminmessage" id="txtadminmessage" rows="3" maxlength="200" data-val-maxlength="Maximum length of Message is 200 character." data-val-maxlength-max="200" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtadminmessage" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label>Appointment Name</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblAppointmentName"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>Unit Name</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblUnitName"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>SUS No</label>
                            <label id="lblSusno" class="unit-label-background ecms-readonly-box"></label>
                        </div>

                        <div id="lbl1" class="ecms-form-field d-none">
                            <label>PSO / Dte</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblPso"></label>
                        </div>
                        <div id="lbl2" class="ecms-form-field d-none">
                            <label>DG / Sub Dte</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDG"></label>
                        </div>
                        <div id="lbl3" class="ecms-form-field d-none">
                            <label>Comd / PSO</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblComd"></label>
                        </div>
                        <div id="lbl4" class="ecms-form-field d-none">
                            <label>Corps / Dte / Area</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblCorps"></label>
                        </div>
                        <div id="lbl5" class="ecms-form-field d-none">
                            <label>Div / Branch / Sub Area</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDiv"></label>
                        </div>
                        <div id="lbl6" class="ecms-form-field d-none">
                            <label>Bde</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblBde"></label>
                        </div>
                        <div id="lbl7" class="ecms-form-field d-none">
                            <label>Type of Fmn / Branch</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblFmn"></label>
                        </div>
                    </div>
                    <div class="ecms-modal-actions">
                        <input type="button" class="btn btn-outline-primary ecms-save-btn" value="Save" id="btnDomainFlag" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-userregn-modal ecms-userregn-mapping-modal" id="AddMapping" tabindex="-1" aria-labelledby="exampleModalLabel_AddMapping" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ecms-modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-link"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel_AddMapping">Mapping Add / Remove</h5>
                        <small>Update user mapping without changing existing request flow</small>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body model-body-background">
                <form action="" id="SaveMapping" name="SaveMapping" method="post">
                    <div class="ecms-form-grid">
                        <div class="ecms-form-field">
                            <label class="model-body-label">Domain ID</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDomainIdForMapping"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>Role</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblRoleForMapping"></label>
                        </div>

                        <div class="ecms-radio-card">
                            <label>Approval</label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="true" id="txtapprovalyesForMapping" disabled>
                                    <label class="form-check-label" for="txtapprovalyesForMapping">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="false" id="txtapprovalnoForMapping" disabled>
                                    <label class="form-check-label" for="txtapprovalnoForMapping">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="ecms-radio-card">
                            <label>Active</label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="true" id="txtactiveyesForMapping" disabled>
                                    <label class="form-check-label" for="txtactiveyesForMapping">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="false" id="txtactivenoForMapping" disabled>
                                    <label class="form-check-label" for="txtactivenoForMapping">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="ecms-form-field">
                            <label>Appointment Name</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblAppointmentNameForMapping"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>Unit Name</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblUnitNameForMapping"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>SUS No</label>
                            <label id="lblSusnoForMapping" class="unit-label-background ecms-readonly-box"></label>
                        </div>

                        <div id="lblM1" class="ecms-form-field d-none">
                            <label>PSO / Dte</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblPsoForMapping"></label>
                        </div>
                        <div id="lblM2" class="ecms-form-field d-none">
                            <label>DG / Sub Dte</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDGForMapping"></label>
                        </div>
                        <div id="lblM3" class="ecms-form-field d-none">
                            <label>Comd / PSO</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblComdForMapping"></label>
                        </div>
                        <div id="lblM4" class="ecms-form-field d-none">
                            <label>Corps / Dte / Area</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblCorpsForMapping"></label>
                        </div>
                        <div id="lblM5" class="ecms-form-field d-none">
                            <label>Div / Branch / Sub Area</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblDivForMapping"></label>
                        </div>
                        <div id="lblM6" class="ecms-form-field d-none">
                            <label>Bde</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblBdeForMapping"></label>
                        </div>
                        <div id="lblM7" class="ecms-form-field d-none">
                            <label>Type of Fmn / Branch</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblFmnForMapping"></label>
                        </div>

                        <div class="ecms-form-field">
                            <label>Army No</label>
                            <input class="form-control alpha-num-only" placeholder="Enter Army No" id="txtArmyNo" name="txtArmyNo" minlength="7" maxlength="15" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-regex-pattern="^[\w\-]+$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                        </div>
                        <div class="ecms-form-field">
                            <label>Rank</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblRank"></label>
                        </div>
                        <div class="ecms-form-field">
                            <label>Name</label>
                            <label class="unit-label-background ecms-readonly-box" id="lblName"></label>
                        </div>
                    </div>
                    <div class="ecms-modal-actions">
                        <input type="button" class="btn btn-outline-primary ecms-save-btn" value="Save" id="btnAddMapping" />
                    </div>
                    <div class="col-sm-12" id="msg"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-userregn-dialog-modal" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel_DataTableDialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-user-users-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-table"></i></span>
                    <h5 class="modal-title" id="exampleModalLabel_DataTableDialog"><span id="lblModelTitle"></span></h5>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="ecms-dt-wrap ecms-user-dialog-table-wrap">
                    <table class="table table-striped table-hover ecms-dt-table" role="grid" aria-label="User registration records by selected category" id="tbldatadialog"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/userregn.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
