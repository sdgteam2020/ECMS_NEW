@{
    ViewData["Title"] = "Claim Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/account_claims.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10 ecms-claims-breadcrumb">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Claim Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-claims-page">
    <div class="ecms-claims-shell">
        <div class="ecms-claims-title-card">
            <div class="ecms-title-left">
                <div class="ecms-title-icon">
                    <i class="fa fa-key"></i>
                </div>
                <div>
                    <h3>Claim Details</h3>
                    <p>Review claim-wise user assignment count and mapped users</p>
                </div>
            </div>
            <span class="ecms-title-pill">
                <i class="fa fa-user-shield mr-1"></i> USER CONFIG
            </span>
        </div>

        <div class="ecms-claims-sub-card">
            <div class="ecms-title-left">
                <div class="ecms-sub-icon">
                    <i class="fa fa-list"></i>
                </div>
                <div>
                    <h5>Claim Records</h5>
                    <p>View role claims, total mapped users and detailed user list</p>
                </div>
            </div>
        </div>

        <div class="ecms-claims-table-card">
            <div class="ecms-section-bar">
                <i class="fa fa-table mr-1"></i>Claim Records
            </div>

            <div class="ecms-claims-table-wrap">
                <span id="SpnTxnId" class="d-none">0</span>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata"></table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/claims.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade ecms-claims-modal" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-users"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">
                            <span id="lblModelTitle"></span>
                        </h5>
                        <p>Claim-wise mapped user details</p>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="ecms-dialog-table-wrap">
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldatadialog"></table>
                </div>
                <div class="col-sm-12" id="msg"></div>
            </div>
        </div>
    </div>
</div>
