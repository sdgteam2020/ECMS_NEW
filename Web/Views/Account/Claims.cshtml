@{
    ViewData["Title"] = "Claim Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/account_claims.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-10">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Claim Details

                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span>
            @*<span id="PtoId" class="d-none">0</span>*@
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Claim Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row">
                <div class="col-xl-6">
                    <div class="col-form-label">
                        Total Claim :<label class="font-weight-bold" id="lblTotal">0</label>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="d-flex d-md-flex justify-content-md-end align-items-md-end">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table border border-purple table-striped no-footer dataTable table-hover" role="grid" id="tbldata">
                        <thead>
                            <tr>
                                <th class="noExport d-none"></th>
                                <th class="wd-40-f">S No</th>
                                <th class="nowrap">Claim</th>
                                <th class="nowrap">User Claim Count</th>
                                <th class="noExport nowrap">View</th>
                            </tr>
                        </thead>
                        @* <tbody id="DetailBody">
                        </tbody> *@
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/claims.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><span id="lblModelTitle"></span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer table-hover" role="grid" id="tbldatadialog">
                            <thead>
                                <tr>
                                    <th class="wd-40-f">S No</th>
                                    <th class="nowrap">Domain ID</th>
                                    <th class="nowrap">IC No</th>
                                    <th class="nowrap">Rank</th>
                                    <th class="nowrap">Name</th>
                                    <th class="nowrap">Unit</th>
                                    <th class="nowrap">Appt</th>
                                    <th class="nowrap">Role of User</th>
                                </tr>
                            </thead>
                        </table>


                    </div>

                </div>
                <div class="col-sm-12" id="msg">
                </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>
