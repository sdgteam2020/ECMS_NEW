@{
    ViewData["Title"] = "Claim Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link asp-href-include="~/developercss/account_claims.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Claim Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-screen-stage ecms-bg">
    <main class="ecms-page ecms-page-full ecms-fit-screen  ecms-claims-page">
        <section class="ecms-card ecms-grid-page ecms-claims-shell">
            <div class="ecms-page-title ecms-title-row">
                <div class="ecms-title-content">
                    <span class="ecms-title-icon" aria-hidden="true">
                        <i class="fa fa-key"></i>
                    </span>
                    <div class="ecms-title-copy">
                        <h3>Claim Details</h3>
                        <p class="ecms-title-subtitle">Review claim-wise user assignment count and mapped users</p>
                    </div>
                </div>

                <span class="ecms-title-pill">
                    <i class="fa fa-user-shield mr-1"></i>
                    USER CONFIG
                </span>
            </div>

            <section class="ecms-section ecms-section-fill ecms-claims-table-section">
                <h2 class="ecms-section-title">
                    <i class="fa fa-table" aria-hidden="true"></i>
                    Claim Records
                </h2>

                <div class="ecms-section-body ecms-dt-wrap ecms-dt-fill ecms-claims-table-wrap">
                    <span id="SpnTxnId" class="d-none">0</span>
                    <table id="tbldata"
                           class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           aria-label="Claim records"></table>
                </div>
            </section>
        </section>
    </main>
</div>

<div class="modal fade ecms-modal-root ecms-claims-modal"
     id="DataTableDialog"
     tabindex="-1"
     aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-modal-heading">
                    <span class="ecms-modal-title-icon" aria-hidden="true">
                        <i class="fa fa-users"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h5 class="modal-title" id="exampleModalLabel">
                            <span id="lblModelTitle"></span>
                        </h5>
                        <p class="ecms-modal-subtitle">Claim-wise mapped user details</p>
                    </div>
                </div>

                <button type="button"
                        class="close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close"
                        title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="ecms-dt-wrap ecms-dt-fill ecms-dialog-table-wrap">
                    <table id="tbldatadialog"
                           class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           aria-label="Mapped users"></table>
                </div>
                <div class="col-sm-12" id="msg"></div>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/claims.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
