@inject IConfiguration configuration;
<!DOCTYPE html>
@{
    ViewData["Title"] = "Final Logout";
    Layout = null;
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}

<html lang="en">
<head runat="server">
    <title>IAM Logout</title>
    <link href="@($"{Cdn}/developercss/logout.css?v={Ver}")" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">

        <header>
            <center>
                <a href="/Account/IMLoginSelf" class="headerText" id="headerCustText">You are successfully logged out of the application</a>
            </center>

        </header>
        <div class="quick-area">
        </div>
    </form>
</body>
</html>
