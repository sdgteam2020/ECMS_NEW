@{
    ViewData["Title"] = "Profile Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/profilemanage.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Profile Management</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-screen-stage ecms-bg">
    <main class="ecms-page ecms-page-full ecms-fit-screen ecms-profilemanage-page">
        <section class="ecms-card ecms-profile-shell">
            <div class="ecms-page-title ecms-profile-title-row">
                <div class="ecms-profile-title-content">
                    <span class="ecms-title-icon" aria-hidden="true">
                        <i class="fa fa-user-cog"></i>
                    </span>
                    <div class="ecms-profile-title-copy">
                        <h3>Profile Management Details</h3>
                        <p class="ecms-title-subtitle">
                            Create, update and manage user profile, token waiver and I-card token settings
                        </p>
                    </div>
                </div>

                <button type="button"
                        id="btnProfileAdd"
                        class="btn btn-success ecms-btn-success ecms-profile-add-btn">
                    <i class="fa fa-plus mr-1"></i>
                    Add Profile
                </button>
            </div>

            <section class="ecms-section ecms-profile-table-section">
                <h2 class="ecms-section-title">
                    <i class="fa fa-table" aria-hidden="true"></i>
                    Profile Management Records
                </h2>

                <div class="ecms-dt-wrap ecms-profile-table-wrap">
                    <span id="SpnTxnId" class="d-none">0</span>
                    <table id="tbldata"
                           class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           aria-label="Profile management records"></table>
                </div>
            </section>
        </section>
    </main>
</div>

<div class="modal fade ecms-profile-modal"
     id="AddNewProfile"
     tabindex="-1"
     aria-labelledby="exampleModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-backdrop="static"
     data-bs-keyboard="false"
     data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable ecms-modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-modal-heading">
                    <span class="ecms-modal-title-icon" aria-hidden="true">
                        <i class="fa fa-user-plus"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h5 class="modal-title" id="exampleModalLabel">Enter Profile Details</h5>
                        <p class="ecms-modal-subtitle">
                            Fill service profile, arms/service and token configuration details
                        </p>
                    </div>
                </div>

                <button type="button"
                        class="close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close"
                        title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form action="" id="SaveProfile" name="SaveProfile" method="post">
                    <div class="ecms-profile-form-grid">
                        <div class="ecms-profile-form-field">
                            <label class="ecms-profile-form-label" for="txtArmyNo">
                                <span class="ecms-profile-field-icon"><i class="fa fa-id-card"></i></span>
                                Army No
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control1 js-uppercase"
                                   placeholder="Enter Army No"
                                   id="txtArmyNo"
                                   name="txtArmyNo"
                                   maxlength="9"
                                   data-val-maxlength="Maximum length of Army No is nine character."
                                   data-val-maxlength-max="9"
                                   data-val-minlength="Minimum length of Army No is eight character."
                                   data-val-minlength-min="8"
                                   minlength="8"
                                   data-val="true"
                                   data-val-regex="Army No must be like IC12345X or SC123456L."
                                   data-val-required="Army No is required."
                                   data-val-regex-pattern="^[A-Z]{2}\d{5,6}[A-Z]$" />
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="txtArmyNo"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label class="ecms-profile-form-label" for="ddlRank">
                                <span class="ecms-profile-field-icon"><i class="fa fa-star"></i></span>
                                Rank
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <select class="form-select"
                                    name="ddlRank"
                                    id="ddlRank"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-required="Rank is required."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Rank</option>
                            </select>
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="ddlRank"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label class="ecms-profile-form-label" for="txtName">
                                <span class="ecms-profile-field-icon"><i class="fa fa-user"></i></span>
                                Name
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control-Alphabets"
                                   placeholder="Enter Name"
                                   id="txtName"
                                   name="txtName"
                                   maxlength="50"
                                   data-val-maxlength="Maximum length of Name is fifty character."
                                   data-val-maxlength-max="50"
                                   data-val="true"
                                   data-val-regex="Only letters are allowed, with a single space between words."
                                   data-val-required="Name is required."
                                   data-val-regex-pattern="^[A-Za-z]+(?: [A-Za-z]+)*$" />
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="txtName"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label class="ecms-profile-form-label" for="ddlArmType">
                                <span class="ecms-profile-field-icon"><i class="fa fa-shield-alt"></i></span>
                                Name of Arms, Service &amp; Corps
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <select class="form-select"
                                    name="ddlArmType"
                                    id="ddlArmType"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-required="Arms, Service & Corps is required."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Arms</option>
                            </select>
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="ddlArmType"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field ecms-profile-span-2">
                            <div class="ecms-profile-radio-label">
                                <span class="ecms-profile-field-icon"><i class="fa fa-key"></i></span>
                                <span class="ecms-profile-radio-title">
                                    Raise Request for Token Waiver for Domain User (For Log in &amp; Digital Signature)
                                </span>
                                <span id="TokenWaiverInfo"
                                      class="ecms-profile-info-trigger"
                                      role="button"
                                      tabindex="0"
                                      aria-label="Token waiver information"
                                      title="Token waiver information">
                                    <i class="fa fa-info-circle"></i>
                                </span>
                                <i class="fas fa-asterisk mand1"></i>
                            </div>

                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsTokenWaiver"
                                           value="true"
                                           id="IsTokenWaiverYes"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsTokenWaiverYes">Yes</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsTokenWaiver"
                                           value="false"
                                           id="IsTokenWaiverNo"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsTokenWaiverNo">No</label>
                                </div>
                            </div>

                            <span class="text-danger field-validation-valid"
                                  id="IsTokenWaiver-error"
                                  data-valmsg-for="IsTokenWaiver"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field ecms-profile-span-2 d-none"
                             id="spnReasonTokenWaiver">
                            <label class="ecms-profile-form-label" for="txtMessage">
                                <span class="ecms-profile-field-icon"><i class="fa fa-comment-dots"></i></span>
                                Reason for IACA Token Waiver
                            </label>
                            <textarea class="form-control1 textarea-auto-height"
                                      name="txtMessage"
                                      id="txtMessage"
                                      rows="3"
                                      maxlength="100"
                                      data-val-maxlength="Maximum length of Message is 100 character."
                                      data-val-maxlength-max="150"
                                      data-val="true"
                                      data-val-regex="This special chars not allowed for security reasons."
                                      data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="txtMessage"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field">
                            <div class="ecms-profile-radio-label">
                                <span class="ecms-profile-field-icon"><i class="fa fa-usb"></i></span>
                                <span class="ecms-profile-radio-title">Token required</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </div>

                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsToken"
                                           value="true"
                                           id="isTokenyes"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="isTokenyes">Yes</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsToken"
                                           value="false"
                                           id="isTokenno"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="isTokenno">No</label>
                                </div>
                            </div>

                            <span class="text-danger field-validation-valid"
                                  id="IsToken-error"
                                  data-valmsg-for="IsToken"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field">
                            <div class="ecms-profile-radio-label">
                                <span class="ecms-profile-field-icon"><i class="fa fa-id-badge"></i></span>
                                <span class="ecms-profile-radio-title">Apply For I-Card With Token</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </div>

                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsWithTokenApply"
                                           value="true"
                                           id="IsWithTokenApplyyes"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsWithTokenApplyyes">Yes</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="IsWithTokenApply"
                                           value="false"
                                           id="IsWithTokenApplyno"
                                           data-val="true"
                                           data-val-regex="This special chars not allowed for security reasons."
                                           data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsWithTokenApplyno">No</label>
                                </div>
                            </div>

                            <span class="text-danger field-validation-valid"
                                  id="IsWithTokenApply-error"
                                  data-valmsg-for="IsWithTokenApply"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-actions ecms-profile-actions">
                            <input type="button"
                                   class="btn btn-primary ecms-btn-primary"
                                   value="Save"
                                   id="btnProfileAddButton" />
                            <button type="button"
                                    id="btnProfileAddReset"
                                    class="btn btn-danger ecms-btn-danger">
                                Reset
                            </button>
                        </div>

                        <div class="ecms-profile-span-2" id="msg"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-info-modal"
     id="hoverModal"
     tabindex="-1"
     aria-labelledby="hoverModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-modal-heading">
                    <span class="ecms-modal-title-icon" aria-hidden="true">
                        <i class="fa fa-info-circle"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h5 class="modal-title" id="hoverModalLabel">Information</h5>
                        <p class="ecms-modal-subtitle">Token waiver request details</p>
                    </div>
                </div>

                <button type="button"
                        class="close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close"
                        title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body ecms-profile-info-body">
                Raise a request with Admin to get a Waiver of IACA Token. It will faciliatate the Domain User to Login into the E-ISAC appl without IACA Token and during the appl forwarding the Digital Signature will not be maintained. However Digital Log will be maintained for all transactions.
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary ecms-btn-secondary"
                        data-bs-dismiss="modal"
                        data-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/profilemanage.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
