@{
    ViewData["Title"] = "Profile Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/profilemanage.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10 ecms-profile-breadcrumb">
    <i class="fa fa-bars"></i>
    <a href="/Master/DashboardMaster">Dashboard</a>
    <span>&gt;</span>
    <span>Profile Management</span>
</header>

<div class="containerMain ecms-profilemanage-page">
    <section class="ecms-profile-panel">
        <div class="ecms-profile-hero">
            <div class="ecms-profile-title-left">
                <span class="ecms-profile-icon"><i class="fa fa-user-cog"></i></span>
                <div class="ecms-profile-title">
                    <h2>Profile Management Details</h2>
                    <p>Create, update and manage user profile, token waiver and I-card token settings</p>
                </div>
            </div>
            <button type="button" id="btnProfileAdd" class="btn ecms-profile-add-btn">
                <i class="fa fa-plus mr-1"></i>Add Profile
            </button>
        </div>

        <div class="ecms-profile-table-card">
            <div class="ecms-profile-table-heading">
                <i class="fa fa-table mr-1"></i> Profile Management Records
            </div>
            <span id="SpnTxnId" class="d-none">0</span>
            <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata"></table>
        </div>
    </section>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/profilemanage.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade ecms-profile-modal" id="AddNewProfile" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="ecms-modal-icon"><i class="fa fa-user-plus"></i></span>
                <div class="ecms-modal-title-wrap">
                    <h5 class="modal-title" id="exampleModalLabel">Enter Profile Details</h5>
                    <div class="modal-subtitle">Fill service profile, arms/service and token configuration details</div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <form action="" id="SaveProfile" name="SaveProfile" method="post">
                    <div class="ecms-profile-form-grid">
                        <div class="ecms-profile-form-field">
                            <label for="txtArmyNo"><span class="ecms-field-icon"><i class="fa fa-id-card"></i></span>Army No<i class="fas fa-asterisk mand1"></i></label>
                            <input class="form-control1 js-uppercase" placeholder="Enter Army No" id="txtArmyNo" name="txtArmyNo" maxlength="9" data-val-maxlength="Maximum length of Army No is nine character." data-val-maxlength-max="9" data-val-minlength="Minimum length of Army No is eight character." data-val-minlength-min="8" minlength="8" data-val="true" data-val-regex="Army No must be like IC12345X or SC123456L." data-val-required="Army No is required." data-val-regex-pattern="^[A-Z]{2}\d{5,6}[A-Z]$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label for="ddlRank"><span class="ecms-field-icon"><i class="fa fa-star"></i></span>Rank<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlRank" id="ddlRank" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Rank is required." data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Rank</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlRank" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label for="txtName"><span class="ecms-field-icon"><i class="fa fa-user"></i></span>Name<i class="fas fa-asterisk mand1"></i></label>
                            <input class="form-control-Alphabets" placeholder="Enter Name" id="txtName" name="txtName" maxlength="50" data-val-maxlength="Maximum length of Name is fifty character." data-val-maxlength-max="50" data-val="true" data-val-regex="Only letters are allowed, with a single space between words." data-val-required="Name is required." data-val-regex-pattern="^[A-Za-z]+(?: [A-Za-z]+)*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field">
                            <label for="ddlArmType"><span class="ecms-field-icon"><i class="fa fa-shield-alt"></i></span>Name of Arms, Service & Corps<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlArmType" id="ddlArmType" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Arms, Service & Corps is required." data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Arms</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmType" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field full">
                            <div class="ecms-radio-label">
                                <span class="ecms-field-icon"><i class="fa fa-key"></i></span>
                                Raise Request for Token Waiver for Domain User (For Log in & Digital Signature)
                                <span id="TokenWaiverInfo" class="fw-bold"><i class="fa fa-info-circle"></i></span>
                                <i class="fas fa-asterisk mand1"></i>
                            </div>
                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsTokenWaiver" value="true" id="IsTokenWaiverYes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsTokenWaiverYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsTokenWaiver" value="false" id="IsTokenWaiverNo" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsTokenWaiverNo">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="IsTokenWaiver-error" data-valmsg-for="IsTokenWaiver" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-form-field full d-none" id="spnReasonTokenWaiver">
                            <label for="txtMessage"><span class="ecms-field-icon"><i class="fa fa-comment-dots"></i></span>Reason for IACA Token Waiver</label>
                            <textarea class="form-control1 textarea-auto-height" name="txtMessage" id="txtMessage" rows="3" maxlength="100" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="150" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtMessage" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field">
                            <div class="ecms-radio-label">
                                <span class="ecms-field-icon"><i class="fa fa-usb"></i></span>
                                Token required<i class="fas fa-asterisk mand1"></i>
                            </div>
                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsToken" value="true" id="isTokenyes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="isTokenyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsToken" value="false" id="isTokenno" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="isTokenno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="IsToken-error" data-valmsg-for="IsToken" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-radio-field">
                            <div class="ecms-radio-label">
                                <span class="ecms-field-icon"><i class="fa fa-id-badge"></i></span>
                                Apply For I-Card With Token<i class="fas fa-asterisk mand1"></i>
                            </div>
                            <div class="ecms-profile-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsWithTokenApply" value="true" id="IsWithTokenApplyyes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsWithTokenApplyyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsWithTokenApply" value="false" id="IsWithTokenApplyno" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="IsWithTokenApplyno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="IsWithTokenApply-error" data-valmsg-for="IsWithTokenApply" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-profile-actions">
                            <input type="button" class="btn btn-outline-primary" value="Save" id="btnProfileAddButton" />
                            <button type="button" id="btnProfileAddReset" class="btn btn-outline-danger">Reset</button>
                        </div>

                        <div class="full" id="msg"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-info-modal" id="hoverModal" tabindex="-1" aria-labelledby="hoverModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="hoverModalLabel">Information</h5>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Raise a request with Admin to get a Waiver of IACA Token. It will faciliatate the Domain User to Login into the E-ISAC appl without IACA Token and during the appl forwarding the Digital Signature will not be maintained. However Digital Log will be maintained for all transactions.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
