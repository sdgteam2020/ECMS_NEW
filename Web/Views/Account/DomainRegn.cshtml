@{
    ViewData["Title"] = "Domain Regn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/domainregn.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10 ecms-domainregn-breadcrumb">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Domain Registration</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-domainregn-page">
    <div class="ecms-domainregn-shell">
        <div class="ecms-domainregn-title-card">
            <div class="ecms-title-left">
                <div class="ecms-title-icon">
                    <i class="fa fa-key"></i>
                </div>
                <div>
                    <h3>Domain Registration Details</h3>
                    <p>Create, update and manage domain ID, claims and user configuration</p>
                </div>
            </div>
            <span class="ecms-title-pill">
                <i class="fa fa-user-shield mr-1"></i> USER CONFIG
            </span>
        </div>

        <div class="ecms-domainregn-sub-card">
            <div class="ecms-title-left">
                <div class="ecms-sub-icon">
                    <i class="fa fa-users"></i>
                </div>
                <div>
                    <h5>Domain User Summary</h5>
                    <p>Click a card to view user details by category</p>
                </div>
            </div>
            <button type="button" id="btnDomainAdd" class="btn ecms-btn-add">
                <i class="fa fa-plus mr-1"></i>Add Domain
            </button>
        </div>

        <div class="ecms-domain-stats">
            <button class="count-label ecms-stat-card" id="btnUser" name="btnUser">
                <span class="ecms-stat-icon"><i class="fa fa-users"></i></span>
                <span class="ecms-stat-title">Total Users</span>
                <span class="ecms-stat-count" id="lblUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnMappedUser" name="btnMappedUser">
                <span class="ecms-stat-icon"><i class="fa fa-link"></i></span>
                <span class="ecms-stat-title">Mapped</span>
                <span class="ecms-stat-count" id="lblMappedUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnUnMappedUser" name="btnUnMappedUser">
                <span class="ecms-stat-icon"><i class="fa fa-unlink"></i></span>
                <span class="ecms-stat-title">Not Mapped</span>
                <span class="ecms-stat-count" id="lblUnMappedUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnActiveUser" name="btnActiveUser">
                <span class="ecms-stat-icon"><i class="fa fa-check-circle"></i></span>
                <span class="ecms-stat-title">Active</span>
                <span class="ecms-stat-count" id="lblActiveUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnInActiveUser" name="btnActiveUser">
                <span class="ecms-stat-icon"><i class="fa fa-times-circle"></i></span>
                <span class="ecms-stat-title">Inactive</span>
                <span class="ecms-stat-count" id="lblInActiveUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnVerified" name="btnVerified">
                <span class="ecms-stat-icon"><i class="fa fa-shield-alt"></i></span>
                <span class="ecms-stat-title">Verified</span>
                <span class="ecms-stat-count" id="lblVerifiedUser">0</span>
            </button>
            <button class="count-label ecms-stat-card" id="btnNotVerifiedUser" name="btnNotVerifiedUser">
                <span class="ecms-stat-icon"><i class="fa fa-exclamation-circle"></i></span>
                <span class="ecms-stat-title">Not Verified</span>
                <span class="ecms-stat-count" id="lblNotVerifiedUser">0</span>
            </button>
        </div>

        <div class="ecms-domain-table-card">
            <div class="ecms-section-bar">
                <i class="fa fa-table mr-1"></i>Domain Registration Records
            </div>

            <div class="ecms-domain-table-wrap">
                <span id="SpnTxnId" class="d-none">0</span>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata"></table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/domainregn.js"></script>
<script asp-src-include="~/select2/js/select2.min.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade ecms-domain-modal" id="AddNewDomain" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-key"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">Enter Domain Details</h5>
                        <p>Fill domain, role, claims, appointment and unit mapping details</p>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form action="" id="SaveDomain" name="SaveDomain" method="post">
                    <div class="ecms-form-grid">
                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-id-card"></i></span>
                                Domain ID<i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control-domainId" placeholder="Enter Domain ID" id="txtDomainId" name="txtDomainId" maxlength="20" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Domain Id is required." data-val-regex-pattern="^[\w]+$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtDomainId" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-user-tag"></i></span>
                                Role<i class="fas fa-asterisk mand1"></i>
                            </label>
                            <select class="form-select" multiple="" placeholder="Select Role" name="ddlRoles" id="ddlRoles" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Role is required."></select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlRoles" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-list-check"></i></span>
                                Assign Claims
                            </label>
                            <select class="form-select" multiple="" placeholder="Select Claims" name="ddClaims" id="ddClaims" data-val="true" data-val-regex="This special chars and space not allowed for security reasons."></select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddClaims" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-briefcase"></i></span>
                                Appointment<i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control alpha-num-only" placeholder="Type Appointment" id="txtAppointmentName" name="txtAppointmentName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Appointment Name is required." data-val-regex-pattern="^[\w \& \()]*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtAppointmentName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-building"></i></span>
                                Unit Name<i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control alpha-num-only" placeholder="Type SUS No" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Unit Name is required." data-val-regex-pattern="^[\w ]*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-hashtag"></i></span>
                                SUS No
                            </label>
                            <label id="lblSusno" class="col-form-label unit-label-background"></label>
                        </div>

                        <div id="lbl1" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>PSO / Dte</label>
                            <label class="col-form-label unit-label-background" id="lblPso"></label>
                        </div>

                        <div id="lbl2" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>DG / Sub Dte</label>
                            <label class="col-form-label unit-label-background" id="lblDG"></label>
                        </div>

                        <div id="lbl3" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>Comd / PSO</label>
                            <label class="col-form-label unit-label-background" id="lblComd"></label>
                        </div>

                        <div id="lbl4" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>Corps / Dte / Area</label>
                            <label class="col-form-label unit-label-background" id="lblCorps"></label>
                        </div>

                        <div id="lbl5" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>Div / Branch / Sub Area</label>
                            <label class="col-form-label unit-label-background" id="lblDiv"></label>
                        </div>

                        <div id="lbl6" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>Bde</label>
                            <label class="col-form-label unit-label-background" id="lblBde"></label>
                        </div>

                        <div id="lbl7" class="ecms-form-field d-none">
                            <label class="ecms-form-label"><span><i class="fa fa-sitemap"></i></span>Type of Fmn / Branch</label>
                            <label class="col-form-label unit-label-background" id="lblFmn"></label>
                        </div>
                    </div>

                    <div class="ecms-radio-grid">
                        <div class="ecms-radio-card">
                            <label class="ecms-radio-title">Approval<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="true" id="txtapprovalyes" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtapprovalyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtapproval" value="false" id="txtapprovalno" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtapprovalno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="txtapproval-error"></span>
                        </div>

                        <div class="ecms-radio-card">
                            <label class="ecms-radio-title">Active<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="true" id="txtactiveyes" data-val="true" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtactiveyes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="txtactive" value="false" id="txtactiveno" data-val="true" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="txtactiveno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="txtactive-error"></span>
                        </div>

                        <div class="ecms-radio-card">
                            <label class="ecms-radio-title">Are you performing the Duties of OC / CO / OC Tps?<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="InitatingOffr" value="true" id="initatingOffryes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="initatingOffryes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="InitatingOffr" value="false" id="initatingOffrno" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="initatingOffrno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="InitatingOffr-error" data-valmsg-for="InitatingOffr" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-radio-card">
                            <label class="ecms-radio-title">Are you Commanding a Unit/ Sub Unit/ Fmn / Dte?<i class="fas fa-asterisk mand1"></i></label>
                            <div class="ecms-radio-options">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="CommandingOffr" value="true" id="commandingOffryes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="commandingOffryes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="CommandingOffr" value="false" id="commandingOffrno" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                    <label class="form-check-label" for="commandingOffrno">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="CommandingOffr-error" data-valmsg-for="CommandingOffr" data-valmsg-replace="true"></span>
                        </div>
                    </div>

                    <div class="ecms-modal-actions">
                        <input type="button" class="btn ecms-btn-save" value="Save" id="btnDomainAddDialog" />
                        <button type="button" id="btnDomainAddReset" class="btn ecms-btn-reset">Reset</button>
                    </div>

                    <div class="col-sm-12" id="msg"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-domain-dialog-modal" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-users"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel"><span id="lblModelTitle"></span></h5>
                        <p>Domain user list by selected category</p>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="ecms-dialog-table-wrap">
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldatadialog"></table>
                </div>
                <div class="col-sm-12" id="msg"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-claims-show-modal" id="ClaimsShow" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-list-check"></i></span>
                    <div>
                        <h6 class="modal-title" id="exampleModalLabel">Claims Details of Domain Id (<span id="claimDomainId"></span>)</h6>
                    </div>
                </div>
                <button type="button" class="btn-close ecms-bs-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="ClaimsShowBody" class="modal-body"></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>
