@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration;
@model DTOProfileAndMappingRequest
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
    DTOTempSession? dTOTempSession = new DTOTempSession();
    StringBuilder m1 = new StringBuilder();
    StringBuilder m2 = new StringBuilder();
    if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("IMData")))
    {
        dTOTempSession = SessionHeplers.GetObject<DTOTempSession>(HttpContextAccessor.HttpContext.Session, "IMData");
        m1.Append("Status : " + dTOTempSession.Status);
        m1.Append(",<br/>AdminFlag : " + dTOTempSession.AdminFlag);
        m1.Append(",<br/>DomainId : " + dTOTempSession.DomainId);
        m1.Append(",<br/>RoleName : " + dTOTempSession.RoleName);
        m1.Append(",<br/>ICNO : " + dTOTempSession.ICNO);
        m1.Append(",<br/>UserId : " + dTOTempSession.UserId);
        m1.Append(",<br/>TDMUnitMapId : " + dTOTempSession.TDMUnitMapId);
        m1.Append(",<br/>TDMId : " + dTOTempSession.TDMId);
        m1.Append(",<br/>AspNetUsersId : " + dTOTempSession.AspNetUsersId);

        m2.Append("ICNoDomainId : " + dTOTempSession.ICNoDomainId);
        m2.Append(",<br/>ICNoTDMUnitMapId : " + dTOTempSession.ICNoTDMUnitMapId);
    }
    
}
<link href="@($"{Cdn}/developercss/account_profile.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<div class="page">
    <div class="container-fluid">
        <partial name="~/Views/Shared/_CommonHeader.cshtml" />
    </div>
    <div class="bg-white login-wrap align-items-center">
        <div class="login ">
            <div class="row">
                <input type="hidden" id="hiddenSa" value="@dTOTempSession.Salt" />
                <div class="card-sigin">
                    <div class="main-signup-header login-form">
                        <p class="font-weight-normal font-weight-700 text-center mb-4 mt-1">Fill your  Details to Register Profile in Appl</p>
                        <div class="pb-3 mt-3">
                            <div class="col-md-12 col-sm-6 " id="">
                                <input class="form-control alpha-num-only mb-2 d-none form-space" id="txtProfileForArmyNo" maxlength="9" value="1" placeholder="Enter Army No" />
                            </div>
                            <div class="col-md-12 col-lg-12 col-xl-12 p-4">
                                <form asp-antiforgery="true" asp-controller="Account" asp-action="Profile" id="Profile" name="Profile" method="post" class="mt-3">
                                    <div class="card-body">
                                        <div class="row">
                                            <input type="hidden" id="EncryptedData" name="EncryptedData" />
                                            <input hidden asp-for="UnitMapId" />
                                            <input hidden asp-for="ApptId" />
                                            <div class="col-md-6 col-lg-6 col-xl-6">
                                                <div class="row mb-2 required">
                                                    <label class="col-sm-4 col-form-label form-label fw-bold">Army No<i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-8">
                                                        <input class="form-control alpha-num-only text-uppercase" placeholder="" readonly value="@(dTOTempSession != null ? dTOTempSession.ICNO : "")" />
                                                    </div>
                                                </div>
                                                <div class="row mb-2 required">
                                                    <span id="spnUnitAppointmentId" class="d-none">@(Model.ApptId > 0 ? Model.ApptId : 0)</span>
                                                    <label class="col-form-label col-sm-4 fw-bold">Appointment<i class="fas fa-asterisk mand1 fw-bold"></i></label>
                                                    <div class="col-sm-8">
                                                        <div class="d-flex">
                                                            <input class="form-control alpha-num-only" placeholder="Type Appointment" id="txtAppointmentName" name="txtAppointmentName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Appointment Name is required." data-val-regex-pattern="^[\w \& \()]*$" /><button title="Add New Appointment" type="button" id="btnAddAppointment"><i class='fas fa-plus'></i></button>
                                                        </div>
                                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtAppointmentName" data-valmsg-replace="true"></span>
                                                    </div>
                                                </div>
                                                <div class="row mb-2 required">
                                                    <label asp-for="RankId" class="col-sm-4 col-form-label form-label fw-bold">Rank<i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-8">
                                                        <select asp-for="RankId" class="form-select" asp-items="ViewBag.OptionsRank">
                                                        </select>
                                                        <span asp-validation-for="RankId" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="row mb-2 required">
                                                    <label asp-for="Name" class="col-sm-4 col-form-label form-label fw-bold">Name<i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-8">
                                                        <input asp-for="Name" class="form-control-Alphabets" placeholder="" />
                                                        <span asp-validation-for="Name" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 fw-bold">Name of Arms, Service & Corps <i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-8">
                                                        <select asp-for="ArmedId" class="form-select" asp-items="ViewBag.OptionsArmedType">
                                                        </select>
                                                        <span asp-validation-for="ArmedId" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="row mb-2 required">
                                                    <label asp-for="IsIO" class="col-sm-9 col-form-label form-label fw-bold">Are you performing the Duties of OC / CO / OC Tps?<i class="fas fa-asterisk mand1"></i></label>
                                                    @if (dTOTempSession != null && dTOTempSession.TDMId > 0)
                                                    {
                                                        <div class="col-sm-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsIO" value="true" id="IsIOyes" checked=@(Model.IsIO == true ? true : false) disabled="disabled">
                                                                <label class="form-check-label" for="IsIOyes">
                                                                    Yes
                                                                </label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsIO" value="false" id="IsIOno" checked=@(Model.IsIO == false ? true : false) disabled="disabled">
                                                                <label class="form-check-label" for="IsIOno">
                                                                    No
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="col-sm-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsIO" value="true" id="IsIOyes">
                                                                <label class="form-check-label" for="IsIOyes">
                                                                    Yes
                                                                </label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsIO" value="false" id="IsIOno" checked="checked">
                                                                <label class="form-check-label" for="IsIOno">
                                                                    No
                                                                </label>
                                                            </div>
                                                            <span class="text-danger field-validation-valid" id="IsIO-error"></span>
                                                        </div>
                                                    }

                                                </div>
                                                <div class="row mb-2 required">
                                                    <label asp-for="IsCO" class="col-sm-9 col-form-label form-label fw-bold">Are you Commanding a Unit/ Sub Unit/ Fmn / Dte?<i class="fas fa-asterisk mand1"></i></label>
                                                    @if (dTOTempSession != null && dTOTempSession.UserId > 0)
                                                    {
                                                        <div class="col-sm-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsCO" value="true" id="IsCOyes" checked=@(Model.IsCO == true ? true : false) disabled="disabled">
                                                                <label class="form-check-label" for="IsCOyes">
                                                                    Yes
                                                                </label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsCO" value="false" id="IsCOno" checked=@(Model.IsCO == false ? true : false) disabled="disabled">
                                                                <label class="form-check-label" for="IsCOno">
                                                                    No
                                                                </label>
                                                            </div>
                                                        </div>

                                                    }
                                                    else
                                                    {
                                                        <div class="col-sm-3">
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsCO" value="true" id="IsCOyes">
                                                                <label class="form-check-label" for="IsCOyes">
                                                                    Yes
                                                                </label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio" name="IsCO" value="false" id="IsCOno" checked="checked">
                                                                <label class="form-check-label" for="IsCOno">
                                                                    No
                                                                </label>
                                                            </div>
                                                            <span class="text-danger field-validation-valid" id="IsCO-error"></span>
                                                        </div>
                                                    }

                                                </div>
                                                <div class="row mb-2 required d-none">
                                                    <label asp-for="Thumbprint" class="col-sm-4 col-form-label form-label fw-bold"> Thumb print<i class="fas fa-asterisk mand1"></i></label>

                                                    <div class="col-sm-8">
                                                        <div class="form-check form-check-inline">
                                                            <input asp-for="Thumbprint" class="form-control alpha-num-only" />

                                                        </div>

                                                    </div>

                                                </div>
                                            </div>
                                            <div class="col-md-6 col-lg-6 col-xl-6">

                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-9 fw-bold">Do You want IACA Token Waiver to access Appl?<i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-3">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="radio" name="IsTokenWaiver" value="true" id="IsTokenWaiverYes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                                            <label class="form-check-label" for="IsTokenWaiverYes">
                                                                Yes
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" type="radio" name="IsTokenWaiver" value="false" id="IsTokenWaiverNo" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                                            <label class="form-check-label" for="IsTokenWaiverNo">
                                                                No
                                                            </label>
                                                        </div>
                                                        <span class="text-danger field-validation-valid" id="IsTokenWaiver-error" data-valmsg-for="IsTokenWaiver" data-valmsg-replace="true"></span>
                                                    </div>
                                                </div>
                                                <div class="form-group row mb-2 d-none" id="spnReasonTokenWaiver">
                                                    <label class="col-form-label col-sm-4 fw-bold">Reason for IACA Token Waiver</label>
                                                    <div class="col-sm-8">
                                                        <textarea asp-for="ReasonTokenWaiver" class="form-control alpha-num-only textarea-auto-height" rows="3"></textarea>
                                                        <span id="ReasonTokenWaiver-error" class="text-danger field-validation-valid" data-valmsg-for="ReasonTokenWaiver" data-valmsg-replace="true"></span>
                                                    </div>
                                                </div>

                                                <div class="form-group row mb-2">
                                                    <span id="spnUnitMapId" class="d-none">@(Model.UnitMapId > 0 ? Model.UnitMapId : 0)</span>
                                                    <label class="col-form-label col-sm-4 fw-bold">Unit<i class="fas fa-asterisk mand1"></i></label>
                                                    <div class="col-sm-8">
                                                        <div class="d-flex">
                                                            <input class="form-control alpha-num-only" placeholder="Type SUSNO" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Unit Name is required." data-val-regex-pattern="^[\w ]*$" /><button type="button" id="btnAddUnit"><i class='fas fa-plus'></i></button>
                                                        </div>
                                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblSusno" class="col-form-label unit-label-background"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl1" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">PSO / Dte</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblPso"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl2" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">DG / Sub Dte</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblDG"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl3" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">Comd / PSO</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblComd"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl4" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">Corps / Dte / Area</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblCorps"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl5" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">Div / Branch / Sub Area</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblDiv"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl6" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">Bde</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblBde"></label>
                                                    </div>
                                                </div>
                                                <div id="lbl7" class="row mb-2 d-none">
                                                    <label class="col-form-label col-sm-4 fw-bold">Type of Fmn / Branch</label>
                                                    <div class="col-sm-8">
                                                        <label class="col-form-label unit-label-background" id="lblFmn"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer text-center mb-4">
                                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                       

                                        <input type="button" class="btn btn-primary  mt-4 mr-4" value="Submit" id="btnSubmit" />



                                        @if (TempData["success"] != null)
                                        {
                                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                                <span class="text-success">@TempData["success"]</span>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        }
                                        @if (TempData["error"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                                <span class="text-danger">@TempData["error"]</span>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-12 col-sm-6 text-center mt-4" id="">
                                        <span id="tokenmsg"></span>
                                    </div>
                                   
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
@section Scripts{
    <script src="@($"{Cdn}/developerjs/keyconstants.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/developerjs/accountprofile.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/developerjs/token.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/lib/crypto-js/crypto-js.min.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/developerjs/encryptepayload.js?v={configuration["StaticVersion"]}")"></script>

}

<div class="modal fade" id="AddNewUnitmap" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Enter Unit Details With Mapping</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="SaveUnitWithMap" method="post" name="SaveUnitWithMap">
                        <div class="row">
                            <span class=" d-none" id="spnName">NA</span>
                            <span class=" d-none" id="spnRank">NA</span>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control js-uppercase" placeholder="Enter SUS No" name="txtSusno" id="txtSusno" minlength="8" maxlength="8" data-val="true" data-val-regex="Enter valid SUS No: 7 digits followed by suffix Y, H, A, L, W, X, F, M, P, K, or N." data-val-required="SUS No is required." data-val-regex-pattern="^(?!0{7})\d{7}[YHALWXFMPKN]$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtSusno" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control textarea-auto-height js-uppercase" placeholder="Enter Unit" name="txtUnit" id="txtUnit" rows="2" maxlength="100" data-val="true" data-val-regex="Unit name must contain at least one capital alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Unit Name is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Z])[A-Z0-9&\/()\-]+(?: [A-Z0-9&\/()\-]+)*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnit" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Abbreviation <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control js-uppercase" placeholder="Abbreviation as Per Unit Name" id="txtUnitAbbr" name="txtUnitAbbr" maxlength="10" data-val="true" data-val-regex="Unit Abbreviation must contain at least one capital alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Unit Abbreviation is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Z])[A-Z0-9&\/()\-]+(?: [A-Z0-9&\/()\-]+)*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitAbbr" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Select Unit Type <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType1" value="1" checked>
                                        <label class="form-check-label" for="UnitType1">Unit</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType2" value="2">
                                        <label class="form-check-label" for="UnitType2">Fmn HQ</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType3" value="3">
                                        <label class="form-check-label" for="UnitType3">Dte/Sub Dte Branch</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row mb-2 unittype">
                                <label class="col-form-label col-sm-4 fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlCommand" id="ddlCommand" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Comd / PSO is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Comd / PSO </option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlCommand" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-4 unittype">
                                <label class="col-form-label col-sm-4 fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlCorps" id="ddlCorps" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Corps / Dte / Area is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Corps / Dte / Area </option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlCorps" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2 unittype">
                                <label class="col-form-label col-sm-4 fw-bold">Div  /Branch / Sub Area<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlDiv" id="ddlDiv" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Div  /Branch / SubArea is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Div  /Branch / SubArea </option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlDiv" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2 unittype">
                                <label class="col-form-label col-sm-4 fw-bold">Bde<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlBde" id="ddlBde" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Bde is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Bde </option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlBde" data-valmsg-replace="true"></span>
                                </div>
                            </div>
