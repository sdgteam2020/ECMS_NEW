@model DTOIMLoginRequest
@{
    ViewBag.Title = "IM Login Section";
    ViewBag.Description = "IM Login Section";
    ViewBag.Keywords = "";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<style>
    .form-group .labellogin {
        font-size: 16px;
        font-weight: 700;
    }
</style>

<div class="page">
    <div class="container-fluid">
        <partial name="~/Views/Shared/_CommonHeader.cshtml" />
        <div class="row">
            <div class="col-md-6 col-lg-6 col-xl-4 bg-white login-wrap align-items-center">
                <div class="login py-2 py-sm-4">
                    <div class="row">
                        <div class="col-md-10 col-lg-10 col-xl-9 mx-auto">
                            <div class="card-sigin">
                                <div class="main-signup-header login-form">
                                    @* <h1 class="font-weight-bold text-center mb-0 mt-3 logo"><color style="color: #D97904">Login</color></h1>*@

                                    <p class="font-weight-bold font-weight-700 text-center mb-4 mt-1">Kindly login with your Domain Id here.</p>
                                    <div class="pb-3 mt-3">
                                        <form asp-antiforgery="true" method="post" asp-action="IMLoginSelf" autocomplete="off" role="form">
                                            <div class="form-group">
                                                <label class="labellogin">Domain ID</label>
                                                <input asp-for="DomainId" class="form-control" maxlength="20" placeholder="Enter Domain ID..." /> @* value="user1" *@
                                                <span asp-validation-for="DomainId" class="text-danger"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Role" class="form-label fs-6 labellogin"></label>
                                                <select asp-for="Role" class="form-select">
                                                    <option value="">Select Role</option>
                                                    <option value="user" selected>user</option>
                                                    <option value="admin">admin</option>
                                                </select>
                                                <span asp-validation-for="Role" class="text-danger"></span>
                                            </div>
                                            <button type="submit" class="btn btn-primary text-uppercase py-2 fs-5 w-100 mt-2">Next</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script asp-src-include="~/developerjs/login.js"></script>
}
