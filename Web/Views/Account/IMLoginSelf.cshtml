@model DTOIMLoginRequest
@{
    ViewBag.Title = "IM Login Section";
    ViewBag.Description = "IM Login Section";
    ViewBag.Keywords = "";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<link asp-href-include="~/developercss/imloginself.css" rel="stylesheet" />

<div class="ecms-login-page">
    <div class="ecms-token-bg-shield" aria-hidden="true">
        <svg viewBox="0 0 180 220" fill="none">
            <path d="M90 12L154 38V90C154 144 126 185 90 205C54 185 26 144 26 90V38L90 12Z" stroke="currentColor" stroke-width="8" />
            <circle cx="90" cy="78" r="24" stroke="currentColor" stroke-width="8" />
            <path d="M56 142C58 116 70 104 90 104C110 104 122 116 124 142" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
            <rect x="64" y="132" width="52" height="44" rx="8" stroke="currentColor" stroke-width="8" />
            <path d="M90 150V163" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
        </svg>
    </div>
    <div class="ecms-login-backdrop" aria-hidden="true"></div>

    <main class="ecms-login-stage">
        <section class="ecms-login-card" aria-label="ECMS login form">
            <div class="ecms-login-badge" aria-hidden="true">
                <svg class="ecms-shield-svg" viewBox="0 0 64 64" role="img" focusable="false">
                    <path class="shield-outline" d="M32 4 L53 12 V28 C53 43 44 54 32 60 C20 54 11 43 11 28 V12 Z" />
                    <circle class="shield-user-head" cx="32" cy="24" r="6" />
                    <path class="shield-user-body" d="M22 40 C23.8 33.8 28 31 32 31 C36 31 40.2 33.8 42 40" />
                    <rect class="shield-lock-body" x="24" y="40" width="16" height="12" rx="2" />
                    <path class="shield-lock-hook" d="M27 40 V36 C27 33 29 31 32 31 C35 31 37 33 37 36 V40" />
                </svg>
            </div>

            <div class="ecms-login-panel">
                <div class="ecms-login-heading">
                    <h1>Login to Continue</h1>
                    <div class="ecms-login-divider">
                        <span></span>
                        <i class="fa fa-star"></i>
                        <span></span>
                    </div>
                    <p>Kindly login with your Domain Id here.</p>
                </div>

                <form asp-antiforgery="true" method="post" asp-action="IMLoginSelf" autocomplete="off" role="form" class="ecms-login-form">
                    <div class="ecms-form-group">
                        <label asp-for="DomainId" class="ecms-form-label">Domain ID</label>
                        <div class="ecms-input-wrap">
                            <i class="fa fa-user ecms-input-icon" aria-hidden="true"></i>
                            <input asp-for="DomainId"
                                   class="form-control alpha-num-only ecms-input"
                                   maxlength="20"
                                   placeholder="Enter Domain ID..."
                                   autocomplete="off" />
                        </div>
                        <span asp-validation-for="DomainId" class="text-danger ecms-validation"></span>
                    </div>

                    <div class="ecms-form-group">
                        <label asp-for="Role" class="ecms-form-label">Role</label>
                        <div class="ecms-input-wrap ecms-select-wrap">
                            <i class="fa fa-user ecms-input-icon" aria-hidden="true"></i>
                            <select asp-for="Role" class="form-select ecms-input ecms-select">
                                <option value="">Select Role</option>
                                <option value="User" selected>user</option>
                                <option value="Admin">admin</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger ecms-validation"></span>
                    </div>

                    <button type="submit" class="ecms-login-submit">
                        <span>NEXT</span>
                        <i class="fa fa-arrow-right" aria-hidden="true"></i>
                    </button>

                    <div class="ecms-secure-note">
                        <i class="fa fa-shield" aria-hidden="true"></i>
                        <span>Secure access to enterprise resources.</span>
                    </div>

                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show ecms-alert" role="alert">
                            <span class="text-success">@Html.Raw(@TempData["success"])</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show ecms-alert" role="alert">
                            <span class="text-danger">@Html.Raw(@TempData["error"])</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </form>
            </div>
        </section>
    </main>
</div>

@section Scripts {
}
