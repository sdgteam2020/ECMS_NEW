@model DTODecryptZipFileRequest
@{
    ViewData["Title"] = "Decrypt Zip File";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .upload-options label::after {
        content: 'Upload Photo';
        font-family: 'Material Icons';
        position: absolute;
        font-size: 1.5rem;
        color: rgba(230, 230, 230, 1);
        top: calc(60% - 1.5rem);
        left: calc(30% - 1.25rem);
        z-index: 0;
    }
</style>
<div class="card">
    <form enctype="multipart/form-data" action="" id="DecryptZipFile" name="DecryptZipFile" method="post">
        <div class="p-2">
            <div class="row">
                <div class="col-md-12 ">
                    <div class="card">
                        <div class="seven">
                            <h1>Upload Zip File</h1>
                        </div>
                        <div class="mt-2 ml-4">
                            <div class="row">
                                <div class="col-xl-12 text-center">
                                    <div class="row mb-1 required">
                                        <div class="col-xl-12 text-center">
                                            <span class="text-danger text-center">Please upload only zip format</span>
                                            <div class="col-sm-12 text-center">
                                                <div class="box">
                                                    <div class="upload-options text-center">
                                                        <label>
                                                            <input asp-for="ZipFile" class="form-control" accept="application/zip" />
                                                        </label>
                                                    </div>
                                                </div>
                                                <span id="lblPhoto" style="color: red;"></span>
                                                <span asp-validation-for="ZipFile" class="text-danger"></span>
                                                <span id="lblZipFileNotification" class="text-danger">File Upload Upto 5MB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="text-center mb-2">
                                    <button type="submit" class="btn btn-primary disabled" id="btnsave">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@* </div> *@
@section Scripts {
    <script asp-src-include="~/developerjs/DecryptZipFile.js"></script>
}