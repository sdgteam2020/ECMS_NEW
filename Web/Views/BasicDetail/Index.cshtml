@inject IConfiguration configuration;
@{
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<link href="@($"{Cdn}/css/popupprintcss.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<link href="@($"{Cdn}/select2/css/select2.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<link href="@($"{Cdn}/developercss/indexbasicdetail.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        @if (Convert.ToString(ViewBag.Id) == "0")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span>Appl All I-Card</span>
                                }
                                else
                                {
                                            <span>Appl All I-Card</span>
                                }

                                </div>
                        }

                        else if (Convert.ToString(ViewBag.Id) == "1")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > <a href="/Home/SubDashboard" class="mr-2">I-Card Request</a>  >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span>Appl Drafted for Offrs</span>
                                }
                                else
                                {
                                            <span>Appl Drafted for JCOs/OR</span>
                                }

                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "11")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Task" class="mr-2">Task</a> >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span><a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=">I-Card Status</a> >Appl Drafted for Offrs</span>
                                }
                                else
                                {
                                            <span><a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==">I-Card Status</a> >Appl Drafted for JCOs/OR</span>
                                }
                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "888")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > <a href="/Home/SubDashboard" class="mr-2">I-Card Request</a> >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span>Appl Submitted for Offrs</span>
                                }
                                else
                                {
                                            <span>Appl Submitted for JCOs/OR</span>
                                }

                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "88")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Task" class="mr-2">Task</a> >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span><a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=">I-Card Status</a> >Appl Submitted for Offrs</span>
                                }
                                else
                                {
                                            <span><a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==">I-Card Status</a> >Appl Submitted for JCOs/OR</span>
                                }
                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "999")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > <a href="/Home/SubDashboard" class="mr-2">I-Card Request</a>  >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span>Appl Rejected for Offrs</span>
                                }
                                else
                                {
                                            <span>Appl Rejected for JCOs/OR</span>
                                }

                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "99")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Task" class="mr-2">Task</a> >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span><a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=">I-Card Status</a> >Appl Rejected for Offrs</span>
                                }
                                else
                                {
                                            <span><a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==">I-Card Status</a> >Appl Rejected for JCOs/OR</span>
                                }
                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "777")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > <a href="/Home/SubDashboard" class="mr-2">I-Card Request</a>  >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span>Appl Completed for Offrs</span>
                                }
                                else
                                {
                                            <span>Appl Completed for JCOs/OR</span>
                                }

                                </div>
                        }
                        else if (Convert.ToString(ViewBag.Id) == "77")
                        {
                                <div>
                                    <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Task" class="mr-2">Task</a> >
                                @if (string.IsNullOrEmpty(Convert.ToString(ViewBag.jcoor)))
                                {
                                            <span><a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=">I-Card Status</a> >Appl Completed for Offrs</span>
                                }
                                else
                                {
                                            <span><a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==">I-Card Status</a> >Appl Completed for JCOs/OR</span>
                                }
                                </div>
                        }
                        else
                        {
                            if (Convert.ToString(ViewBag.jcoor) == "SmNvL09ycw==")
                            {
                                        <div>
                                            <a href="/Home/Index" class="mr-2">Home</a> >
                                            <a href="/Home/Task" class="mr-2">Task</a> >
                                            <a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==" class="mr-2">I-Card Status</a> > @ViewBag.Title
                                        </div>
                            }
                            else
                            {
                                        <div>
                                            <a href="/Home/Index" class="mr-2">Home</a> > 
                                            <a href="/Home/Task" class="mr-2">Task</a> >
                                            <a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=" class="mr-2">I-Card Status</a> > @ViewBag.Title
                                        </div>
                            }

                        }

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span class="d-none" id="spnType">@ViewBag.Type</span>
            <span class="d-none" id="spnStepCounter">@ViewBag.StepCounter</span>
            <span class="d-none" id="spnJCOOR">@ViewBag.jcoor</span>
            <span class="d-none" id="spnVBId">@ViewBag.Id</span>
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        @ViewBag.Title
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height">
            <div class="row">
                <div class="col-xl-12">
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldatatabledata_Fwd">
                    </table>
                </div>
            </div>
        </div><!-- Row End -->
    </div>
</div>

@section Scripts {
        <script src="@($"{Cdn}/developerjs/fwdrecord.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/developerjs/Index_BasicDetails.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/js/CustomScript.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/developerjs/ICardPrint.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/developerjs/Token.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/developerjs/mtables.js?v={configuration["StaticVersion"]}")"></script>
        <script src="@($"{Cdn}/select2/js/select2.min.js?v={configuration["StaticVersion"]}")"></script>

        <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}