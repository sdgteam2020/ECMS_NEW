<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        @ViewBag.Title
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row">
                <div class="col-xl-12">
                    <div class="table-responsive">
                        <table id="tbldatatabledata" class="table border border-purple table-striped no-footer dataTable table-hover" style="width:100%">
                            <thead> 
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model[0].Sno)</th>
                                    <th>@Html.DisplayNameFor(model => model[0].ServiceNo)</th>
                                    <th>Rank , Name</th>
                                    <th>Unit</th>
                                   
                                  @*   <th>@Html.DisplayNameFor(model => model[0].DOB)</th> *@
                               @*      <th>@Html.DisplayNameFor(model => model[0].DateOfCommissioning)</th> *@
                                    @* <th>Address</th> *@
                                    <th>Appl ID</th>
                                    <th>Type</th>
                                    <th>Reason for Requisition</th>     
                                    <th class="noExport">Posting</th>
                                    <th class="noExport">History</th>
                                    <th class="noExport">Print | Edit | Fwd</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Sno</td>
                                        <td><a href="#" onclick="GetBasicDetailByRequestId(@(@item.RequestId));event.preventDefault();"><span class="ServiceNo">@item.ModifiedServiceNo</span></a></td>
                                        <td class="PersName">@item.RankName @item.FName @(item.LName == null ? "" : item.LName)</td>
                                        <td class="UnitName">@item.UnitName</td>
                                       @*  <td>@item.DOB.ToString("dd/MMM/yyyy")</td> *@
                                        @* <td>@item.DateOfCommissioning.ToString("dd/MMM/yyyy")</td> *@
                                        @* <td>@item.PermanentAddress</td> *@
                                        <td>@item.TrackingId</td>
                                        <td>@item.ApplyFor </td>
                                        <td>@item.ICardType</td>
                                        <td>
                                            @if(item.IsPosting>0)
                                            {
                                                <span class="badge badge-pill badge-danger">Yes</span> 
                                            }
                                            else
                                            {
                                                <span class="badge badge-pill badge-success">No</span>
                                            }
                                        </td>
                                        <td class="noExport"><button class="btn btn-icon btn-round btn-primary mr-1 historyRequest" data-toggle="tooltip" data-placement="left" title="@item.Remark"><i class="fa fa-history" aria-hidden="true"></i></button></td>
                                       
                                        <td class="noExport">
                                            <div class="d-flex p-2">
                                                <button class="btn btn-icon btn-round btn-primary mr-2" onclick="GetICardPrintPreviewByRequestId(@(@item.RequestId))"><i class="fa fa-print mt-2"></i></button>
                                                    <span class="spnBasicDetailId d-none">@item.BasicDetailId</span>
                                                    <span class="spnTrnFwdId d-none">@item.IsTrnFwdId</span>
                                                    <span class="spnRequestId d-none">@item.RequestId</span>
                                                    <span class="spnStepCounterId d-none">@item.StepCounter</span>
                                                    <span class="spnStepId d-none">@item.StepId</span>
                                                    <span class="spnApplyFor d-none">@item.ApplyForId</span>
                                                    <span class="spnarmyUnitId d-none">@item.UnitId</span>
                                                    <span class="spnRegistrationApplyFor d-none">@item.RegistrationApplyFor</span>
                                                    <span class="spnServiceNo d-none">@item.ServiceNo</span>

                                                    @if ((item.StepCounter == 1 || item.StepCounter == 7 || item.StepCounter == 8 || item.StepCounter == 9 || item.StepCounter == 10) && (ViewBag.Id == 0 || ViewBag.Id == 1 || ViewBag.Id == 11 || item.IsFwdStatusId == 3))
                                                    {
                                                        <a asp-controller="BasicDetail" asp-action="BasicDetail" asp-route-Id="@item.EncryptedId" class="btn btn-icon btn-round btn-warning mr-2"><i class="fas fa-edit mt-2"></i></a>
                                                        <button class="btn btn-icon btn-round btn-primary mr-1 fwdrecord"><i class="fa fa-step-forward"></i></button>
                                                    }


                                                    @if (item.StepCounter >= 2 && item.StepCounter <= 6)
                                                    {
                                                        <span class="badge rounded-pill bg-light text-primary mt-3">Processed</span>


                                                    <button class=" btndownloadpdf" id="btndownloadpdf" data-toggle="tooltip" data-placement="top" title="Download Details"><img src="/Images/digitalsign.png" width="40" /></button>

                                                    @* Downlaod<br> Digital<br> Signature *@
                                                    }
                                                    else
                                                    {
                                                        @if (item.IsFwdStatusId == 3)
                                                        {

                                                            <span class="badge rounded-pill bg-light text-danger mt-3" data-toggle="tooltip" data-placement="left" title="@item.Remark">Rejected</span>

                                                        }


                                                    }

                                                </div>


                                            </td>
                                        </tr>
                                }
                               
                           
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div><!-- Row End -->
    </div>
</div>

@section Scripts{
    <script asp-src-include="~/js/CustomScript.js"></script>
    <script asp-src-include="~/developerjs/Fwdrecord.js"></script>
    <script asp-src-include="~/developerjs/ICardPrint.js"></script>
    <script asp-src-include="~/developerjs/Token.js"></script>
    <script asp-src-include="~/developerjs/mtables.js"></script>

    <script asp-src-include="~/js/datatables/jquery.datatables.min.js"></script>
    <script asp-src-include="~/js/datatables/dataTables.responsive.min.js"></script>
    <script asp-src-include="~/js/datatables/responsive.dataTables.min.js"></script>
    <script asp-src-include="~/js/datatables/dataTables.bootstrap4.min.js"></script>
    <script asp-src-include="~/js/datatables/responsive.bootstrap4.min.js"></script> <!-- DataTables Responsive extension and specifically integrates Responsive behavior with Bootstrap 4 styling. -->
    <script asp-src-include="~/js/datatables/dataTables.buttons.min.js"></script> <!-- It adds the foundational functionality needed to add custom buttons (like Export, Print, or custom actions) to a DataTable.-->
    <script asp-src-include="~/js/datatables/buttons.bootstrap4.min.js"></script> <!-- Export buttons (like Copy, CSV, Excel, PDF, Print) to match Bootstrap 4 design and layout. -->
    <script asp-src-include="~/js/datatables/jszip.min.js"></script> <!-- for Excel export -->
    <script asp-src-include="~/js/datatables/pdfmake.min.js"></script> <!-- for PDF export -->
    <script asp-src-include="~/js/datatables/vfs_fonts.js"></script> <!-- required by pdfmake -->
    <script asp-src-include="~/js/datatables/buttons.html5.min.js"></script> <!-- All HTML5 export buttons -->
    @* <script asp-src-include="~/js/datatables/buttons.print.min.js"></script> *@ <!-- Adds a "Print" button to DataTables toolbar for print preview and printing -->
    <script asp-src-include="~/js/datatables/datatables-call.js"></script> <!-- your custom JS that calls and configures the DataTables plugin -->
}