@model BasicDetailCrtAndUpdVM
@{
    ViewBag.Title = "Edit I-card detail";
    int sno = 1;
}
<link asp-href-include="~/developercss/basicdetail.css" rel="stylesheet" />

<div class="card ecms-basicdetail-shell">
    <span id="SpnTxnId" class="d-none">0</span>

    <form enctype="multipart/form-data" asp-controller="BasicDetail" asp-action="BasicDetail" id="SaveForm" method="post" class="ecms-basicdetail-form">
        <div class="p-2 ecms-basicdetail-page">
            <input type="hidden" id="EncryptedData" name="EncryptedData" value="null" />

            <input hidden asp-for="ApplyForId" />
            <input hidden asp-for="RegistrationId" />
            <input hidden asp-for="TypeId" />
            <input hidden asp-for="UnitId" />
            <input hidden id="spnrankid" value="@ViewBag.OptionsRankId" />
            <input hidden id="spnUnitIdid" value="@ViewBag.OptionsUnitId" />
            <input hidden id="spnArmedId" value="@ViewBag.OptionsArmedId" />
            <input hidden id="spnRegimentalId" value="@ViewBag.OptionsRegimentalId" />
            <input hidden id="spnBloodGroupId" value="@ViewBag.OptionsBloodGroupId" />
            <input hidden id="spnIssuingAuthorityId" value=@(Model.IssuingAuthorityId > 0 ? Model.IssuingAuthorityId : 0) />

            <div class="row">
                <span id="spnhdns" class="d-none">@ViewBag.hdns</span>
                <div class="col-md-12 ecms-summary-wrap">
                    <div class="card cardbg minheight mb-2 mt-2 ecms-summary-card">
                        <div class="seven">
                            <h1><span id="icarddetails"></span></h1>
                        </div>
                        <div class="mt-2 ml-4">

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Logged in User Detls</label>
                                        <div class="col-sm-8">
                                            <label id="RegdUser" class="col-form-label"></label>

                                        </div>

                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Category</label>
                                        <div class="col-sm-8">
                                            <label id="lblCategory" class="col-form-label"></label>

                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Unit Name</label>
                                        <div class="col-sm-8">
                                            <label id="lblunitname" class="col-form-label"></label>

                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Reason For Apply</label>
                                        <div class="col-sm-8">
                                            <label id="lblReason" class="col-form-label"></label>

                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 ecms-form-wrap">
                    <div class="card ecms-initiate-card">
                        <div class="seven">
                            <h1>Initiate Request</h1>
                        </div>
                        <div class="mt-2 ml-4">

                            <div class="row">
                                <div class="col-xl-2 ecms-upload-column">
                                    <div class="row mb-1 required">
                                        <div class="col-xl-12">
                                            <span class="text-danger text-center">Please upload only jpeg,jpg,png format</span>

                                            <div class="col-sm-12">

                                                @if (Model.ExistingPhotoInBase64 != null)
                                                {
                                                    <div class="box">
                                                        <div class="js--image-preview">
                                                            <img id="PhotoPath" src="@Model.ExistingPhotoInBase64" height="158" width="180" loading="lazy" alt="Applicant photo preview" />
                                                        </div>
                                                        <div class="text-center mt-2">
                                                            <button type="button" id="btnOpenPhotoModal" class="btn btn-sm btn-primary">
                                                                Upload / Change Photo
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="box">
                                                        <div class="js--image-preview">
                                                            <img id="PhotoPath" src="~/writereaddata/images/noimage.png" height="158" width="180" loading="lazy" alt="Applicant photo preview" />
                                                        </div>
                                                        <div class="text-center mt-2">
                                                            <button type="button" id="btnOpenPhotoModal" class="btn btn-sm btn-primary">
                                                                Upload Photo
                                                            </button>
                                                        </div>
                                                    </div>
                                                }

                                                <span id="lblPhoto" class="text-red"></span>
                                                <span asp-validation-for="Photo_" class="text-danger"></span>
                                                <span id="lblPhotoNotification" class="text-danger">Photo Upload Upto 200KB</span>
                                            </div>
                                        </div>

                                        <div class="col-xl-12">
                                            <div class="col-sm-12">
                                                @if (Model.ExistingSignatureInBase64 != null)
                                                {
                                                    <div class="box_sig">
                                                        <div class="js--image-preview_sig">
                                                            <img id="SignaturePath" src="@Model.ExistingSignatureInBase64" height="80" width="180" loading="lazy" alt="Applicant signature preview" />
                                                        </div>
                                                        <div class="text-center mt-2">
                                                            <button type="button" id="btnOpenSignatureModal" class="btn btn-sm btn-primary">
                                                                Upload / Change Signature
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="box_sig">
                                                        <div class="js--image-preview_sig">
                                                            <img id="SignaturePath" src="~/writereaddata/images/noimage.png" height="80" width="180" loading="lazy" alt="Applicant signature preview" />
                                                        </div>
                                                        <div class="text-center mt-2">
                                                            <button type="button" id="btnOpenSignatureModal" class="btn btn-sm btn-primary">
                                                                Upload Signature
                                                            </button>
                                                        </div>
                                                    </div>
                                                }

                                                <span id="lblSignature" class="text-red"></span>
                                                <span asp-validation-for="Signature_" class="text-danger"></span>
                                                <span id="lblSignatureNotification" class="text-danger">Signature Upload Upto 50KB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-5 ecms-field-column ecms-left-fields">
                                    <div class="row mb-1">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label class="col-sm-3 col-form-label form-label labelprofile">Paper I-Card No</label>
                                        <div class="col-sm-8">
                                            <input asp-for="PaperIcardNo" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="Enter Paper I card No" placeholder="Enter Paper I card No" maxlength="12" required />
                                            <span asp-validation-for="PaperIcardNo" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold labelprofile">@(sno++).</label>
                                        <label class="col-sm-3 col-form-label form-label labelprofile">Service No</label>
                                        <div class="col-sm-8">
                                            <input asp-for="ServiceNo" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="IC No Not Editable" placeholder="IC-12345X/JC-12345X" readonly required />
                                            <span asp-validation-for="ServiceNo" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="RankId" class="col-sm-3 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-8">
                                            <select asp-for="RankId" class="form-select full-width" data-toggle="tooltip" title="Select Rank">
                                            </select>
                                            <span asp-validation-for="RankId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="FName" class="col-sm-3 col-form-label form-label labelprofile">First Name</label>
                                        <div class="col-sm-8">
                                            <input asp-for="FName" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="First Name" placeholder="Max 18 Characters incl spaces" readonly required />
                                            <span asp-validation-for="FName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="LName" class="col-sm-3 col-form-label form-label labelprofile">Last Name</label>
                                        <div class="col-sm-8">
                                            <input asp-for="LName" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="Last Name" placeholder="Max 18 Characters incl spaces" readonly />
                                            <span asp-validation-for="LName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-1 required">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="UnitId" class="col-sm-3 col-form-label form-label labelprofile">Unit Name</label>
                                        <div class="col-sm-8">
                                            <input type="text" id="txtUnit" name="txtUnit" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="Enter SUS No And Select Unit Name" placeholder="Enter SUS No And Select Unit Name" />

                                            <span asp-validation-for="UnitId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="ArmedId" class="col-sm-3 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-8">
                                            <select asp-for="ArmedId" class="form-select full-width" data-toggle="tooltip" title="Select Armed" required>
                                            </select>
                                            <span asp-validation-for="ArmedId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required OptionsRegimental">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label class="col-sm-3 col-form-label form-label labelprofile">Regimental Centre</label>
                                        <div class="col-sm-8">
                                            <select asp-for="RegimentalId" class="form-select full-width" data-toggle="tooltip" title="Select Regimental Name">
                                            </select>
                                            <span asp-validation-for="RegimentalId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label class="col-sm-3 col-form-label form-label labelprofile">Iden Mark</label>
                                        <div class="col-sm-8">
                                            <textarea asp-for="IdenMark1" rows="3" class="form-control alpha-num-only text-uppercase" data-toggle="tooltip" title="Enter IdenMark " placeholder="Only one iden Mk (Max 10 characters incl spaces)" required></textarea>
                                            <span asp-validation-for="IdenMark1" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-1 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="DOB" class="col-sm-3 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-8">

                                            <input type="text" id="DOB_" name="DOB_" class="form-control" value="@Model.DOB.ToString("dd-MMM-yyyy")" readonly />
                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="col-xl-4 ecms-field-column ecms-right-fields">
                                    <div class="row mb-1 required">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label class="col-sm-4 col-form-label form-label labelprofile">Height(CM)</label>
                                        <div class="col-sm-6">
                                            <input asp-for="Height" class="form-control" min="100" max="250" required placeholder="Height in CM" data-toggle="tooltip" title="Height in CM " />
                                            <span asp-validation-for="Height" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="AadhaarNo" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <input asp-for="AadhaarNo" class="form-control isNumerictxt" required placeholder="AadhaarNo" data-toggle="tooltip" title="Enter Aadhaar No" maxlength="12" minlength="12" /> @* onkeyup="Aadhaarformate(event,this);" *@
                                            <span asp-validation-for="AadhaarNo" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-1 required">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="BloodGroupId" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <select asp-for="BloodGroupId" class="form-select full-width" data-toggle="tooltip" title="Select Blood Group Name " required>
                                            </select>
                                            <span asp-validation-for="BloodGroupId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="PlaceOfIssue" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <input asp-for="PlaceOfIssue" readonly class="form-control Alphanumeric text-uppercase" data-toggle="tooltip" title="Enter Place Of Issue" maxlength="50" placeholder="Unit Abbreviation" />
                                            <span asp-validation-for="PlaceOfIssue" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="DateOfIssue" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <input asp-for="DateOfIssue" readonly class="form-control todaydate d-none" data-toggle="tooltip" title="DEPENDS ON UNIT OF SECOND LEVEL APPROVER." />
                                            <input type="text" placeholder="Depends on Unit of Second level approver." id="tempDateOfIssue" class="form-control text-uppercase " readonly />
                                            <span asp-validation-for="DateOfIssue" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="IssuingAuthorityId" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <select asp-for="IssuingAuthorityId" class="form-select full-width" data-toggle="tooltip" title="Select Your Approver Appt.">
                                            </select>
                                            <span asp-validation-for="IssuingAuthorityId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-1">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="DateOfCommissioning" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">

                                            <input type="text" id="DOC" name="DOC" class="form-control" value="@Model.DateOfCommissioning.ToString("dd-MMM-yyyy")" readonly />
                                        </div>
                                    </div>
                                    <div class="row mb-1 required">
                                        <label class="col-sm-2 col-form-label text-center font-weight-bold">@(sno++).</label>
                                        <label asp-for="PermanentAddress" class="col-sm-4 col-form-label form-label labelprofile"></label>
                                        <div class="col-sm-6">
                                            <textarea asp-for="PermanentAddress" rows="6" class="form-control alpha-num-only text-uppercase" placeholder="" required readonly></textarea>
                                            <span asp-validation-for="PermanentAddress" class="text-danger"></span>
                                        </div>
                                    </div>

                                </div>

                                <div class="col-xl-12">
                                    <div class="row required">
                                        <div class="col-sm-12">
                                            <div class="form-check ecms-declaration-check">
                                                <input type="checkbox" id="TermsConditions" class="form-check-input" />
                                                <label class="">
                                                    <ul class="notefont">
                                                        <li>I HEREBY DECLARE THAT THE DETAILS FURNISHED ABOVE ARE TRUE TO BEST OF MY KNOWLEDGE. I AM FULLY AWARE THAT, DECLARATION OF FALSE INFO IS AN OFFENCE WHICH WOULD MAKE ME LIABLE FOR PUNISHMENT AS PER EXTANT REGULATIONS.</li>
                                                        <li>I HEREBY STATE THAT I HAVE NO OBJECTION IN AUTHENTICATING MYSELF WITH AADHAAR BASED AUTHENTICATION SYSTEM AND CONSENT TO PROVIDING MY AADHAAR NUMBER ALONG WITH THE AUTHENTICATION DETAILS FOR THE PURPOSE OF SMART I-CARD.</li>
                                                    </ul>

                                                </label>
                                                <span asp-validation-for="TermsConditions" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                    <div class="text-center mb-4 ecms-save-row">
                                        <button type="submit" class="btn btn-primary disabled mb-1" id="btnsave">Save & Next</button>

                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>


        <!-- Photo Upload Modal -->
        <div class="modal fade" id="photoUploadModal" tabindex="-1" role="dialog" aria-labelledby="photoUploadModalTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="photoUploadModalTitle">Upload Photograph</h5>
                        <button type="button" class="close js-photo-cancel" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="alert alert-info mb-0" role="note">
                                    <strong>Photograph requirements</strong>
                                    <ul class="mb-0 mt-2 pl-3">
                                        <li>File format: JPG, JPEG or PNG only.</li>
                                        <li>Maximum file size: 200 KB.</li>
                                        <li>Use a recent passport-size colour photograph.</li>
                                        <li>Use a plain white or light-coloured background.</li>
                                        <li>Face should be front-facing, centred and clearly visible.</li>
                                        <li>Avoid cap, dark glasses, blur, heavy shadow or cropped face.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="Photo_" class="font-weight-bold">Select photograph</label>
                                <input asp-for="Photo_" id="Photo_" type="file" form="SaveForm" class="form-control-file" accept="image/jpeg,image/jpg,image/png" />
                                <small class="form-text text-muted">The page preview will change only after you confirm this photograph.</small>

                                <div id="PhotoModalMessage" class="text-danger mt-2" aria-live="polite"></div>

                                <div id="PhotoModalPreviewWrap" class="text-center mt-3 d-none">
                                    <div class="font-weight-bold mb-2">Selected Photo Preview</div>
                                    <img id="PhotoModalPreview" class="img-thumbnail" width="220" height="260" alt="Selected photograph preview" />
                                    <div id="PhotoModalFileInfo" class="small text-muted mt-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary js-photo-cancel">Cancel</button>
                        <button type="button" id="btnUsePhoto" class="btn btn-primary" disabled>Use Photo &amp; Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Signature Upload Modal -->
        <div class="modal fade" id="signatureUploadModal" tabindex="-1" role="dialog" aria-labelledby="signatureUploadModalTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="signatureUploadModalTitle">Upload Signature</h5>
                        <button type="button" class="close js-signature-cancel" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="alert alert-info mb-0" role="note">
                                    <strong>Signature requirements</strong>
                                    <ul class="mb-0 mt-2 pl-3">
                                        <li>File format: JPG, JPEG or PNG only.</li>
                                        <li>Maximum file size: 50 KB.</li>
                                        <li>Use a plain white or light-coloured background.</li>
                                        <li>Use a clear blue or black ink signature.</li>
                                        <li>Keep the complete signature inside the image.</li>
                                        <li>Avoid blur, shadow, extra text or unnecessary background.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="Signature_" class="font-weight-bold">Select signature</label>
                                <input asp-for="Signature_" id="Signature_" type="file" form="SaveForm" class="form-control-file" accept="image/jpeg,image/jpg,image/png" />
                                <small class="form-text text-muted">The page preview will change only after you confirm this signature.</small>

                                <div id="SignatureModalMessage" class="text-danger mt-2" aria-live="polite"></div>

                                <div id="SignatureModalPreviewWrap" class="text-center mt-3 d-none">
                                    <div class="font-weight-bold mb-2">Selected Signature Preview</div>
                                    <img id="SignatureModalPreview" class="img-thumbnail" width="300" height="120" alt="Selected signature preview" />
                                    <div id="SignatureModalFileInfo" class="small text-muted mt-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary js-signature-cancel">Cancel</button>
                        <button type="button" id="btnUseSignature" class="btn btn-primary" disabled>Use Signature &amp; Close</button>
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>
@* </div> *@
@section Scripts {
    <script asp-src-include="~/developerjs/mtables.js"></script>
    <script asp-src-include="~/developerjs/basicdetails.js"></script>
}
