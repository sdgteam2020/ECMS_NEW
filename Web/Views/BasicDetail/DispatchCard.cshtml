@{
    ViewData["Title"] = "List of Dispatch Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var claimValue = ViewBag.ClaimValue;
    string lblForDispatch = string.Empty;
    if (claimValue == 1 || claimValue == 2 || claimValue == 3)
    {
        lblForDispatch = "Ready For Dispatch";
    }
    else
    {
        lblForDispatch = "Ready For Distribution";
    }
}
<style>
    .count-label {
        background-color: #044C92;
        text-align: center;
        padding: 0.5rem !important;
        margin-right: 0.25rem !important;
        border: hidden;
        font-weight: 700 !important;
        color: #fff !important;
        width: 120px;
        height: 60px;
    }

    .modal-xl {
        max-width: 90% !important;
        width: 90% !important;
    }

    .table {
        min-width: 100% !important;
    }

    .modal .modal-body .table-responsive {
        max-height: 500px;
    }

</style>
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Task" class="mr-2">Task</a> > Dispatch Card
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span class="d-none" id="spnClaimValue">@claimValue</span>
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Details of Cards Dispatch
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="col-xl-12">
                <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                    <h6 class="mb-3 mb-md-0">
                        @*                         Total Faulty <span id="lblTotal" class="ml-3 border border-light b px-2 py-1">0</span> *@
                    </h6>
                    <div>
                        <button type="button" id="btnDispatchStatus" class="btn btn-outline-success font-weight-600 btn-sm mr-1">@lblForDispatch</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table border border-purple table-striped no-footer dataTable table-hover" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="DataTableDialog" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><span id="lblModelTitle"></span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="mb-2 d-flex justify-content-between">
                        <div id="AdvSearch" class="mb-2 d-flex d-none">
                            @if (claimValue == 1)
                            {
                                <select id="searchField" class="form-control-AllowedKey form-control-sm mr-2" style="max-width: 180px;">
                                    <option value="" selected>Select Field</option>
                                    <option value="regimentalname">Regt</option>
                                    <option value="recordofficename">ORO</option>
                                </select>
                                <div id="searchInputContainer" class="mr-2" style="max-width: 250px;">
                                    <input type="text" id="searchText" class="form-control-AllowedKey form-control-sm" placeholder="Search..." />
                                </div>
                                <button id="btnSearch" class="btn btn-sm btn-outline-primary">Search</button>
                                <button id="btnClear" class="btn btn-sm btn-outline-secondary ml-2 mr-1">Clear</button>
                                <button id="btnProceedToDispatch" class="btn btn-sm btn-outline-success">Proceed to Dispatch</button>
                            }
                            else if (claimValue == 2)
                            {
                                <select id="searchField" class="form-control-AllowedKey form-control-sm mr-2" style="max-width: 180px;">
                                    <option value="susno" selected>SUS No</option>
                                </select>
                                <span class=" d-none" id="spnUnitMapId"></span>
                                <div id="searchInputContainer" class="mr-2" style="max-width: 250px;">
                                    <input type="text" id="searchText" class="form-control-AllowedKey form-control-sm" placeholder="Type SUS No" />
                                </div>
                                <button id="btnSearch" class="btn btn-sm btn-outline-primary">Search</button>
                                <button id="btnClear" class="btn btn-sm btn-outline-secondary ml-2 mr-1">Clear</button>
                                <button id="btnProceedToDispatch" class="btn btn-sm btn-outline-success">Proceed to Dispatch</button>
                            }
                            else if (claimValue == 3)
                            {
                                <select id="searchField" class="form-control-AllowedKey form-control-sm mr-2" style="max-width: 180px;">
                                    <option value="susno" selected>SUS No</option>
                                </select>
                                <span class=" d-none" id="spnUnitMapId"></span>
                                <div id="searchInputContainer" class="mr-2" style="max-width: 250px;">
                                    <input type="text" id="searchText" class="form-control-AllowedKey form-control-sm" placeholder="Type SUS No" />
                                </div>
                                <button id="btnSearch" class="btn btn-sm btn-outline-primary">Search</button>
                                <button id="btnClear" class="btn btn-sm btn-outline-secondary ml-2 mr-1">Clear</button>
                                <button id="btnProceedToDispatch" class="btn btn-sm btn-outline-success">Proceed to Dispatch</button>
                            }
                            else
                            {
                                <select id="searchField" class="form-control-AllowedKey form-control-sm mr-2" style="max-width: 180px;">
                                    <option value="" selected>Select Field</option>
                                    <option value="serviceno">Service No</option>
                                </select>
                                <div id="searchInputContainer" class="mr-2" style="max-width: 250px;">
                                    <input type="text" id="searchText" class="form-control-AllowedKey form-control-sm" placeholder="Search..." />
                                </div>
                                <button id="btnSearch" class="btn btn-sm btn-outline-primary">Search</button>
                                <button id="btnClear" class="btn btn-sm btn-outline-secondary ml-2 mr-1">Clear</button>
                            }

                        </div>
                        <button id="exportRequestIds" class="btn btn-sm btn-outline-success">Export CSV</button>

                    </div>
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer table-hover" role="grid" id="tbldatadialog">
                        </table>
                    </div>
                </div>
                <div class="col-sm-12" id="msg">
                </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>
<!-- Dispatch Details of Lot Wise -->
<div class="modal fade" id="DataTableDialogForLot" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><span id="lblModelTitleLot"></span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div>
                        <div id="LotDetails" class="alert alert-info small" style="white-space: nowrap; overflow-x: auto;">

                        </div>
                        <div class="mb-2 d-flex justify-content-end">
                            <button id="exportLot" class="btn btn-sm btn-outline-success mr-1">Export CSV</button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer table-hover" role="grid" id="tbldatadialogLot">
                        </table>
                    </div>
                </div>
                <div class="col-sm-12" id="msg">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dispatch In Dialog  -->
<div class="modal fade" id="DispatchInDialog" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Dispatch In</h5>
            </div>
            <form action="" id="SaveDispatchCardIn" method="post" name="SaveDispatchCardIn">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-sm-12 mb-3">
                            <div class="row">
                                <span class="d-none" id="spnDispatchCardId">0</span>
                                <div class="col-sm-12 mx-auto">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-5 labelprofile">Remark<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-7">
                                            <textarea class="form-control1" style="height:auto!important;" name="txtToRemark" id="txtToRemark" rows="3" maxlength="100" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="100" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Remark is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                            <span class="text-danger field-validation-valid" data-valmsg-for="txtToRemark" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnSubmit" class="btn btn-primary">Proceed</button>
                    <button type="button" id="btnClosed" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/DispatchCard.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
