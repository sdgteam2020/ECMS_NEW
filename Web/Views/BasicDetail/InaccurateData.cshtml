@model List<DTOBasicDetailTempRequest>
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/inaccuratedata.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <div>
                            <a href="/Home/Index" class="mr-2">Home</a> &gt;
                            <a href="/Home/Dashboard" class="mr-2">Dashboard</a> &gt;
                            Incorrect Details/Data
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="ecms-page-full ecms-fit-screen ecms-footer-safe ecms-inaccurate-page">
    <section class="ecms-card ecms-inaccurate-card">
        <div class="ecms-card-body ecms-inaccurate-card-body">
            <div class="ecms-page-title ecms-inaccurate-title d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3 ecms-min-0">
                    <div class="ecms-title-icon ecms-inaccurate-title-icon" aria-hidden="true">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>
                    <div class="ecms-min-0">
                        <h2>@ViewBag.Title</h2>
                        <p class="ecms-title-subtitle">Requests pending due to incorrect details or observation data</p>
                    </div>
                </div>

                <div class="badge bg-warning text-dark px-3 py-2 text-uppercase ecms-inaccurate-count"
                     aria-label="@Model.Count pending requests">
                    Pending: <span>@Model.Count</span>
                </div>
            </div>

            <section class="ecms-section ecms-inaccurate-section" aria-labelledby="incorrectRecordsTitle">
                <h3 class="ecms-section-title" id="incorrectRecordsTitle">
                    <i class="fa fa-list" aria-hidden="true"></i>
                    <span>Pending Request Records</span>
                </h3>

                <span id="spnhdns" class="d-none">@ViewBag.hdns</span>

                <div class="ecms-dt-wrap ecms-min-0">
                    <table id="tbldatatabledata"
                           class="table table-striped table-hover ecms-dt-table ecms-inaccurate-table"
                           aria-label="Requests pending due to incorrect details or data">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model[0].Sno)</th>
                                <th>Army No</th>
                                <th>Name</th>
                                <th>Created On</th>
                                <th>Observation</th>
                                <th class="noExport">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string[] rem = null;
                                if (item.Remarks2 != null)
                                    rem = item.Remarks2.Split("#");

                                <tr>
                                    <td>@item.Sno</td>
                                    <td>@item.ServiceNo</td>
                                    <td>@item.RankName @item.FName @(item.LName == null ? "" : item.LName)</td>
                                    <td>@item.UpdatedOn.ToString().Replace("-", "/").Replace("00:00:00", "")</td>
                                    <td>
                                        <ul class="ecms-observation-list">
                                            @if (rem != null)
                                            {
                                                foreach (var data in rem)
                                                {
                                                    <li>@data</li>
                                                }
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        <a asp-controller="BasicDetail"
                                           asp-action="InaccurateDataView"
                                           asp-route-Id="@item.EncryptedId"
                                           class="btn btn-primary btn-sm mr-2 ecms-inaccurate-action">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            <span>View Details</span>
                                        </a>
                                        <span id="RegistrationApplyFor" class="d-none">@item.RegistrationId</span>
                                        <span id="OffType" class="d-none">@item.ApplyForId</span>
                                        <span id="lCardType" class="d-none">@item.TypeId</span>
                                        <span id="ArmyNo" class="d-none">@item.ServiceNo</span>
                                        @* <button class="cls-btnRetry btn btn-success" id="btnRetry">Retry</button> *@
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
    <script asp-src-include="~/developerjs/inaccuratedata.js"></script>
}
