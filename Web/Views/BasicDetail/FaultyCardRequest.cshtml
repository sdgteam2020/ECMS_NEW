<style>
    .form-group .labelprofile {
        font-weight: 600;
    }

    .containerMain {
        margin-left: 10%;
        margin-right: 10%;
    }
</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/InitiateRequest" class="mr-2">Request</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> > Faulty Card Request

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span>
            @*<span id="PtoId" class="d-none">0</span>*@
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Faulty Card Request Indl Army No
                        <small class="text-muted"><span id="spnArmyNo"></span></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row g-3 row-deck mb-3">
                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="card cardbg minheight mb-2 mt-2">
                                <div class="seven">
                                    <h1>Faulty Card Request</h1>
                                </div>
                                <div class="mt-2 ml-4">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="seven">
                                                <h1>Personal Details</h1>
                                            </div>
                                            <div class="col-sm-12 text-center">
                                                <img src="" id="PhotoImagePath" height="180" class=" border border-primary" />
                                            </div>
                                            <div class="col-sm-12">
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">First Name</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblFName" class="col-form-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">Last Name</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblLName" class="col-form-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">Category</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblCategory" class="col-form-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-12">
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">Request Id</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblRequestId" class="col-form-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-8">
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Request Date</label>
                                                        <div class="col-sm-8">
                                                            <label id="lblRequestDate" class="col-form-label"></label>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Stage</label>
                                                        <div class="col-sm-8">
                                                            <select class="form-select" id="ddlStage" required>
                                                                <option value="">Select One</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Reason</label>
                                                        <div class="col-sm-8">
                                                            <select class="form-select" id="ddlFaultyRemark" required>
                                                                <option value="">Select One</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 text-center mb-4">
                                            <input type="button" class="btn btn-primary" id="btnSubmit" value="Submit" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/FaultyCardRequest.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>