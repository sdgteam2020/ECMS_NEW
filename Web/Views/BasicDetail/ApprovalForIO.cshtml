@{
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<link asp-href-include="~/css/popupprintcss.css" rel="stylesheet" />

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<style>
    .modal.left .modal-dialog, .modal.right .modal-dialog {
        position: fixed;
        margin: auto;
        width: 700px;
        height: 100%;
        text-align: left;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }
</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>

                        <div>
                            <span id="Isspnjcoor" class="d-none">@ViewBag.jcoor</span>
                            @if (Convert.ToString(ViewBag.jcoor) == "1")
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>

                            }
                            else
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>
                            }
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span class="d-none" id="spnType">@ViewBag.Type</span>
            <span class="d-none" id="spnStepCounter">@ViewBag.StepCounter</span>
            <span class="d-none" id="spnJCOOR">@ViewBag.jcoor</span>
            <span class="d-none" id="spnVBId">@(ViewBag.Id ?? 0)</span>
            <span class="d-none" id="spnClaim">@((claims.Count > 0 && claims.Any(i => i.Value == "Internal Wk Distr")) ? "Internal Wk Distr" : "")</span>
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        @ViewBag.Title
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row">
                <div class="col-xl-12">
                    @if (ViewBag.dataexport == 5 || ViewBag.dataexport == 4)
                    {
                        <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                            <h6 class="mb-3 mb-md-0">
                                @*   Total Units <span id="lblTotal" class="ml-3 border border-light b px-2 py-1">0</span> *@
                            </h6>
                            <div class="d-flex">
                                @if ((ViewBag.dataexport == 4 || ViewBag.dataexport == 5) && claims.Count > 0 && claims.Any(i => i.Value == "ICard Export Data"))
                                {
                                    <button type="button" id="btnDataExportsEncry" class="btn btn-warning font-weight-600 btn-sm mr-2">Data Exports with Encry</button>
                                    <button type="button" id="btnDataExports" class="btn btn-warning font-weight-600 btn-sm">Data Exports without Encry</button>
                                }
                            </div>

                        </div>
                    }
                    <div class="d-flex justify-content-end">
                        <button type="button" id="btnCSVDownload" class="btn btn-warning font-weight-600 btn-sm mb-2">CSV Download</button>
                        @if (ViewBag.StepCounter == 3 && claims.Count > 0 && claims.Any(i => i.Value == "Internal Wk Distr"))
                        {
                            <button type="button" id="btnInternalFwd" class="btn btn-warning font-weight-600 btn-sm mb-2 ml-2">Forward</button>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer dataTable table-hover" role="grid" id="tbldatatabledata_Fwd">
                        </table>
                    </div>
                </div>
            </div>
        </div><!-- Row End -->
    </div>
</div>

@section Scripts {
    <script asp-src-include="~/developerjs/ApprovalForIO_BasicDetails.js"></script>
    <script asp-src-include="~/developerjs/CheckedFunction.js"></script>
    <script asp-src-include="~/js/CustomScript.js"></script>
    <script asp-src-include="~/developerjs/fwdrecord.js"></script>
    <script asp-src-include="~/developerjs/ICardPrint.js"></script>
    <script asp-src-include="~/developerjs/token.js"></script>
    <script asp-src-include="~/developerjs/mtables.js"></script>
    <script asp-src-include="~/select2/js/select2.min.js"></script>

    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}