@{
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<link asp-href-include="~/css/popupprintcss.css" rel="stylesheet" />

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/approvalforio.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <div>
                            <span id="Isspnjcoor" class="d-none">@ViewBag.jcoor</span>
                            @if (Convert.ToString(ViewBag.jcoor) == "1")
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> &gt;
                                    <a href="/Home/Task" class="mr-2">Task</a> &gt;
                                    <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="mr-2">I-Card Status</a> &gt;
                                    @ViewBag.Title
                                </span>
                            }
                            else
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> &gt;
                                    <a href="/Home/Task" class="mr-2">Task</a> &gt;
                                    <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="mr-2">I-Card Status</a> &gt;
                                    @ViewBag.Title
                                </span>
                            }
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain mt-n10 ecms-approval-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-approval-shell ecms-card ecms-card-body">
        <div class="ecms-approval-header ecms-page-title">
            <div class="ecms-approval-title-wrap">
                <span class="ecms-approval-title-icon ecms-title-icon"><i class="fa fa-check-square"></i></span>
                <div>
                    <h3>@ViewBag.Title</h3>
                    <p class="ecms-title-subtitle">Review, verify and forward I-Card approval requests</p>
                </div>
            </div>
        </div>

        <span class="d-none" id="spnType">@ViewBag.Type</span>
        <span class="d-none" id="spnStepCounter">@ViewBag.StepCounter</span>
        <span class="d-none" id="spnJCOOR">@ViewBag.jcoor</span>
        <span class="d-none" id="spnClaim">@((claims.Count > 0 && claims.Any(i => i.Value == "Internal Wk Distr")) ? "Internal Wk Distr" : "")</span>

        @if (ViewBag.StepCounter == (int)ApplicationStepEnum.ApplicationStatusAtADC || ViewBag.StepCounter == (int)ApplicationStepEnum.Exported || (ViewBag.StepCounter == (int)ApplicationStepEnum.PendingApplicationVerifierLevel && ViewBag.Type == (int)ForwardStatusEnum.Pending && claims.Count > 0 && claims.Any(i => i.Value == "Internal Wk Distr")))
        {
            <div class="ecms-approval-actions ecms-section ecms-form-actions justify-content-end">
                @if (ViewBag.StepCounter == (int)ApplicationStepEnum.ApplicationStatusAtADC && claims.Count > 0 && claims.Any(i => i.Value == "ICard Export Data"))
                {
                    <button type="button" id="btnDataExportsEncry" class="btn btn-warning font-weight-600 btn-sm mr-2"><i class="fa fa-lock mr-1"></i> Data Exports with Encry</button>
                    <button type="button" id="btnDataExports" class="btn btn-warning font-weight-600 btn-sm"><i class="fa fa-unlock-alt mr-1"></i> Data Exports without Encry</button>
                }

                @if (ViewBag.StepCounter == (int)ApplicationStepEnum.PendingApplicationVerifierLevel && ViewBag.Type == (int)ForwardStatusEnum.Pending && claims.Count > 0 && claims.Any(i => i.Value == "Internal Wk Distr"))
                {
                    <button type="button" id="btnInternalFwd" class="btn btn-warning font-weight-600 btn-sm mb-2 ml-2"><i class="fa fa-share mr-1"></i> Forward</button>
                }
            </div>
        }

        <section class="ecms-approval-records ecms-section ecms-min-0">
            <h5 class="ecms-section-title">
                <i class="fa fa-table" aria-hidden="true"></i>
                <span>Application Records</span>
            </h5>

            <div class="ecms-approval-table-panel ecms-dt-wrap ecms-min-0">
                <table class="table table-striped table-hover border border-purple ecms-approval-table ecms-dt-table" role="grid" id="tbldatatabledata_Fwd"></table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script asp-src-include="~/developerjs/ApprovalForIO_BasicDetails.js"></script>
    <script asp-src-include="~/developerjs/CheckedFunction.js"></script>
    <script asp-src-include="~/js/CustomScript.js"></script>
    <script asp-src-include="~/developerjs/fwdrecord.js"></script>
    <script asp-src-include="~/developerjs/ICardPrint.js"></script>
    <script asp-src-include="~/developerjs/token.js"></script>
    <script asp-src-include="~/developerjs/mtables.js"></script>
    <script asp-src-include="~/select2/js/select2.min.js"></script>

    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}
