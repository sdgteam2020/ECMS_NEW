@inject IConfiguration configuration;
@{
    ViewData["Title"] = "List of Distributed Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link href="@($"{Cdn}/developercss/distributecard.css?v={Ver}")" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Task" class="mr-2">Task</a> > I-CARD DISTRIBUTION
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Details of Card Issuance
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="col-xl-12">
                <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                    <h6 class="mb-3 mb-md-0">
                        Total Card Issuance :<label class="font-weight-bold" id="lblTotal">0</label>
                    </h6>
                    <div class="d-flex"> 
                        <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-sm mr-2"><i class="fa fa-plus mr-1 font-weight-700" ></i>Add</button>
                    </div>
                </div>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/DistributeCard.js?v={Ver}")"></script>
<script src="@($"{Cdn}/developerjs/CheckedFunction.js?v={Ver}")"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />