@{
    ViewData["Title"] = "List of Distributed Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/distributecard.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> &gt;
                        <a href="/Home/Task" class="mr-2">Task</a> &gt;
                        I-Card Distribution
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain mt-n10 ecms-distributecard-page">
    <div class="ecms-distributecard-shell">
        <div class="ecms-distributecard-header">
            <div class="ecms-distributecard-title-wrap">
                <span class="ecms-distributecard-title-icon"><i class="fa fa-id-card"></i></span>
                <div>
                    <h3>Details of Card Issuance</h3>
                    <p>Track issued and distributed card records with remarks</p>
                </div>
            </div>

            <span id="SpnTxnId" class="d-none">0</span>

            <div class="ecms-distributecard-actions">
                <div class="ecms-total-pill">
                    <i class="fa fa-credit-card"></i>
                    <span>Total Card Issuance</span>
                    <strong id="lblTotal">0</strong>
                </div>

                <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-sm mr-2 ecms-add-btn">
                    <i class="fa fa-plus mr-1 font-weight-700"></i>Add
                </button>
            </div>
        </div>

        <div class="ecms-distributecard-table-panel">
            <table class="table table-striped table-hover border border-purple ecms-distributecard-table" role="grid" id="tbldata"></table>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/DistributeCard.js"></script>
<script asp-src-include="~/developerjs/CheckedFunction.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
