@{
    ViewData["Title"] = "Distribute Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/distributecardrequest.css" rel="stylesheet" />
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > CARD DISTRIBUTION
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-distributereq-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-distributereq-shell ecms-card ecms-card-body">

        <div class="ecms-distributereq-header ecms-page-title">
            <div class="ecms-distributereq-title-wrap">
                <span class="ecms-distributereq-title-icon ecms-title-icon">
                    <i class="fa fa-id-card"></i>
                </span>

                <div>
                    <h3>Card Distribution Request</h3>
                    <p class="ecms-title-subtitle">
                        Review card-holder details and confirm physical I-Card handover
                    </p>
                </div>
            </div>

            <span class="ecms-distributereq-armyno badge badge-success">
                <i class="fa fa-user-check"></i>
                Army No:
                <strong id="spnArmyNo"></strong>
            </span>
        </div>

        <form action=""
              id="SaveDistributeCardRequest"
              method="post"
              name="SaveDistributeCardRequest"
              class="ecms-distributereq-form">

            <span class="d-none" id="spnDistributeCardRequestId">0</span>

            <div class="ecms-distributereq-grid">

                <!-- Applicant / Card Details -->
                <section class="ecms-distributereq-applicant ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-user"></i>
                        Applicant &amp; Card Details
                    </h5>

                    <div class="ecms-distributereq-applicant-body ecms-min-0">
                        <div id="partialContainerBD"></div>
                    </div>

                    <div class="ecms-distributereq-applicant-actions ecms-form-actions"
                         id="basicDetailsButtons">

                        <button type="button"
                                class="btn btn-primary"
                                id="btnCardPreview"
                                name="btnCardPreview">
                            <i class="fa fa-eye mr-1"></i>
                            I-Card Preview
                        </button>

                        <button type="button"
                                class="btn btn-info"
                                id="btnApplMoveHistory"
                                name="btnApplMoveHistory">
                            <i class="fa fa-history mr-1"></i>
                            I-Card Move History
                        </button>

                        <button type="button"
                                class="btn btn-success"
                                id="btnDistributeCardsList"
                                name="btnDistributeCardsList">
                            <i class="fa fa-list mr-1"></i>
                            View Distributed Cards
                        </button>

                    </div>
                </section>


                <!-- Distribution Request -->
                <section class="ecms-distributereq-report ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-handshake"></i>
                        Report Card Distribution
                    </h5>

                    <div class="ecms-distributereq-report-body">

                        <div class="ecms-distributereq-control-row">
                            <label>
                                Date Of Distribution
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-distributereq-field-wrap">
                                <div class="ecms-distributereq-readonly">
                                    <i class="fa fa-clock mr-2"></i>
                                    <span id="txtDistributeoninp"
                                          name="txtDistributeoninp"></span>
                                </div>
                            </div>
                        </div>


                        <div class="ecms-distributereq-control-row ecms-distributereq-remarks-row">
                            <label for="txtDistributeRemark">
                                Remarks
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-distributereq-field-wrap">
                                <textarea class="form-control form-control1 textarea-auto-height"
                                          name="txtDistributeRemark"
                                          id="txtDistributeRemark"
                                          rows="4"
                                          maxlength="100"
                                          placeholder="Enter distribution remarks"
                                          data-val-maxlength="Maximum length of Message is 100 character."
                                          data-val-maxlength-max="100"
                                          data-val="true"
                                          data-val-regex="This special chars not allowed for security reasons."
                                          data-val-required="Remark is required."
                                          data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>

                                <span class="text-danger field-validation-valid"
                                      data-valmsg-for="txtDistributeRemark"
                                      data-valmsg-replace="true"></span>
                            </div>
                        </div>


                        <div class="ecms-distributereq-declaration">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="declarationCheckbox" />

                            <label class="form-check-label"
                                   for="declarationCheckbox">
                                I hereby declare that the details furnished above are true to the best of my knowledge.
                                I am fully aware of this declaration and hereby consent that the Smart I-Card has been
                                handed over to the individual.
                            </label>
                        </div>


                        <div class="ecms-distributereq-submit-row ecms-form-actions">
                            <input type="button"
                                   class="btn btn-success"
                                   id="btnSubmit"
                                   value="Submit"
                                   disabled />

                            <input type="button"
                                   class="btn btn-warning"
                                   id="btnReset"
                                   value="Reset" />
                        </div>

                    </div>
                </section>

            </div>
        </form>

    </div>
</div>

<script asp-src-include="~/select2/js/select2.min.js"></script>
<script asp-src-include="~/developerjs/DistributeCardRequest.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/ICardPrint.js"></script>