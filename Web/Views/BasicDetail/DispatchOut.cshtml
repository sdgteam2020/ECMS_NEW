@{
    ViewData["Title"] = "Dispatch Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var claimValue = ViewBag.ClaimValue;
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<link asp-href-include="~/developercss/dispatchout.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > Dispatch Card
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3">
        <div class="card-header">
            <div class="row">
                <div class="col-sm-12 text-left">
                    <h3>
                        Dispatch Card
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row g-3 row-deck mb-3">
                <form action="" enctype="multipart/form-data" id="SaveDispatchCard" method="post" name="SaveDispatchCard">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <span class=" d-none" id="spnClaimValue">@claimValue</span>
                        <span class=" d-none" id="spnField">@ViewBag.SearchField</span>
                        <span class=" d-none" id="spnSearchText">@ViewBag.SearchText</span>
                        <div class="col-sm-12 mx-auto">
                            <div class="row">
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Dispatch Date<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <div class="position-relative">
                                        <input type="text" id="txtDispatchDate" name="txtDispatchDate" class="form-control" autocomplete="off" required />@* datetimepickerpast *@
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtDispatchDate" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Mode of Dispatch<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <select class="form-select full-width"  id="ddlDispatch" name="ddlDispatch" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Mode of Dispatch is required." data-val-regex-pattern="^[\d]+$">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlDispatch" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Name of Courier Incharge<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input type="text" class="form-control full-width"  name="txtCourierIncharge" id="txtCourierIncharge" maxlength="50" placeholder="Name of Courier Incharge" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Name of Courier Incharge is required." data-val-regex-pattern="^[\w ]*$" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtCourierIncharge" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Ref of Dispatch<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input type="text" class="form-control full-width"  name="txtRefOfDispatch" id="txtRefOfDispatch" maxlength="50" placeholder="Ref of Dispatch" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Ref of Dispatch is required." data-val-regex-pattern="^[\w ]*$" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtRefOfDispatch" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Remark<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control1 textarea-auto-height" name="txtFromRemark" id="txtFromRemark" rows="3" maxlength="100" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="100" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Remark is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtFromRemark" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                @if (claimValue == 2)
                                {
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-5 labelprofile">ORO<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-7">
                                            <label class="form-control" id="lblRecordRegiment" readonly></label>
                                        </div>
                                    </div>
                                }
                                else if (claimValue == 3)
                                {
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-5 labelprofile">Regiment<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-7">
                                            <label class="form-control" id="lblRecordRegiment" readonly></label>
                                        </div>
                                    </div>
                                }
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Unit<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <label class="form-control" id="lblToUnitName" readonly></label>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Select DID<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <select class="form-select full-width"  id="ddlDID" name="ddlDID" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="DID is required." data-val-regex-pattern="^[\d]+$">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlDID" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Army No<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" placeholder="Army No" id="txtArmyNo" name="txtArmyNo" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Army No is required." data-val-regex-pattern="^[\w ]*$" readonly />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Rk & Offr Name<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" placeholder="Rk & Offr Name" id="txtRkName" name="txtRkName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Rk & Offr Name is required." data-val-regex-pattern="^[\w ]*$" readonly />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtRkName" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="col-sm-12 text-center mb-4">
                                    <input type="button" class="btn btn-primary" id="btnSubmit" value="Proceed" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/DispatchOut.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/select2/js/select2.min.js"></script>
