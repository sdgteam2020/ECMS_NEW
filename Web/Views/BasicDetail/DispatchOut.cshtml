@{
    ViewData["Title"] = "Dispatch Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<style>
    .containerMain {
        margin-left: 30%;
        margin-right: 30%;
    }

    .labelprofile {
        font-weight: 640 !important;
    }

    .modal.left .modal-dialog, .modal.right .modal-dialog {
        position: fixed;
        margin: auto;
        width: 700px;
        height: 100%;
        text-align: left;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }
</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > Dispatch Card
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3">
        <div class="card-header">
            <div class="row">
                <div class="col-sm-12 text-left">
                    <h3>
                        Dispatch Card
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row g-3 row-deck mb-3">
                <form action="" enctype="multipart/form-data" id="SaveDispatchCard" method="post" name="SaveDispatchCard">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <span class=" d-none" id="spnClaimValue">@ViewBag.ClaimValue</span>
                        <span class=" d-none" id="spnField">@ViewBag.SearchField</span>
                        <span class=" d-none" id="spnSearchText">@ViewBag.SearchText</span>
                        <span id="spnUnitMapId" class="d-none">0</span>
                        <div class="col-sm-12 mx-auto">
                            <div class="row">
                                <div id="DispatchOut_Categery" name="DispatchOut_Categery" class="form-group row mb-2 d-none">
                                    <label class="col-form-label col-sm-5 labelprofile">Select Categery<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <select class="form-select" style="width: 100%;" aria-hidden="true" id="ddlCategery" name="ddlCategery" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Categery is required." data-val-regex-pattern="^[\d]+$">
                                            <option value="">Select Categery</option>
                                            <option value="1">Offrs</option>
                                            <option value="2">JCOs/OR</option>
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlCategery" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Dispatch Date<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input type="text" id="txtDispatchDate" name="txtDispatchDate" class="form-control dateInput" required />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtDispatchDate" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Mode of Dispatch<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <select class="form-select" style="width: 100%;" aria-hidden="true" id="ddlDispatch" name="ddlDispatch" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Mode of Dispatch is required." data-val-regex-pattern="^[\d]+$">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlDispatch" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Name of Courier Incharge<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input type="text" class="form-control" style="width: 100%;" aria-hidden="true" name="txtCourierIncharge" id="txtCourierIncharge" maxlength="50" placeholder="Name of Courier Incharge" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Name of Courier Incharge is required." data-val-regex-pattern="^[\w ]*$" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtCourierIncharge" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Ref of Dispatch<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input type="text" class="form-control" style="width: 100%;" aria-hidden="true" name="txtRefOfDispatch" id="txtRefOfDispatch" maxlength="50" placeholder="Ref of Dispatch" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Ref of Dispatch is required." data-val-regex-pattern="^[\w ]*$" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtRefOfDispatch" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Remark<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control1" style="height:auto!important;" name="txtFromRemark" id="txtFromRemark" rows="3" maxlength="100" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="100" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Remark is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtFromRemark" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Select DID<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <select class="form-select" style="width: 100%;" aria-hidden="true" id="ddlDID" name="ddlDID" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="DID is required." data-val-regex-pattern="^[\d]+$">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlDID" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <span id="spnUserId" class="d-none">0</span>
                                    <label class="col-form-label col-sm-5 labelprofile">Army No<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" placeholder="Army No" id="txtArmyNo" name="txtArmyNo" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Army No is required." data-val-regex-pattern="^[\w ]*$" readonly />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-5 labelprofile">Rk & Offr Name<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" placeholder="Rk & Offr Name" id="txtRkName" name="txtRkName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Rk & Offr Name is required." data-val-regex-pattern="^[\w ]*$" readonly />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtRkName" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="col-sm-12 text-center mb-4">
                                    <input type="button" class="btn btn-primary" id="btnSubmit" value="Proceed" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/DispatchOut.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/select2/js/select2.min.js"></script>
