@{
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/css/popupprintcss.css" rel="stylesheet" />
<style>
    .modal.left .modal-dialog, .modal.right .modal-dialog {
        position: fixed;
        margin: auto;
        width: 700px;
        height: 100%;
        text-align: left;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }
</style>
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/InitiateRequest" class="mr-2">Request</a> ><a href="/Home/Request">Initiate Request</a> > Appl Flagged due to Disciplinary Action
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        ICard Request Hold Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row">
                <span id="spnFlagICardAppl" class="d-none">@(claims.Count > 0 && claims.Any(i => i.Value == "Flag ICard Appl") ? "Flag ICard Appl" : "")</span>
                <div class="col-xl-12">
                    <div class="mb-2 d-flex justify-content-end">
                        @if (claims.Count > 0 && claims.Any(i => i.Value == "Flag ICard Appl"))
                        {
                            <div>
                                <button type="button" id="btnRequestHoldAdd" class="btn btn-outline-success font-weight-600 btn-sm">Add More</button>
                            </div>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer dataTable table-hover" role="grid" id="tbldata">
                        </table>
                    </div>
                </div>
            </div>
        </div><!-- Row End -->
    </div>
</div>

@section Scripts {
    <script asp-src-include="~/developerjs/fwdrecord.js"></script>
    <script asp-src-include="~/developerjs/ICardPrint.js"></script>
    <script asp-src-include="~/developerjs/ICardRequestHold.js"></script>
    <script asp-src-include="~/select2/js/select2.min.js"></script>

    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}
<div class="modal fade" id="AddICardRequestHold" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">ICard Request Hold</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body model-body-background">
                <div class="row">
                    <form action="" id="SaveICardRequestHold" name="SaveICardRequestHold" method="post">
                        <div class="row">
                            <span class=" d-none" id="spnICardHoldId">0</span>
                            <span class=" d-none" id="spnRequestId">0</span>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Army No<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Enter Army No" id="txtArmyNo" name="txtArmyNo" minlength="8" maxlength="9" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Army No is required." data-val-regex-pattern="^[\w]+$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtArmyNo" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Rank</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblRank"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblName"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Name</label>
                                <div class="col-sm-8">
                                    <label class="col-form-label unit-label-background" id="lblUnitName"></label>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Is Hold<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="IsHold" value="true" id="IsHoldYes" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                        <label class="form-check-label" for="IsHoldYes">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="IsHold" value="false" id="IsHoldNo" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[a-zA-Z]*$">
                                        <label class="form-check-label" for="IsHoldNo">
                                            No
                                        </label>
                                    </div>
                                    <span class="text-danger field-validation-valid" id="IsHold-error" data-valmsg-for="IsHold" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Reason for Hold<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1" style="height:auto!important;" name="txtHoldReason" id="txtHoldReason" rows="3" maxlength="50" data-val-maxlength="Maximum length of Reason for Hold is 50 character." data-val-maxlength-max="50" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Reason for Hold is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtHoldReason" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2 d-none" id="gpUnHoldReason">
                                <label class="col-form-label col-sm-4 fw-bold">Reason for UnHold<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1" style="height:auto!important;" name="txtUnHoldReason" id="txtUnHoldReason" rows="3" maxlength="50" data-val-maxlength="Maximum length of Reason for Hold is 50 character." data-val-maxlength-max="50" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Reason for UnHold is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnHoldReason" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnAddICardRequestHold" />
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>
                    <div class="col-sm-12" id="msg">
                    </div>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>