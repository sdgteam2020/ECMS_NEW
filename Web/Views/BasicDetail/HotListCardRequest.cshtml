@{
    ViewData["Title"] = "HotList Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/hotlistcardrequest.css" rel="stylesheet" />
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > HOT LISTING
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-hotlistreq-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-hotlistreq-shell ecms-card ecms-card-body">

        <div class="ecms-hotlistreq-header ecms-page-title">
            <div class="ecms-hotlistreq-title-wrap">
                <span class="ecms-hotlistreq-title-icon ecms-title-icon">
                    <i class="fa fa-ban"></i>
                </span>

                <div>
                    <h3>Hotlist Card Request</h3>
                    <p class="ecms-title-subtitle">
                        Review card-holder details and submit the hot-listing request
                    </p>
                </div>
            </div>

            <span class="ecms-hotlistreq-armyno badge badge-warning">
                <i class="fa fa-id-card"></i>
                Army No:
                <strong id="spnArmyNo"></strong>
            </span>
        </div>

        <form action=""
              id="SaveHotlistCardRequest"
              method="post"
              name="SaveHotlistCardRequest"
              class="ecms-hotlistreq-form">

            <div class="ecms-hotlistreq-grid">

                <!-- Applicant / Card Details -->
                <section class="ecms-hotlistreq-applicant ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-user"></i>
                        Applicant &amp; Card Details
                    </h5>

                    <div class="ecms-hotlistreq-applicant-body ecms-min-0">
                        <div id="partialContainerBD"></div>
                    </div>

                    <div class="ecms-hotlistreq-applicant-actions ecms-form-actions">

                        <button type="button"
                                class="btn btn-info"
                                id="btnApplMoveHistory"
                                name="btnApplMoveHistory">
                            <i class="fa fa-history mr-1"></i>
                            I-Card Move History
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="btnCardPreview"
                                name="btnCardPreview">
                            <i class="fa fa-eye mr-1"></i>
                            I-Card Preview
                        </button>

                    </div>
                </section>


                <!-- Hot Listing Request -->
                <section class="ecms-hotlistreq-report ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-ban"></i>
                        Report Hotlist Card
                    </h5>

                    <div class="ecms-hotlistreq-report-body">

                        <!-- Preserved hidden Stage field -->
                        <div class="ecms-hotlistreq-control-row Stage d-none">
                            <label for="ddlStage">
                                Stage
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-hotlistreq-field-wrap">
                                <select class="form-select full-width"
                                        id="ddlStage"
                                        name="ddlStage"
                                        data-val="true"
                                        data-val-regex="This special chars not allowed for security reasons."
                                        data-val-required="Stage is required."
                                        data-val-regex-pattern="^[\d]+$">
                                    <option value="">Select One</option>
                                </select>

                                <span class="text-danger field-validation-valid"
                                      data-valmsg-for="ddlStage"
                                      data-valmsg-replace="true"></span>
                            </div>
                        </div>


                        <!-- Reason -->
                        <div class="ecms-hotlistreq-control-row">
                            <label for="ddlHotlistRemark">
                                Select Reason
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-hotlistreq-field-wrap">
                                <select class="form-control select2 select2-accessible text-uppercase full-width"
                                        multiple
                                        tabindex="-1"
                                        name="ddlHotlistRemark"
                                        id="ddlHotlistRemark"
                                        data-val="true"
                                        data-val-regex="This special chars and space not allowed for security reasons."
                                        data-val-required="Hotlist Reason is required.">
                                </select>

                                <span class="text-danger field-validation-valid"
                                      data-valmsg-for="ddlHotlistRemark"
                                      data-valmsg-replace="true"></span>
                            </div>
                        </div>


                        <!-- Remarks -->
                        <div class="ecms-hotlistreq-control-row ecms-hotlistreq-remarks-row">
                            <label for="txtHotlistRemark">
                                Remarks
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-hotlistreq-field-wrap">
                                <textarea class="form-control form-control1 textarea-auto-height"
                                          name="txtHotlistRemark"
                                          id="txtHotlistRemark"
                                          rows="4"
                                          maxlength="100"
                                          placeholder="Enter remarks"
                                          data-val-maxlength="Maximum length of Message is 100 character."
                                          data-val-maxlength-max="100"
                                          data-val="true"
                                          data-val-regex="This special chars not allowed for security reasons."
                                          data-val-required="Remark is required."
                                          data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>

                                <span class="text-danger field-validation-valid"
                                      data-valmsg-for="txtHotlistRemark"
                                      data-valmsg-replace="true"></span>
                            </div>
                        </div>


                        <div class="ecms-hotlistreq-submit-row ecms-form-actions">
                            <input type="button"
                                   class="btn btn-primary"
                                   id="btnAccept"
                                   value="Submit" />
                        </div>

                    </div>
                </section>

            </div>
        </form>

    </div>
</div>

<script asp-src-include="~/select2/js/select2.min.js"></script>
<script asp-src-include="~/developerjs/HotListCardRequest.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/ICardPrint.js"></script>