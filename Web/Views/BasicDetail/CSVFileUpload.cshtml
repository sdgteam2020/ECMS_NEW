@model DTOCSVFileRequest
@{
    ViewData["Title"] = "CSV File Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/csvfileupload.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>

                        <div>
                            <span id="Isspnjcoor" class="d-none">@ViewBag.jcoor</span>
                            @if (Convert.ToString(ViewBag.jcoor) == "1")
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>

                            }
                            else
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>
                            }


                        </div>


                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-csvupload-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-csvupload-shell ecms-card ecms-card-body">

        <div class="ecms-csvupload-header ecms-page-title">
            <div class="ecms-csvupload-title-wrap">
                <span class="ecms-csvupload-title-icon ecms-title-icon">
                    <i class="fa fa-file-csv"></i>
                </span>
                <div>
                    <h3>CSV File Import</h3>
                    <p class="ecms-title-subtitle">
                        Upload, validate and process I-Card CSV files with import history
                    </p>
                </div>
            </div>

        </div>

        <section class="ecms-csvupload-upload-section ecms-section">
            <h5 class="ecms-section-title">
                <i class="fa fa-cloud-upload-alt"></i>
                Upload CSV File
            </h5>

            <form enctype="multipart/form-data"
                  action=""
                  id="csvUploadForm"
                  name="csvUploadForm"
                  method="post"
                  class="ecms-csvupload-form">

                <div class="ecms-csvupload-form-row">
                    <div class="ecms-csvupload-label-wrap">
                        <label for="CSVFile">
                            Select CSV File
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <span class="ecms-csvupload-help">
                            Maximum file size: 5 MB
                        </span>
                    </div>

                    <div class="ecms-csvupload-input-wrap">
                        <input asp-for="CSVFile"
                               class="form-control alpha-num-only ecms-csvupload-file-input"
                               accept=".csv,text/csv" />

                        <button type="button"
                                class="btn btn-primary ecms-csvupload-submit"
                                id="btnsave">
                            <i class="fa fa-upload mr-1"></i>
                            Submit
                        </button>
                    </div>

                    <div class="ecms-csvupload-validation">
                        <span id="lblCSVFile" class="text-red"></span>
                        <span asp-validation-for="CSVFile" class="text-danger"></span>
                        <span id="lblCSVFileNotification" class="text-danger">
                            File Upload Upto 5MB
                        </span>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </div>
                </div>
            </form>
        </section>

        <section class="ecms-csvupload-records ecms-section ecms-min-0">
            <h5 class="ecms-section-title">
                <i class="fa fa-history"></i>
                CSV Upload History
            </h5>

            <div class="ecms-csvupload-table-panel ecms-dt-wrap ecms-min-0">
                <table class="table table-striped table-hover border border-purple ecms-dt-table"
                       role="grid"
                       id="tblData">
                </table>
            </div>
        </section>

    </div>
</div>

<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<script asp-src-include="~/developerjs/CSVFileUpload.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />