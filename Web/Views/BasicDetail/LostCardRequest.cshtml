@{
    ViewData["Title"] = "Lost Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .containerMain {
        margin-left: 10%;
        margin-right: 10%;
    }
/*     .faulty {
        background-color: #044C92;
        text-align: center;
        padding: 0.5rem !important;
        margin-right: 0.25rem !important;
        border: hidden;
        font-weight: 400 !important;
        color: #fff !important;
        width: 170px;
        height: 60px;
    }
 */
    .modal.left .modal-dialog, .modal.right .modal-dialog {
        position: fixed;
        margin: auto;
        width: 700px;
        height: 100%;
        text-align: left;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }
</style>
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > REPORT LOSS OF AFSAC
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Lost Card Request Indl Army No
                        <small class="text-muted"><span id="spnArmyNo"></span></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row g-3 row-deck mb-3">
                <form action="" id="SaveLostCardRequest" method="post" name="SaveLostCardRequest">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        @* <span class=" d-none" id="spnTrnLostCardId">@ViewBag.TrnFaultyCardId</span> *@
                        <span class=" d-none" id="spnLostCardRequestId">0</span>
                        <span class=" d-none" id="spnMaxTrnFwdId">0</span>
                        @* <span class=" d-none" id="spnClaimValue">@ViewBag.Claim</span> *@
                        <div class="col-sm-7">
                            <div class="card p-1">
                                <div id="partialContainerBD" class="mb-2">
                                </div>
                               <div class="card p-2">
                                    <div class="text-center">
                                        <button type="button" class="btn btn-success" id="btnXMLDownload" name="btnXMLDownload">XML Download</button>
                                        <button type="button" class="btn btn-info" id="btnApplMoveHistory" name="btnApplMoveHistory">I-Card Move History</button>
                                        <button type="button" class="btn btn-primary" id="btnCardPreview" name="btnCardPreview">I-Card Preview</button>
                                        <button type="button" class="btn btn-warning" id="btnLostCardsList" name="btnLostCardsList">View Lost Cards</button>
                                    </div>
                               </div>
                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="card p-3">
                                <div class="feature-box3 mb-3">
                                    <div class="top-block_ind d-flex">
                                        <div class="text-block">
                                            <h5 class="mb-1 text-font2 fw-bold">Report Lost Card</h5>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reason of Loss -->
                                <div class="mb-3 row">
                                    <label class="col-sm-5 col-form-label labelprofile">
                                        Reason of Loss <i class="fas fa-asterisk mand1"></i>
                                    </label>
                                    <div class="col-sm-7">
                                        <select class="form-control select2 text-uppercase" multiple name="ddlLostRemark" id="ddlLostRemark"
                                                data-val="true" data-val-regex="This special chars and space not allowed for security reasons."
                                                data-val-required="Reason of Loss is required.">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlLostRemark"
                                              data-valmsg-replace="true"></span>
                                    </div>
                                </div>

                                <!-- Date Of Loss -->
                                <div class="mb-3 row">
                                    <label class="col-sm-5 col-form-label labelprofile">
                                        Date Of Loss <i class="fas fa-asterisk mand1"></i>
                                    </label>
                                    <div class="col-sm-7">
                                        <input type="text" id="txtlostoninp" class="form-control datetimepickerpast"
                                               name="txtlostoninp" autocomplete="off" data-val="true"
                                               data-val-required="Date Of Loss is required.">
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtlostoninp"
                                              data-valmsg-replace="true"></span>
                                    </div>
                                </div>

                                <!-- FIR Lodged -->
                                <div class="mb-3 row">
                                    <label class="col-sm-5 col-form-label labelprofile">
                                        Have Indl Lodged FIR in Police Stn? <i class="fas fa-asterisk mand1"></i>
                                    </label>
                                    <div class="col-sm-7">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="isFIRLogged" id="isFIRLoggedYes"
                                                   value="true" data-val="true" data-val-required="This field is required.">
                                            <label class="form-check-label" for="isFIRLoggedYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="isFIRLogged" id="isFIRLoggedNo"
                                                   value="false" data-val="true" data-val-required="This field is required.">
                                            <label class="form-check-label" for="isFIRLoggedNo">No</label>
                                        </div>
                                        <span class="text-danger d-block mt-1 field-validation-valid"
                                              data-valmsg-for="isFIRLogged" data-valmsg-replace="true"></span>
                                    </div>
                                </div>

                                <!-- Upload FIR -->
                                <div class="mb-3 row">
                                    <label class="col-sm-5 col-form-label labelprofile">
                                        Upload FIR Report / Court of Inquiry Document (PDF)
                                    </label>
                                    <div class="col-sm-7">
                                        <input class="form-control" accept="application/pdf" type="file" id="supportingDoc"
                                               name="supportingDoc" data-val="true">
                                        <small id="lblCSVFileNotification" class="text-danger">File Upload Upto 5MB</small>
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="mb-3 row">
                                    <label class="col-sm-5 col-form-label labelprofile">
                                        Remarks <i class="fas fa-asterisk mand1"></i>
                                    </label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" name="txtLostRemark" id="txtLostRemark"
                                                  rows="3" maxlength="100"
                                                  data-val="true"
                                                  data-val-maxlength="Maximum length of Message is 100 character."
                                                  data-val-maxlength-max="100"
                                                  data-val-regex="This special chars not allowed for security reasons."
                                                  data-val-regex-pattern="^[\w\&\.\-\; ]*$"
                                                  data-val-required="Remark is required."></textarea>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtLostRemark"
                                              data-valmsg-replace="true"></span>
                                    </div>
                                </div>

                                <!-- Buttons -->
                                <div class="d-flex justify-content-center gap-3 mb-2">
                                    <button type="button" class="btn btn-primary" id="btnSubmit">Submit</button>
                                    <button type="button" class="btn btn-warning" id="btnReset">Reset</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/select2/js/select2.min.js"></script> 
<script asp-src-include="~/developerjs/LostCardRequest.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/ICardPrint.js"></script>