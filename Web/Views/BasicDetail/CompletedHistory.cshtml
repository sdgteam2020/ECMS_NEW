<link asp-href-include="~/css/popupprintcss.css" rel="stylesheet" />

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/CompletedHistory.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>

                        <div>
                            @if (Convert.ToInt16(ViewBag.ApplyForId) == 1)
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>

                            }
                            else
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>
                            }
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-completedhistory-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-completedhistory-shell ecms-card ecms-card-body">

        <span class="d-none" id="spnUserType">@ViewBag.UserType</span>
        <span class="d-none" id="spnApplyForId">@ViewBag.ApplyForId</span>

        <div class="ecms-completedhistory-header ecms-page-title">
            <div class="ecms-completedhistory-title-wrap">
                <span class="ecms-completedhistory-title-icon ecms-title-icon">
                    <i class="fa fa-check-circle"></i>
                </span>

                <div>
                    <h3>@ViewBag.Title</h3>
                    <p class="ecms-title-subtitle">
                        Review completed I-Card applications, history and downloadable records
                    </p>
                </div>
            </div>
        </div>

        <div class="ecms-completedhistory-records ecms-section ecms-min-0">
            <h5 class="ecms-section-title">
                <i class="fa fa-history"></i>
                Completed Application Records
            </h5>

            <div class="ecms-completedhistory-table-panel ecms-dt-wrap ecms-min-0">
                <table class="table table-striped table-hover border border-purple ecms-dt-table"
                       role="grid"
                       id="tbldatatabledata_Completed">
                </table>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script asp-src-include="~/developerjs/CompletedHistory.js"></script>
    <script asp-src-include="~/developerjs/helper_CompletedHistory.js"></script>
    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}