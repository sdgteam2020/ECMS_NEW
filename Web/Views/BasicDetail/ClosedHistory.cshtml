@{
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<link asp-href-include="~/css/popupprintcss.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/ClosedHistory.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>

                        <div>
                            <span id="Isspnjcoor" class="d-none">@ViewBag.jcoor</span>
                            @if (Convert.ToString(ViewBag.jcoor) == "1")
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>

                            }
                            else
                            {
                                <span>
                                    <a href="/Home/Index" class="mr-2">Home</a> >
                                    <a href="/Home/Task" class="mr-2">Task</a> >
                                    <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="mr-2">I-Card Status</a>  >
                                    @ViewBag.Title
                                </span>
                            }
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-closedhistory-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-closedhistory-shell ecms-card ecms-card-body">

        <span class="d-none" id="spnType">@ViewBag.UserType</span>
        <span class="d-none" id="spnJCOOR">@ViewBag.ApplyForId</span>

        <div class="ecms-closedhistory-header ecms-page-title">
            <div class="ecms-closedhistory-title-wrap">
                <span class="ecms-closedhistory-title-icon ecms-title-icon">
                    <i class="fa fa-archive"></i>
                </span>

                <div>
                    <h3>@ViewBag.Title</h3>
                    <p class="ecms-title-subtitle">
                        Review closed I-Card applications, closure details and complete history
                    </p>
                </div>
            </div>

            <span class="ecms-closedhistory-status badge badge-secondary">
                <i class="fa fa-lock"></i>
                Closed
            </span>
        </div>

        <div class="ecms-closedhistory-records ecms-section ecms-min-0">
            <h5 class="ecms-section-title">
                <i class="fa fa-history"></i>
                Closed Application Records
            </h5>

            <div class="ecms-closedhistory-table-panel ecms-dt-wrap ecms-min-0">
                <table class="table table-striped table-hover border border-purple ecms-dt-table"
                       role="grid"
                       id="tbldatatabledata_ClosedHistory">
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script asp-src-include="~/developerjs/ClosedHistoryDetails.js"></script>
    <script asp-src-include="~/developerjs/helper_ClosedHistoryDetails.js"></script>

    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
}