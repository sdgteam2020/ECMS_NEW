@{
    ViewData["Title"] = "List of Destruction Card Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/destructioncard.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> &gt;
                        <a href="/Home/Task" class="mr-2">Task</a> &gt;
                        I-Card Destruction
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain mt-n10 ecms-destructioncard-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-destructioncard-shell ecms-card ecms-card-body">

        <div class="ecms-destructioncard-header ecms-page-title">
            <div class="ecms-destructioncard-title-wrap">
                <span class="ecms-destructioncard-title-icon ecms-title-icon">
                    <i class="fa fa-trash"></i>
                </span>

                <div>
                    <h3>Details of I-Card Destruction</h3>
                    <p class="ecms-title-subtitle">
                        Track destructed card records, reasons and remarks
                    </p>
                </div>
            </div>

            <div class="ecms-destructioncard-actions">
                <div class="ecms-total-pill">
                    <i class="fa fa-trash"></i>
                    <span>Total Card Destruction</span>
                    <strong id="lblTotal">0</strong>
                </div>

                <button type="button"
                        id="btnAdd"
                        class="btn btn-success btn-sm font-weight-600 ecms-add-btn">
                    <i class="fa fa-plus mr-1 font-weight-700"></i>Add
                </button>
            </div>
        </div>

        <div class="ecms-destructioncard-records ecms-section ecms-min-0">
            <h5 class="ecms-section-title">
                <i class="fa fa-trash"></i>
                Card Destruction Records
            </h5>

            <div class="ecms-destructioncard-table-panel ecms-dt-wrap ecms-min-0">
                <table class="table table-striped table-hover border border-purple ecms-destructioncard-table ecms-dt-table"
                       role="grid"
                       id="tbldata"></table>
            </div>
        </div>

    </div>
</div>

<script asp-src-include="~/developerjs/DestructionCard.js"></script>
<script asp-src-include="~/developerjs/CheckedFunction.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
