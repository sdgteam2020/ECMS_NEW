@{
    ViewBag.Title = "Appl Status";
    ViewBag.Description = "Appl Status";
    ViewBag.Keywords = "";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<link asp-href-include="~/developercss/appstatus.css" rel="stylesheet" />

<div class="page ecms-appstatus-page">
    <div class="ecms-appstatus-overlay"></div>

    <div class="ecms-appstatus-shell">
        <div class="print">
            <div class="ecms-appstatus-card">

                <div class="yes-print text-center ecms-print-title">
                    <h1 class="text-center">AFSC</h1>
                    <h3 class="text-center">I-Card Tracking Details</h3>
                </div>

                <div class="ecms-appstatus-card-header no-print">
                    <div class="ecms-appstatus-badge">
                        <i class="fa fa-search"></i>
                    </div>
                    <div>
                        <h1>Track Application Status</h1>
                        <p>Enter your application ID to view I-Card details and movement history.</p>
                    </div>
                </div>

                <div class="ecms-appstatus-card-body" id="section-to-print-app-status">
                    <div class="card-sigin no-print ecms-tracking-panel">
                        <div class="main-signup-header login-form">
                            <label class="ecms-track-label" for="ApplId">Application ID</label>
                            <div class="ecms-track-control">
                                <span class="ecms-track-icon">
                                    <i class="fa fa-id-card"></i>
                                </span>
                                <input type="text"
                                       class="form-control ecms-track-input"
                                       placeholder="Enter Appl Id"
                                       required
                                       maxlength="12"
                                       name="ApplId"
                                       id="ApplId" />
                                <input type="button"
                                       id="btnTracking"
                                       class="btn btn-primary text-uppercase ecms-track-btn"
                                       value="Track" />
                            </div>
                        </div>
                    </div>

                    <div class="ipaddress d-none">@ViewBag.IP</div>

                    <div class="row ecms-status-result-row">
                        <div class="col-md-12 mb-3 mt-3 text-center d-print-none ApplIdDetails d-none">
                            <div class="ecms-result-note">
                                <i class="fa fa-check-circle"></i>
                                Application details found. Review the applicant card and movement history below.
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 ApplIdDetails d-none">
                            <div class="card divicardbg minheight ecms-id-preview-card">
                                <div class="ecms-id-card-ribbon">Applicant Details</div>

                                <div class="row p-4">
                                    <div class="col-sm-12">
                                        <div id="hindiheading" class="ecms-id-heading">
                                            <p class="f19 font-weight-600">
                                                भारतीय सशस्त्र सेनाएँ पहचान कार्ड
                                                <span class="float-end">(IAFZ-2015)</span>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="col-sm-12">
                                        <div class="d-flex f19 font-weight-800 ecms-id-english-title">
                                            INDIAN ARMED FORCES IDENTITY CARD
                                        </div>
                                    </div>

                                    <div class="col-sm-5 mt-4 text-center">
                                        <div class="ecms-photo-frame">
                                            <img class="PhotoImagePath" onerror="this.src='/Images/user4.png'" height="200" width="200" />
                                        </div>
                                    </div>

                                    <div class="col-sm-7 mt-4">
                                        <div class="ecms-applicant-info">
                                            <div class="fw-bold text-uppercase FName"></div>
                                            <div class="fw-bold text-uppercase LName"></div>
                                            <div class="fw-bold text-uppercase RankName"></div>
                                            <div class="fw-bold text-uppercase ArmedName"></div>
                                            <div class="fw-bold text-uppercase ServiceNo"></div>
                                            <div class="fw-bold mt-3" id="identification-mark">IDENTIFICATION MARK</div>
                                            <div class="font-weight-500 text-uppercase IdenMark1"></div>
                                        </div>
                                    </div>

                                    <div class="col-sm-12 mt-3">
                                        <p class="font-weight-500 f16 ecms-ministry-text">
                                            रक्षा मंत्रालय, भारत सरकार MINISTRY OF DEFENCE, GOVERNMENT OF INDIA
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12 ApplIdDetails d-none">
                            <div class="card divicardbg minheight ecms-id-preview-card">
                                <div class="ecms-id-card-ribbon">Issue Details</div>

                                <div class="row p-4">
                                    <div class="col-sm-3 justify-content-center text-center">
                                        <div class="mt-2 mb-3">
                                            <img src="~/writereaddata/images/indian-army-logo.jpg" height="60" width="50" />
                                        </div>
                                        <div class="mt-3 mb-3">
                                            <img class="PhotoImagePath" onerror="this.src='/Images/Signature.png'" height="60" width="50" />
                                        </div>
                                        <div class="mt-3 mb-3">
                                            <img src="~/images/asset/hologrambg.png" height="60" width="50" />
                                        </div>
                                    </div>

                                    <div class="col-sm-4">
                                        <div class="ecms-detail-list">
                                            <div>
                                                <span>DATE OF BIRTH</span>
                                                <strong class="DOB"></strong>
                                            </div>
                                            <div>
                                                <span>HEIGHT</span>
                                                <strong class="Height"></strong>
                                            </div>
                                            <div>
                                                <span>AADHAAR No</span>
                                                <strong class="AadhaarNo">XXXXXXXX</strong>
                                            </div>
                                            <div>
                                                <span>BLOOD GROUP</span>
                                                <strong class="BloodGroup"></strong>
                                            </div>
                                            <div>
                                                <span>PLACE & DATE OF ISSUE</span>
                                                <strong class="text-uppercase PlaceOfIssue"></strong>
                                                <strong class="DateOfIssue"></strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-5">
                                        <div class="ecms-card-instructions">
                                            <p>
                                                भारत सरकार की सम्पति। अहस्तान्तरणीय। गुम हो जाने पर निकटतम थाने और अपनी यूनिट को रिपोर्ट करें। सेवा की समाप्ति पर ओ.सी. यूनिट को लौटा दें।
                                            </p>
                                            <p>
                                                PROPERTY OF GOVERNMENT OF INDIA NOT TRANSFERABLE. REPORT LOSS IMMEDIATELY TO NEAREST POLICE STATION AND YOUR UNIT. RETURN TO OC UNIT ON CESSATION OF SERVICE.
                                            </p>
                                            <p>
                                                पाने वाला इसे सेना/नौसेना/वायु सेना मुख्यालय, नई दिल्ली 110011 को बिना टिकट लगाए, पत्र पेटी में डाल दे या पास के सैनिक यूनिट या थाने में जमा करा दे।
                                            </p>
                                            <p>
                                                FINDERS TO DROP THIS LETTER BOX POSTAGE FREE TO ARMY/NAVAL/AIR HEAD QUARTERS, NEW DELHI 110011 OR HANDOVER TO THE NEAREST MILITARY UNIT OR POLICE STATION.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="col-sm-3 mt-3">
                                        <span class="font-weight-800 border border-dark p-2 ecms-id-number">1545485</span>
                                    </div>

                                    <div class="col-sm-4 mt-3">
                                        <span class="font-weight-800 border border-dark p-2 ecms-signature-label">SIGNATURE</span>
                                    </div>

                                    <div id="divimgpath" class="col-sm-5 text-center mt-3 p-2 border border-dark ecms-signature-box">
                                        <span class="p-2">
                                            <img class="SignaturePath" height="30" width="80" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3 ApplIdHistory d-none page-break-before ecms-history-card">
                        <div class="card-body">
                            <div class="ecms-history-header">
                                <h5>
                                    <i class="fa fa-stream"></i>
                                    ApplId History
                                </h5>
                                <button type="button" class="btn ecms-print-btn d-print-none" id="btn-printtracking">
                                    <i class="fa fa-print"></i>
                                    Print
                                </button>
                            </div>

                            <div class="timeline timeline-xs ecms-tracking-timeline" id="RequestHistoryTrackingId">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-src-include="~/developerjs/keyconstants.js"></script>
    <script asp-src-include="~/developerjs/commanvalidation.js"></script>
    <script asp-src-include="~/developerjs/appstatus.js"></script>
}
