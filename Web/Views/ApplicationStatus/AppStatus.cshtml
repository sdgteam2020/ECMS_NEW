@{
    ViewBag.Title = "Appl Status";
    ViewBag.Description = "Appl Status";
    ViewBag.Keywords = "";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<link asp-href-include="~/developercss/appstatus.css" rel="stylesheet" />
<div class="page">
    <div class="container-fluid">
        <partial name="~/Views/Shared/_CommonHeader.cshtml" />
        <div class="print">
            <div class="bg-white login-wrap align-items-center">
                <div class="row">
                    <div class="col-md-12">
                        <table class="col-md-12">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="yes-print text-center">
                                            <h1 class="text-center">AFSC</h1>
                                            <h3 class="text-center">I-Card Tracking Details</h3>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="card py-2 py-sm-4">
                                            <div class="row card-body" id="section-to-print-app-status">
                                                <div class="col-md-12">
                                                    <div class="card-sigin no-print">
                                                        <div class="main-signup-header login-form">
                                                            <p class="font-weight-bold font-weight-700 text-center mb-4 mt-1"><h4>Enter Appl Id.</h4></p>
                                                            <input type="text" class="form-control" placeholder="Enter Appl Id" required maxlength="12" name="ApplId" id="ApplId" />
                                                            <input type="button" id="btnTracking" class="btn btn-primary text-uppercase py-2 fs-5 w-100 mt-2" value="Track" />

                                                        </div>
                                                    </div>
                                                    <div class="ipaddress d-none">@ViewBag.IP</div>
                                                    @* <div class="watermark yes-print">@ViewBag.IP</div> *@
                                                    <div class="">
                                                        <div class="row">
                                                            <div class="col-md-12 mb-4 mt-4 text-center d-print-none ApplIdDetails d-none">
                                                                <button class="btn btn-primary" id="btn-printtracking">Print</button>
                                                            </div>
                                                            <div class="col-md-12 ApplIdDetails d-none">
                                                                <div class="card divicardbg minheight">
                                                                    @*   <img class="imgicardbg" src="~/images/asset/icardbg.jpg" /> *@
                                                                    <div class="row p-4">
                                                                        <div class="col-sm-12">
                                                                            <div style="line-height:0 !important">
                                                                                <p style="text-align:left;" class="f19 font-weight-600">
                                                                                    भारतीय सशस्त्र सेनाएँ पहचान कार्ड
                                                                                    <span style="float:right;">(IAFZ-2015)</span>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-sm-12">
                                                                            <div class="d-flex f19 font-weight-800"> INDIAN ARMED FORCES INDENTITY CARD</div>
                                                                        </div>
                                                                        <div class="col-sm-6 mt-4">
                                                                            <img class="PhotoImagePath" onerror="this.src='/Images/user4.png'" height="200" width="200" />
                                                                        </div>
                                                                        <div class="col-sm-6 mt-4">
                                                                            <div class="fw-bold text-uppercase FName"></div>
                                                                            <div class="fw-bold text-uppercase LName"></div>
                                                                            <div class="fw-bold text-uppercase RankName"></div>
                                                                            <div class="fw-bold text-uppercase ArmedName"></div>
                                                                            <div class="fw-bold text-uppercase ServiceNo"></div>
                                                                            <div class="fw-bold" style="line-height:1">IDENTIFICATION MARK</div>
                                                                            <div class="font-weight-500 text-uppercase IdenMark1"></div>
                                                                        </div>
                                                                        <div class="col-sm-12">
                                                                            <p class="font-weight-500 f16">रक्षा मंत्रालय, भारत सरकार MINISTRY OF DEFENCE, GOVERNMENT OF INDIA</p>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-12 ApplIdDetails d-none mt-2">
                                                                <div class="card divicardbg minheight">
                                                                    @*   <img class="imgicardbg" src="~/images/asset/icardbg1.jpg" /> *@
                                                                    <div class="row p-4">
                                                                        <div class="col-sm-2 justify-content-center">
                                                                            <div class="mt-4 ml-3"><img src="~/writereaddata/images/indian-army-logo.jpg" height="60" width="50" /></div>
                                                                            <div class="mt-4 ml-3"><img class="PhotoImagePath" onerror="this.src='/Images/Signature.png'" height="60" width="50" /></div>
                                                                            <div class="mt-4 ml-3"><img src="~/images/asset/hologrambg.png" height="60" width="50" /></div>
                                                                        </div>
                                                                        <div class="col-sm-3">
                                                                            <div class="">
                                                                                <div class="f15 font-weight-700">DATE OF BIRTH</div>
                                                                                <div class="DOB"></div>
                                                                            </div>
                                                                            <div>
                                                                                <div class="f15 font-weight-700">HEIGHT </div>
                                                                                <div class="Height"> </div>
                                                                            </div>
                                                                            <div>
                                                                                <span class="f15 font-weight-700">AADHAAR No</span><br />
                                                                                <span class="AadhaarNo">XXXXXXXX</span>
                                                                            </div>
                                                                            <div>
                                                                                <span class="f15 font-weight-700 text-uppercase">BLOOD GROUP</span><br />
                                                                                <span class="BloodGroup"></span>
                                                                            </div>
                                                                            <div>
                                                                                <span class="f15 font-weight-700 text-uppercase">PLACE & DATE OF ISSUE</span>
                                                                                <div class="text-uppercase PlaceOfIssue"></div>
                                                                                <div class="DateOfIssue"></div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-sm-6">
                                                                            <div class="f13 font-weight-400">
                                                                                भारत सरकार की सम्पति। अहस्तान्तरणीय। गुम हो जाने पर निकटतम थाने और अपनी यूनिट को रिपोर्ट करें। सेवा की समाप्ति पर ओ.सी. यूनिट को लौटा दें।
                                                                            </div>
                                                                            <div class="f13 font-weight-400">
                                                                                PROPERTY OF GOVERNMENT OF INDIA NOT TRANSFERABLE. REPORT LOSS IMMEDIATELY TO NEAREST POLICE STATION AND YOUR UNIT. RETURN TO OC UNIT ON CESSATION OF SERVICE.
                                                                            </div>
                                                                            <div class="f13 font-weight-400">
                                                                                पाने वाला इसे सेना/नौसेना/वायु सेना मुख्यालय, नई दिल्ली 110011 को बिना टिकट लगाए, पत्र पेटी में डाल दे या पास के सैनिक यूनिट या थाने में जमा करा दे।
                                                                            </div>
                                                                            <div class="f13 font-weight-400">
                                                                                FINDERS TO DROP THIS LETTER BOX POSTAGE FREE TO ARMY/NAVAL/AIR HEAD QUARTERS, NEW DELHI 110011 OR HANDOVER TO THE NEAREST MILITARY UNIT OR POLICE STATION.
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-sm-3 mt-2">
                                                                            <span class="font-weight-800 border border-dark p-2">1545485</span>
                                                                        </div>
                                                                        <div class="col-sm-6  mt-2">
                                                                            <span class="font-weight-800 border border-dark p-2">SIGNATURE</span>
                                                                        </div>
                                                                        <div class="col-sm-3 text-center mt-2 p-2 border border-dark" style="background-color:white">
                                                                            <span class="p-2"><img class="SignaturePath" onerror="this.src='/Images/Signature.png'" height="30" width="80" /></span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card mt-2 ApplIdHistory d-none page-break-before">
                                                        <div class="card-body">
                                                            <h5 class="text-center badge badge-success">ApplId History</h5>
                                                            <div class="timeline timeline-xs" id="RequestHistoryTrackingId">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script asp-src-include="~/developerjs/keyconstants.js"></script>
    <script asp-src-include="~/developerjs/commanvalidation.js"></script>
    <script asp-src-include="~/developerjs/appstatus.js"></script>
}
