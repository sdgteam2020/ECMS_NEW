@using System.Security.Claims
@using Web.WebHelpers
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Configuration

@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration

@{
    ApplicationUser? user = null;

    IList<string> RoleList = new List<string>();
    IList<System.Security.Claims.Claim> ClaimsList = new List<System.Security.Claims.Claim>();

    DtoSession? dtoSession = null;

    var userId = User?.FindFirstValue(ClaimTypes.NameIdentifier);

    if (!string.IsNullOrEmpty(userId))
    {
        user = await userManager.FindByIdAsync(userId);

        if (user != null)
        {
            RoleList = await userManager.GetRolesAsync(user);
            ClaimsList = await userManager.GetClaimsAsync(user);
        }
    }

    if (!string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session?.GetString("Token")))
    {
        dtoSession = SessionHeplers.GetObject<DtoSession>(
            HttpContextAccessor.HttpContext.Session,
            "Token"
        );
    }

    var isLoggedIn = User?.Identity?.IsAuthenticated == true && user != null;

    var RoleName = dtoSession?.RoleName ?? "user";

    if (!string.IsNullOrEmpty(configuration["Footer:Test"]))
    {
        ViewBag.Footer = configuration["Footer:Test"];
    }
}

<link rel="stylesheet" href="~/developercss/commonheaderinternal.css" asp-append-version="true" />

<header class="eisac-header">
    <div class="container-fluid h-100 px-2 px-sm-3 px-xl-4 ecms-header-container">
        <div class="row g-0 h-100 align-items-center justify-content-center flex-lg-nowrap ecms-header-row">

            <!-- Row 1 on small screen / Column 1 on desktop: First logo -->
            <div class="col-12 col-lg-auto order-1 ecms-header-cell ecms-header-logo-cell header-logo-left">
                <a href="/Home/Dashboard" class="header-logo-link" aria-label="ECMS Dashboard">
                    <img src="~/Images/dgis_ico.png"
                         alt="Army Logo"
                         class="img-fluid logo-img logo-left-img" />
                </a>
            </div>

            <!-- Row 2 on small screen / Center column on desktop: Application title -->
            <div class="col-12 col-lg order-2 ecms-header-cell ecms-header-title-cell">
                <div class="ecms-brand-area">
                    <img src="~/Images/Header-Logo.png"
                         alt="ECMS Logo"
                         class="img-fluid brand-logo-img" />

                    <div class="brand-text-wrap">
                        <h1 class="title-text">
                            Enterprise Card Management System (ECMS)
                        </h1>
                        <p class="subtitle">
                            Secure Identity &amp; Access Portal
                        </p>
                    </div>
                </div>
            </div>

            <!-- Row 3 on small screen / Right action column on desktop: User profile + notification -->
            <div class="col-12 col-lg-auto order-3 ecms-header-cell ecms-header-user-cell">
                @if (isLoggedIn)
                {
                    <nav class="navbar navbar-expand p-0 shadow-none navbar-light show ecms-header-nav"
                         id="sidenavAccordion">

                        <ul class="navbar-nav flex-row align-items-center justify-content-center ecms-action-list">

                            <!-- User Dropdown -->
                            <li class="nav-item dropdown no-caret dropdown-user ecms-user-menu">

                                <a class="dropdown-toggle ecms-user-toggle"
                                   id="navbarDropdownUserImage"
                                   href="javascript:void(0);"
                                   role="button"
                                   data-toggle="dropdown"
                                   aria-haspopup="true"
                                   aria-expanded="false">

                                    <div class="ecms-user-panel">

                                        <div class="ecms-user-text">
                                            <div class="ProfileName ecms-welcome">
                                                WELCOME
                                            </div>

                                            <div class="ProfileName ecms-user-armyno">
                                                <span id="aspntokenarmyno">
                                                    @(dtoSession?.ICNO ?? "")
                                                </span>
                                            </div>

                                            <div class="ProfileName ecms-user-rank">
                                                <span id="ProfileRankName">
                                                    @(dtoSession?.RankName ?? "")
                                                </span>
                                                <span id="ProfileName">
                                                    @(dtoSession?.Name ?? "")
                                                </span>
                                            </div>
                                        </div>

                                        <img class="img-fluid ecms-user-avatar"
                                             src="/Images/user4.png"
                                             alt="User" />
                                    </div>
                                </a>

                                <div class="dropdown-menu dropdown-menu-right border-0 pb-0 shadow animated--fade-in-up"
                                     aria-labelledby="navbarDropdownUserImage">

                                    <h6 class="dropdown-header d-flex align-items-center">
                                        <img class="dropdown-user-img"
                                             src="/Images/user4.png"
                                             alt="User" />

                                        <div class="dropdown-user-details">
                                            <div class="dropdown-user-details-name">
                                                @(user?.UserName ?? "")
                                            </div>
                                        </div>
                                    </h6>

                                    <a class="dropdown-item" href="/UserProfile/Profile">
                                        <i class="ti-settings text-primary"></i>
                                        Edit Profile

                                        <span class="d-none" id="aspndomainUnitID">
                                            @(dtoSession?.UnitId.ToString() ?? "")
                                        </span>
                                    </a>

                                    @foreach (var item in RoleList)
                                    {
                                        if (RoleName == item)
                                        {
                                            <form method="post"
                                                  asp-controller="Account"
                                                  asp-action="SwitchRole"
                                                  asp-route-Id="@item">

                                                <button type="submit"
                                                        class="dropdown-item disabled btn-disabled-custom">

                                                    <i class="ti-settings text-primary"></i>

                                                    <span class="fw-bold">
                                                        @($"{user?.UserName} ({item})")
                                                    </span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post"
                                                  asp-controller="Account"
                                                  asp-action="SwitchRole"
                                                  asp-route-Id="@item">

                                                <button type="submit" class="dropdown-item">
                                                    <i class="ti-settings text-primary"></i>

                                                    <span>
                                                        @($"{user?.UserName} ({item})")
                                                    </span>
                                                </button>
                                            </form>
                                        }
                                    }

                                    @if (ClaimsList.Count > 0)
                                    {
                                        <div class="text-center fw-bold">
                                            Allowed feature
                                        </div>

                                        <ul>
                                            @foreach (var item in ClaimsList)
                                            {
                                                <li>
                                                    <div class="dropdown-item">
                                                        @item.Type
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }

                                    <div class="dropdown-divider"></div>

                                    <a class="dropdown-item active logout-item"
                                       href="/Account/Logout"
                                       id="btnLogout">

                                        <div class="dropdown-item-icon">
                                            <i data-feather="log-out"></i>
                                        </div>

                                        Logout
                                    </a>
                                </div>
                            </li>

                            <!-- Notification -->
                            <li class="nav-item dropdown ecms-notification-item">

                                <a class="dropdown-toggle notif-toggle"
                                   id="navbarDropdownNotification"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Pending Action"
                                   href="javascript:void(0);"
                                   role="button"
                                   data-toggle="dropdown"
                                   aria-haspopup="true"
                                   aria-expanded="false">

                                    <i class="fa fa-bell" aria-hidden="true"></i>

                                    <span class="btn__badge pulse-button d-none" id="Totalnotification">
                                        0
                                    </span>
                                </a>

                                <div class="dropdown-menu dropdown-menu-right border-0 pb-0 shadow animated--fade-in-up"
                                     aria-labelledby="navbarDropdownNotification">

                                    <div class="preview-list"></div>
                                </div>
                            </li>

                        </ul>
                    </nav>
                }
            </div>

            <!-- Row 4 on small screen / Last column on desktop: Last logo -->
            <div class="col-12 col-lg-auto order-4 ecms-header-cell ecms-header-last-logo-cell header-logo-right">
                <img src="~/Images/dgislogo.png"
                     alt="DGIS Logo"
                     class="img-fluid logo-img logo-right-img" />
            </div>

        </div>
    </div>
</header>
