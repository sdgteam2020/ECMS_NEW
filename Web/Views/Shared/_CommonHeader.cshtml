<style>
    /* ======= Base Header Style ======= */
    .eisac-header {
        background: linear-gradient(90deg, #00b4ff 0%, #0076e3 50%, #005fba 100%);
        height: 120px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }
    /* Center Section */
    .center {
        flex: 1;
        text-align: center;
    }

    .title-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 0.6rem 1.2rem;
        border-radius: 16px;
        backdrop-filter: blur(8px);
        box-shadow: inset 0 1px 6px rgba(255,255,255,0.2);
    }

    /* ======= Layout Container ======= */
    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1920px;
        height: 100%;
        padding: 0 20px;
    }

    /* ======= Logos ======= */
    .header-logo {
        flex: 0 0 auto;
        text-align: center;
    }

    .logo-img {
        height: 95px;
        width: auto;
        transition: transform 0.3s ease;
    }

        .logo-img:hover {
            transform: scale(1.08);
        }

    /* ======= Title ======= */
    .header-title {
        text-align: center;
        color: white;
        flex: 1;
    }

    /* STRONGER, DARKER, MORE LEGIBLE */
    .title-text {
        font-size: 34px;
        font-weight: 900;
        font-family: "Cinzel", "Trajan Pro", serif;
        margin: 0;
        letter-spacing: 1px;
        text-transform: uppercase;
        /* deeper gradient for contrast */
        background: linear-gradient(to right, #2e7d32 0%, #c1120c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: #fff;
        /* dark stroke + stacked shadows = crisp edges on any BG */
        -webkit-text-stroke: 1px rgba(0, 0, 0, 0.35);
        text-shadow: 0 2px 3px rgba(0,0,0,.35), /* depth */
        -1px 0 0 rgba(0,0,0,.28), /* outline left  */
        1px 0 0 rgba(0,0,0,.28), /* outline right */
        0 -1px 0 rgba(0,0,0,.28), /* outline top   */
        0 1px 0 rgba(0,0,0,.28); /* outline bottom */
    }

    /* subtitle a bit brighter, with subtle shadow */
    .subtitle {
        font-size: 15px;
        color: #ffffff;
        margin-top: 3px;
        letter-spacing: 0.5px;
        text-shadow: 0 1px 2px rgba(0,0,0,.35);
        opacity: .95;
    }

    /* optional: bump size on large screens */
    @@media (min-width: 1400px) {
        .title-text

    {
        font-size: 38px;
    }

    }


    /* ======= Underline ======= */
    .title-underline {
        width: 80px;
        height: 3px;
        background: white;
        border-radius: 5px;
        margin: 6px auto 0;
        opacity: 0.8;
    }

    /* ======= Responsive ======= */
    @@media (max-width: 992px) {
        .title-text

    {
        font-size: 26px;
    }

    .logo-img {
        height: 75px;
    }

    }

    @@media (max-width: 768px) {
        .header-container

    {
        flex-direction: column;
        gap: 5px;
    }

    .eisac-header {
        height: auto;
        padding: 10px 0;
    }

    .title-text {
        font-size: 22px;
    }

    }
</style>
<header class="eisac-header">
    <div class="header-container">
        <!-- Left Logo -->
        <div class="header-logo">
            <img src="~/Images/dgis_ico.png" alt="Army Logo" class="logo-img" />
        </div>

        <!-- Center Title -->
        <div class="center">
            <div class="title-chip">
                <img src="~/Images/Header-Logo.png" alt="Army Logo" class="logo-img" />
                <div class="header-title">
                    <h1 class="title-text">ENTERPRISE IA SECURE ACCESS CARD (E-ISAC)</h1>
                    <p class="subtitle">Secure Identity &amp; Access Portal</p>
                    <div class="title-underline"></div>
                </div>
            </div>
        </div>


        <!-- Right Logo -->
        <div class="header-logo">
            <img src="~/Images/dgislogo.png" alt="DGIS Logo" class="logo-img" />
        </div>
    </div>
</header>


