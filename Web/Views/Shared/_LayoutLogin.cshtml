@inject IConfiguration configuration;
@{
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" type="image/x-icon" asp-href-include="@($"{Cdn}/images/AFSAC.png")">
    <title> E-ISAC </title>
    @*  <link asp-href-include="/Fonts/css/all.min.css" rel="stylesheet" type="text/css"> *@

    <link href="@($"{Cdn}/css/style.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/css/nunito.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/css/roboto.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/bootstrap/css/bootstrap.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/lib/jqueryui/themes/base/jquery-ui.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/css/login.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/fonts/css/all.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />

    <link href="@($"{Cdn}/sweetalert2/sweetalert2.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/css/feed.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />

    <link href="@($"{Cdn}/css/normalize.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    @*   <link asp-href-include="~/css/swiper.min.css" rel="stylesheet" /> *@
    <link href="@($"{Cdn}/css/feed.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    <link href="@($"{Cdn}/css/main.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
    @*     <link asp-href-include="~/css/sliders/style.css" rel="stylesheet" /> *@
    <link href="@($"{Cdn}/developercss/layoutlogin.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div>
    @*<div class="watermark">
        <div>
            <img src="/Images/dgislogo.png" alt="Watermark" loading="lazy">
        </div>
    </div> *@
        @RenderBody()
        <footer class="fixed-bottom">
            <section class="page_copyright ls section_padding_25">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12 text-center">
                            <div class="footer-content">
                                @if (ViewBag.Footer != null)
                                {
                                    @ViewBag.Footer
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </footer>
    </div>
    <script src="@($"{Cdn}/lib/jquery/jquery.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/lib/jquery-validate/jquery.validate.js?v={configuration["StaticVersion"]}")" defer></script>
    <script src="@($"{Cdn}/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js?v={configuration["StaticVersion"]}")" defer></script>
    <script src="@($"{Cdn}/lib/jqueryui/jquery-ui.min.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/bootstrap/js/bootstrap.bundle.min.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/bootstrap/js/bootstrap.min.js?v={configuration["StaticVersion"]}")"></script>
    <script src="@($"{Cdn}/sweetalert2/sweetalert2.min.js?v={configuration["StaticVersion"]}")"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
