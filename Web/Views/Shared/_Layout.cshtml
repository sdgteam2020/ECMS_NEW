                                        <label class="form-control spnInternalFArmyNo" readonly></label>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold"> Rk & Offr Name</label>
                                    <div class="col-sm-8">
                                        <label class="form-control spnInternalFtoname" readonly></label>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold">Domain ID</label>
                                    <div class="col-sm-8">
                                        <label class="form-control spnInternalFDomainName" readonly></label>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold">App.</label>
                                    <div class="col-sm-8">
                                        <label class="form-control spnInternalFAppName" readonly></label>
                                    </div>
                                </div>
                                <div class="form-group row mb-2 RemarksInternalFwd d-none">
                                    <label class="col-form-label col-sm-4 fw-bold">Select Remarks</label>
                                    <div class="col-sm-8">
                                        <select class="form-control" multiple="" placeholder="Please select a Remarks" tabindex="-1" name="ddlInternalRemarks" id="ddlInternalRemarks" data-val="true">
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlInternalRemarks" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold">Other Obsn</label>
                                    <div class="col-sm-8">
                                        <textarea class="form-control1" id="txtFRemarksInternal" name="txtFRemarksInternal" rows="3" maxlength="100" data-val="true" data-val-regex="Only letters, numbers, space and full stop (.) are allowed." data-val-regex-pattern="^[a-zA-Z0-9. ]*$"></textarea>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtFRemarksInternal" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="btnInternalFwdSubmit">Forward</button>
                </div>
            </form>
        </div>
    </div>
</div>

