<body class="nav-fixed sidenav-toggled">
    @Html.AntiForgeryToken()
    <div id="loading" class="loader">
        <div class="loader-container">
        <img src="/Images/load.gif" width="100">
            <div>
                <h4 class="mt--20">Loading...</h4>
            <span>Please wait. This may take few seconds.</span>
            </div>
        </div>
    </div>
    @{
        var userId = this.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var user = await userManager.FindByIdAsync(userId);
        var RoleList = await userManager.GetRolesAsync(user);
        var ClaimsList = await userManager.GetClaimsAsync(user);
        List<string> RoleNameList = new List<string>() { "user" };
        DtoSession? dtoSession = new DtoSession();
        if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("Token")))
        {
            dtoSession = SessionHeplers.GetObject<DtoSession>(HttpContextAccessor.HttpContext.Session, "Token");

        }
        var RoleName = dtoSession != null ? dtoSession.RoleName : "user";
        if (!string.IsNullOrEmpty(@configuration["Footer:Test"]))
        {
            string? Footer = @configuration["Footer:Test"];
            ViewBag.Footer = Footer;
        }

    }
        <input type="hidden" value="@dtoSession.Salt" id="hiddenSa" />
    <div class="watermark yes-print"></div>
    <div class="d-none" id="IpaddresGloble">@(Context.Connection.RemoteIpAddress?.MapToIPv4().ToString() ?? "0.0.0.0")</div>
    <div class="d-none" id="postingouthtml"></div>
    <div class="d-none" id="content-container"></div>
    <div class="d-none" id="spnPostedOffrsfornoti"></div>
    <input class="form-control mb-2 d-none form-space" id="txtspnTokenArmyNo" placeholder="Enter Army No" />
    <input class="form-control mb-2 d-none form-space" id="txtspnTokenthumbprint" placeholder="Enter Army No" />
    <input class="form-control mb-2 d-none form-space" id="txtspnIsToken" />

    <partial name="~/Views/Shared/_CommonHeaderInternal.cshtml" />

    <div id="layoutSidenav">
        @*   <div id="layoutSidenav_nav">
        <nav class="sidenav shadow-right sidenav-light" id="SideFirstMenu">
        <div class="sidenav-menu">
        <div class="nav accordion" id="accordionSidenav">

        </div>
        </div>
        </nav>
        </div> *@
        <div id="layoutSidenav_content">
            <main>
                <div class="main-panel">
                    @if (RoleNameList.Contains(RoleName))
                    {
                        <nav class="nav nav-pills nav-justified" id="layouttask">
                            <a class="nav-link Dashboard" aria-current="page" href="/Home/Dashboard">DashBoard</a>
                            <a class="nav-link Status" href="/Home/Request">
                                Initiate Request
                            </a>
                            <a class="nav-link MyTask" href="/Home/Task">Task</a>
                        </nav>
                    }
                    else
                    {
                        <nav class="nav-hide-for-admin" id="_layouttask">
                            &nbsp
                        </nav>
                    }
                    <div class="content-wrapper">
                        <partial name="_Notification" />
                        @RenderBody()

                        <!-- partial -->
                        <!-- main-panel ends -->
                    </div>
                    <!-- page-body-wrapper ends -->
                </div>
            </main>
        </div>
    </div>
    @if (IsSectionDefined("Modal"))
    {
        <div class="">
            @RenderSection("Modal", required: false)
        </div>
    }
    <footer class="fixed-bottom">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Invisible placeholder for balancing the center -->
                    <div class="footer-placeholder"></div>

                    <!-- Left Section: Centered Content -->
                    <div class="flex-grow-1 text-center fw-bold">
                        @if (ViewBag.Footer != null)
                        {
                            @(ViewBag.Footer)
                        }
                    </div>
                    <!-- Right Section: Info Spans -->
                    <div class="text-end">
