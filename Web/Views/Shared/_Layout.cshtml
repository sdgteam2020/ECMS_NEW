            </div>
            <form action="" id="SaveInternalRecordFwd" name="SaveInternalRecordFwd" method="post">
                <div class="modal-body">
                    <div class="card mt-2">
                        <div class="mt-2 ml-4">
                            <div class="row HProfileDetails">
                                <span id="spnFwdToInternalUsersId" class="d-none">0</span>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold">Select Offr<i class="fas fa-asterisk mand1"></i></label>
                                    <div class="col-sm-8">
                                        <select class="form-control" tabindex="-1" name="ddlfwdInternaloffrs" id="ddlfwdInternaloffrs" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Offr is required.">
                                            <option value="0">Select Offr</option>
                                        </select>
                                        <span class="text-danger field-validation-valid" data-valmsg-for="ddlfwdInternaloffrs" data-valmsg-replace="true"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-form-label col-sm-4 fw-bold">Army No</label>
