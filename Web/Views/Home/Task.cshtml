<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> >Task


                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    @if (RoleNameList.Contains(ViewBag.Role))
    {
        <div class="row">
            <div class="card p-4">
                <div class="card-heading">
                    <span class="sub-card-heading">Offrs</span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/MyTask/T2ZmcnNTdWJtaXR0ZWQ=" class="clickable">
                            @*  OffrsSubmitted *@
                            <div class="counter blue">
                                <div class="counter-icon">
                                    <i class="fa fa-user"></i>
                                </div>
                                <h3 style="margin-top:2.0rem!important;">
                                    Status of Appl Submitted
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/MyTask/T2ZmcnNQZW5kaW5n" class="clickable">
                            @*  OffrsPending *@
                            <div class="counter blue">
                                <div class="counter-icon">
                                    <i class="fa fa-user-circle"></i>
                                </div>
                                <h3 style="margin-top:2.0rem!important;">
                                    Pending Actions (Approver)
                                </h3>
                            </div>
                        </a>
                    </div>

                </div>
            </div>
            <div class="card p-4">
                <div class="seven card-heading">
                    <span class="sub-card-heading">JCOs/OR</span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/MyTask/SkNPc1N1Ym1pdHRlZA==" class="clickable">
                            @*  JCOsSubmitted *@
                            <div class="counter red">
                                <div class="counter-icon">
                                    <i class="fa fa-street-view"></i>
                                </div>
                                <h3 style="margin-top:2.0rem!important;">
                                    Status of Appl Submitted
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/MyTask/SkNPc1BlbmRpbmc=" class="clickable">
                            @*  JCOsPending *@
                            <div class="counter red">
                                <div class="counter-icon">
                                    <i class="fa fa-ban"></i>
                                </div>
                                <h3 style="margin-top:2.0rem!important;">
                                    Pending Actions (Approver)
                                </h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="card p-4">
                <div class="seven card-heading">
                    <span class="sub-card-heading">
                        AFSAC Dispatching
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter pink armyNoallserchPopup" id="btnDispatchCard">
                                @if (claims.Count > 0 && (claims.Any(i => i.Value == "ICard Export Data") || (claims.Any(i => i.Value == "Dispatch Card") && claims.Any(i => i.Value == "Appl Approver")) || claims.Any(i => i.Value == "Dispatch Card")))
                                {
                                    <div class="counter-icon">
                                        <button class="btn btn-outline-success font-weight-600 btn-sm" id="btnAddDispatchCard"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="counter-icon">
                                        <i class="fa fa-truck"></i>
                                    </div>
                                }
                                <span class="counter-value" id="TotDispatchCards"></span>
                                <h3>
                                    AFSAC Dispatching
                                </h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="card p-4">
                <div class="seven card-heading">
                    <span class="sub-card-heading">
                        AFSAC Issuance & Destruction
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter pink armyNoallserchPopup" id="btnDistCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddDistsCard" data-type="55"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotDistCards"></span>
                                <h3>
                                    AFSAC Issuance
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter pink armyNoallserchPopup" id="btnDestCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddDestsCard" data-type="56"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotDestCards"></span>
                                <h3>
                                    AFSAC Destruction
                                </h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="card p-4">
                <div class="seven card-heading">
                    <span class="sub-card-heading">
                        AFSAC Management Post Issuance
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter purple armyNoallserchPopup" id="btnHotlistCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddHotlistCard" data-type="53"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotHotlistCards"></span>
                                <h3>
                                    Hotlisting of AFSAC
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter purple armyNoallserchPopup" id="btnMisprintedCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddMisprintedCard" data-type="52"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotMisprintedCard"></span>
                                <h3>
                                    Faulty/Non Functional AFSAC
                                </h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
            <div class="card p-4">
                <div class="seven card-heading">
                    <span class="sub-card-heading">
                        SD Move Units & Indls Mov
                    </span>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter purple armyNoallserchPopup" id="btnUnitChangeRequest">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm" id="btnAddUnitChangeRequest"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotUnitChangeRequest"></span>
                                <h3>Unit Move Request</h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<script asp-src-include="~/developerjs/Task.js"></script>