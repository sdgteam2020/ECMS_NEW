@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Claim> claims = ViewBag.UserClaims;
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/reportandreturn.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > Reports &amp; Returns for Appl
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="ecms-page-full ecms-fit-screen ecms-report-page">
    <section class="ecms-card section_to_report_toPrint ecms-report-shell" id="section_to_report_toPrint">
        <div class="ecms-card-body ecms-report-card-body">
            <div class="ecms-page-title ecms-report-heading d-print-none">
                <div class="ecms-title-icon" aria-hidden="true">
                    <i class="fa fa-bar-chart"></i>
                </div>
                <div class="ecms-min-0">
                    <h2>Reports &amp; Returns for Appl</h2>
                    <p class="ecms-title-subtitle">Application movement and approval status summary</p>
                </div>
            </div>

            @if (claims.Count > 0 && claims.Any(i => i.Value == "Army Level Reports" || i.Value == "Fmn Level Reports"))
            {
                <div class="ecms-filter-wrapper">

                    <div class="ecms-filter-toggle-row d-print-none">

                        <button type="button"
                                id="btnToggleSearchCard"
                                class="ecms-filter-toggle"
                                aria-expanded="true"
                                aria-controls="searchUnitCard">

                            <i class="fa fa-chevron-up ecms-filter-toggle-icon"
                               aria-hidden="true"></i>

                            <span class="ecms-filter-toggle-text">
                                Hide Unit Search
                            </span>

                        </button>

                    </div>


                    <div id="searchUnitCard" class="ecms-section ecms-form-section ecms-filter-panel d-print-none">
                        <div class="row pt-1 SearchTab">
                            <div class="form-group row mb-2 ecms-unit-type-row">
                                <span id="spnclaimId" class="d-none">@(claims.Any(i => i.Value == "Army Level Reports") ? "Army Level Reports" : "Fmn Level Reports")</span>
                                <label class="col-form-label col-md-2 fw-bold">Select Unit Type <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-md-10 ecms-radio-group">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType1" value="1" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled")>
                                        <label class="form-check-label" for="UnitType1">Unit</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType2" value="2" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled")>
                                        <label class="form-check-label" for="UnitType2">Unit(Fmn HQ)</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType3" value="3" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled")>
                                        <label class="form-check-label" for="UnitType3">Unit(Dte/Branch)</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row SearchTab ecms-filter-grid">
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlCommand" required id="ddlCommand">
                                    <option value="">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlCorps" required id="ddlCorps">
                                    <option value="">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Div/Sub Area<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlDiv" required id="ddlDiv">
                                    <option value="">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Bde<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlBde" required id="ddlBde">
                                    <option value="">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 FmnBranch d-none">
                                <label class="col-form-label fw-bold">Type of Fmn /Branch<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlFmnBranch" required id="ddlFmnBranch">
                                    <option value="1">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 DteBranch d-none">
                                <label class="col-form-label fw-bold">PSO /Dte <i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlPSODte" required id="ddlPSODte">
                                    <option value="1">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 DteBranch d-none">
                                <label class="col-form-label fw-bold">DG / Sub Dte <i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlDgSubDte" required id="ddlDgSubDte">
                                    <option value="1">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <label class="col-form-label fw-bold">Unit <i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" name="ddlUnit" required id="ddlUnit">
                                    <option value="">All</option>
                                </select>
                            </div>
                            <div class="col-sm-3 ecms-filter-action">
                                <input type="button" value="Search" id="btnSearch" class="btn btn-primary d-print-none" />
                            </div>
                        </div>
                    </div>

                </div>
            }

            <div id="root" class="ecms-report-root ecms-scroll-y ecms-min-0">
                <div class="pt-1 RecordCount" id="countlistreport">
                    &nbsp;
                </div>
                <div class="pt-1 d-none" id="RecordOfficeCountPendding">
                </div>
                <div class="pt-1 d-none" id="RecordOfficeCountApprove">
                </div>
            </div>
        </div>
    </section>
</main>

<div class="modal fade ecms-report-modal"
     id="RepotReturnHistory"
     tabindex="-1"
     aria-labelledby="lblRepotReturnHistory"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2 ecms-min-0">
                    <i class="fa fa-history" aria-hidden="true"></i>
                    <h4 class="modal-title" id="lblRepotReturnHistory">Application History</h4>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            <div class="modal-body ecms-min-0">
                <div class="ecms-dt-wrap ecms-report-history-table">
                    <table class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           id="tbldatadialog"
                           aria-label="Application movement history">
                    </table>
                </div>
                <div class="mt-2" id="msg" role="status">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
    <script asp-src-include="~/developerjs/ICardPrint.js"></script>
    <script asp-src-include="~/developerjs/reportandreturn.js"></script>
}
