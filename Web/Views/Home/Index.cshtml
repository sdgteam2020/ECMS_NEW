@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}
<style>
    .clickable {
        height: 180px !important;
        width: 200px !important;
    }

    .hero {
        /* path to your image */
        background-image: url("/Images/HomePage/2.png");
        /* make it fill nicely */
        background-size: cover; /* cover entire div */
        background-position: top;
        background-repeat: no-repeat;
        /* optional: fixed parallax feel */
        background-attachment: fixed;
        /* size of the div */
        min-height: 100vh; /* or a fixed height like 500px */
        width: 100%;
    }
</style>
<link asp-href-include="~/css/homeindex.css" rel="stylesheet" />

<div class="hero">
    <div class="wrap">
        @*     <div id="dir-control-left" class="dir-control">
