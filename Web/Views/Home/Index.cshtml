@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}
<link href="@($"{Cdn}/developercss/homeindex.css?v={Ver}")" rel="stylesheet"   />

<div class="hero">
    <div class="container-fluid h-100 d-flex align-items-end">
        <div class="row w-100 justify-content-center g-1 pb-3 pb-md-4">

            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-content-center">
                <div class="a-box w-100">
                    <a href="/Home/Dashboard" class="clickable">
                        <div class="img-container">
                            <div class="img-inner">
                                <div class="inner-skew">
                                    <img src="~/images/asset/dashboard.png" alt="Dashboard" class="img-fluid" />
                                </div>
                            </div>
                        </div>
                        <div class="text-container">
                            <h3>Dashboard</h3>
                            <div>
                                Dashboard contains all pending requests for approval
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-content-center">
                <div class="a-box w-100">
                    <a href="/Home/Request" class="clickable">
                        <div class="img-container">
                            <div class="img-inner">
                                <div class="inner-skew">
                                    <img src="~/images/asset/request.png" alt="Initiate Request" class="img-fluid" />
                                </div>
                            </div>
                        </div>
                        <div class="text-container">
                            <h3>Initiate Request</h3>
                            <div>
                                Guides to the link to Initiate I-Card Requests
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-content-center">
                <div class="a-box w-100">
                    <a href="/Home/Task" class="clickable">
                        <div class="img-container">
                            <div class="img-inner">
                                <div class="inner-skew">
                                    <img src="~/images/asset/task-100.png" alt="Task" class="img-fluid" />
                                </div>
                            </div>
                        </div>
                        <div class="text-container">
                            <h3>Task</h3>
                            <div>
                                Contains role based activity
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3 d-flex justify-content-center">
                <div class="a-box w-100">
                    <a href="/Home/ContactUs" class="clickable">
                        <div class="img-container">
                            <div class="img-inner">
                                <div class="inner-skew">
                                    <img src="~/images/asset/contact-us-circle.png" alt="Contact Us" class="img-fluid" />
                                </div>
                            </div>
                        </div>
                        <div class="text-container">
                            <h3>Contact Us</h3>
                            <div>
                                Contact information and support details
                            </div>
                        </div>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>