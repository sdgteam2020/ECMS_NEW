@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user" };
    List<Claim> claims = ViewBag.UserClaims;
}
<style>
    .clickable {
        height: 154px;
        width: 154px;
        display: inline;
    }

    .p-4 {
        padding: 1.5rem !important;
        padding-bottom: 4.5rem !important;
    }
</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > Dashboard

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    @if (RoleNameList.Contains(ViewBag.Role))
    {
        <div class="row">
            <div class="card p-4">
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/SubDashboard" class="clickable">
                            <div class="counter pink d-sm-block d-md-block">
                                <div class="counter-icon">
                                    <i class="fa fa-address-card"></i>
                                </div>
                                <span class="counter-value" id="TotReq">0</span>
                                <h3>I-Card Request</h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/BasicDetail/InaccurateData?Id=MQ==" class="clickable">
                            <div class="counter pink">
                                <div class="counter-icon">
                                    <i class="fa fa-address-card"></i>
                                </div>
                                <span class="counter-value" id="TotInaccurateData">0</span>
                                <h3>Requests pending due to Incorrect Details/Data</h3>
                            </div>
                        </a>
                    </div>
                    @if (claims.Count > 0 && claims.Any(i => i.Value == "View Indl Incorrect Data"))//@if (ViewBag.Role == "Coordinator" || ViewBag.Role == "RecordUser" || ViewBag.Role == "OROUser" || ViewBag.Role == "DteAdmin")
                    {
                        <div class="col-md-2 col-sm-6">
                            <a href="/BasicDetail/InaccurateData?Id=Mg==" class="clickable">
                                <div class="counter pink">
                                    <div class="counter-icon">
                                        <i class="fa fa-address-card"></i>
                                    </div>
                                    <span class="counter-value" id="TotObservationRaised">0</span>
                                    <h3>Observation Raised List</h3>
                                </div>
                            </a>
                        </div>
                    }
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/DashboardUserMgt" class="clickable">
                            <div class="counter pink">
                                <div class="counter-icon">
                                    <i class="fa fa-address-card"></i>
                                </div>
                                <h3 style="margin-top:3.0rem!important;">
                                    User Management
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/ReportAndReturn" class="clickable">
                            <div class="counter pink">
                                <div class="counter-icon">
                                    <i class="fa fa-address-card"></i>
                                </div>
                                <h3 style="margin-top:3.0rem!important;">
                                    Reports &amp; Returns
                                </h3>
                            </div>
                        </a>
                    </div>
                    @if (ViewBag.Role == "DteAdmin")
                    {
                        <div class="col-md-2 col-sm-6">
                            <a href="/Home/ICardProcessReport" class="clickable">
                                @*  OffrsSubmitted *@
                                <div class="counter blue">
                                    <div class="counter-icon">
                                        <i class="fa fa-user"></i>
                                    </div>
                                    <h3 style="margin-top:2.0rem!important;">
                                        I-Card Process Report
                                    </h3>
                                </div>
                            </a>
                        </div>
                    }
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter purple armyNoallserchPopup" id="btnMisprintedCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddMisprintedCard" data-type="52"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <h3 style="margin-top:3.5rem!important;">
                                    Misprinted Card
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter purple armyNoallserchPopup" id="btnHotlistCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddHotlistCard" data-type="53"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotHotlistCards"></span>
                                <h3>Card Hotlisting</h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="#" class="clickable">
                            <div class="counter pink armyNoallserchPopup" id="btnLostCard">
                                <div class="counter-icon">
                                    <button class="btn btn-outline-success font-weight-600 btn-sm btnAdd" id="btnAddLostCard" data-type="54"><i class="fa fa-plus mr-1 font-weight-700" aria-hidden="true"></i>Add</button>
                                </div>
                                <span class="counter-value" id="TotLostCards"></span>
                                <h3>Lost Card</h3>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<script asp-src-include="~/developerjs/dashboard.js"></script>
