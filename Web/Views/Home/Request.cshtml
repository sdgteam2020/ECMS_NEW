@{
    ViewData["Title"] = "Initiate Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/developercss/home_request.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> @* > Initiate Request *@

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="row">
        
        <div class="card p-4 ">
            <div class="seven">
                <h1>
                    I-Card Request
                </h1>
            </div>
            <div class="row">
                <div class="col-md-12 col-sm-6 text-center">
                    <div class="card p-4 cardmain">
                        <div class="row">
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple" id="btnApplyCard">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Apply for Smart<br/> I-Card
                                        </h3>

                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple armyNoallserchPopup" id="btnApplicantsPostingout">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Applicants Posting out
                                        </h3>

                                    </div>
                                </a>
                            </div>
                            @if (claims.Count > 0 && claims.Any(i => i.Value == "View Flagged ICard Appl"))//@if (ViewBag.Role == "DteAdmin" || ViewBag.Role == "AFSACUser")
                            {
                                <div class="col-md-2 col-sm-6">
                                    <a href="/BasicDetail/ICardRequestHold">
                                        <div class="counter purple armyNoallserchPopup" id="btnApplicantsHold">
                                            <div class="counter-icon">
                                                <i class="fa fa-plus-circle"></i>
                                            </div>
                                            <h3 style="margin-top:3rem!important;">
                                                FLAG DISCIPLINARY ACTION
                                            </h3>
                                        </div>
                                    </a>
                                </div>
                            }
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple armyNoallserchPopup" id="btnApplicantsClose">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Appl Closed
                                        </h3>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                    @*  <button type="button" class="btn btn-outline-primary btn1" id="btnApplyCard">Apply for Smart I-Card</button>
                    <button type="button" class="btn btn-outline-primary btn1" id="btnApplicantsPostingout">Applicants Posting out</button> *@
                </div>
                <div class="col-md-12 col-sm-6 text-center mt-4 ApplyCard d-none" id="btnarmytype">
                    <button type="button" class="btn btn-outline-primary btn1" id="btnaddOffrs">Offrs</button>
                    <button type="button" class="btn btn-outline-primary btn1" id="btnJCOs">JCOs/OR </button>
                </div>

                <div class="col-md-12 col-sm-6 text-center mt-4 ApplyCard" id="btnIcardFor">
                </div>
                <div class="col-md-12 col-sm-6 text-center d-none1 ApplyCard" id="icardrequestfor">
                </div>
                <div class="col-md-12 col-sm-6 mt-4 center-input-container" id="">
                    <input class="form-control mb-2 d-none ApplyCard small-width-input" id="txtApplyForOldArmyNo" value="1" placeholder="Enter Old Army No With pfx & sfx Ex.ICXXXXXP,JC391516M,15698645A" maxlength="9" data-val-maxlength="Maximum length of Army No is nine character." data-val-maxlength-max="9" data-val-minlength="Minimum length of Army No is eight character." data-val-minlength-min="8" minlength="8" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-regex-pattern="^[\w]+$" />
                    <input class="form-control mb-2 d-none ApplyCard form-space spnarmynoformula small-width-input" id="txtApplyForArmyNo" value="1" placeholder="Enter Army No With pfx & sfx Ex.ICXXXXXP,JC391516M,15698645A" maxlength="9" data-val-maxlength="Maximum length of Army No is nine character." data-val-maxlength-max="9" data-val-minlength="Minimum length of Army No is eight character." data-val-minlength-min="8" minlength="8" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Army No is required." data-val-regex-pattern="^[\w]+$" />
                </div>
                <div class="col-md-12 col-sm-6 text-center mt-4 d-none ApplyCard" id="spnNext">
                    <button type="button" class="btn btn-danger mt-4 d-none mr-4 btn1" id="btntokenrefresh">
                        Refresh to Fetch Details from Token
                    </button>
                    <button type="button" class="btn btn-warning mt-4 btn1 disabled" id="btnNext">Next</button>
                </div>

                <div class="col-md-12 col-sm-6 text-center mt-4 d-none1 ApplyCard" id="">
                    <span id="tokenmsg"></span>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script asp-src-include="~/developerjs/Request.js"></script>
    <script asp-src-include="~/developerjs/Token.js"></script>
}
