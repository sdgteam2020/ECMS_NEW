@{
    ViewData["Title"] = "Initiate Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Claim> claims = ViewBag.UserClaims;
}
<link asp-href-include="~/developercss/home_request.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> @* > Initiate Request *@

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10 request-compact-page">
    <div class="row">
        <div class="card p-4 request-shell">
            <div class="seven">
                <h1>
                    I-Card Request
                </h1>
            </div>
            <div class="row">
                <div class="col-md-12 col-sm-6 text-center">
                    <div class="card p-4 cardmain">
                        <span id="spnhdns" class="d-none">@ViewBag.hdns</span>
                        <div class="row">
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple" id="btnApplyCard">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Apply for Smart<br /> I-Card
                                        </h3>

                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple armyNoallserchPopup" id="btnApplicantsPostingout">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Applicants Posting out
                                        </h3>

                                    </div>
                                </a>
                            </div>
                            @if (claims.Count > 0 && claims.Any(i => i.Value == "View Flagged ICard Appl"))
                            {
                                <div class="col-md-2 col-sm-6">
                                    <a href="/BasicDetail/ICardRequestHold">
                                        <div class="counter purple armyNoallserchPopup" id="btnApplicantsHold">
                                            <div class="counter-icon">
                                                <i class="fa fa-plus-circle"></i>
                                            </div>
                                            <h3 class="counter-title">
                                                FLAG DISCIPLINARY ACTION
                                            </h3>
                                        </div>
                                    </a>
                                </div>
                            }
                            <div class="col-md-2 col-sm-6">
                                <a href="#">
                                    <div class="counter purple armyNoallserchPopup" id="btnApplicantsClose">
                                        <div class="counter-icon">
                                            <i class="fa fa-plus-circle"></i>
                                        </div>
                                        <h3 class="counter-title">
                                            Close Appl
                                        </h3>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-md-12 col-sm-6 text-center ApplyCard d-none" id="btnarmytype">
                    <button type="button" class="btn btn-outline-primary btn1" id="btnaddOffrs">Offrs</button>
                    <button type="button" class="btn btn-outline-primary btn1" id="btnJCOs">JCOs/OR </button>
                </div>

                <div class="col-md-12 col-sm-6 text-center mt-4 ApplyCard" id="btnIcardFor">
                </div>
                <div class="col-md-12 col-sm-6 text-center d-none1 ApplyCard" id="icardrequestfor">
                </div>
                <div class="col-12 mt-4 ApplyCard d-none" id="armyNoSection">
                    <div class="army-form-card">
                        <div class="army-form-header">
                            <input type="radio" id="Proceed" name="Status_check" value="Proceed" checked>
                            <label for="Proceed">Proceed</label><br>
                            <input type="radio" id="Previous" name="Status_check" value="Search Previous">
                            <label for="Previous">Search Previous ICard Appl Running / Completed / Closed</label><br>
                            <h5>Enter Army Number</h5>
                            <p>Provide Army Number with prefix and suffix, if applicable.</p>
                        </div>

                        <!-- Old Army No -->
                        <div class="army-field d-none" id="oldArmyNoWrapper">
                            <label>Old Army No</label>

                            <div class="army-combo">
                                <select id="ddlForOldArmyNoRulePrefix" class="army-prefix">
                                </select>

                                <input class="army-input-combo alpha-num-only spnarmynoformula"
                                       id="txtApplyForOldArmyNo"
                                       placeholder="Enter Old Army No"
                                       maxlength="9"
                                       minlength="8" />
                            </div>
                        </div>

                        <!-- New Army No -->
                        <div class="army-field" id="newArmyNoWrapper">
                            <label>Army No</label>

                            <div class="army-combo">
                                <select id="ddlForArmyNoRulePrefix" class="army-prefix">
                                </select>

                                <input class="army-input-combo alpha-num-only spnarmynoformula"
                                       id="txtApplyForArmyNo"
                                       placeholder="Enter Army No"
                                       maxlength="9"
                                       minlength="8" />
                            </div>
                        </div>

                        <small class="army-help">
                            Example: ICXXXXXP, JC391516M, 15698645A
                        </small>
                    </div>


                </div>
                <div class="col-md-12 col-sm-6 text-center mt-4 d-none ApplyCard" id="spnNext">
                    <button type="button" class="btn btn-danger mt-4 d-none mr-4 btn1" id="btntokenrefresh">
                        Refresh to Fetch Details from Token
                    </button>
                    <button type="button" class="btn btn-warning mt-4 btn1 disabled" id="btnNext">Next</button>
                </div>

                <div class="col-md-12 col-sm-6 text-center mt-4 d-none1 ApplyCard" id="">
                    <span id="tokenmsg"></span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="HistoryPopupModal"
     tabindex="-1"
     aria-labelledby="HistoryPopupModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content history-modal">

            <div class="modal-header">
                <h5 class="modal-title" id="HistoryPopupModalLabel">
                    I-Card Application History
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <!-- Under Progress -->
                <div class="history-section history-under-process">
                    <div class="history-section-header">
                        <span>Under Progress</span>
                        <span id="UnderProcessCount"
                              class="history-count">
                            0
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover history-table">
                            <thead>
                                <tr>
                                    <th class="history-sno">S.No</th>
                                    <th>Application No</th>
                                    <th>Date</th>
                                    <th class="history-action">Action</th>
                                </tr>
                            </thead>

                            <tbody id="UnderProgressHistoryBody">
                            </tbody>
                        </table>
                    </div>
                </div>


                <!-- Total Complete -->
                <div class="history-section history-complete">
                    <div class="history-section-header">
                        <span>Completed</span>
                        <span id="CompleteCount"
                              class="history-count">
                            0
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover history-table">
                            <thead>
                                <tr>
                                    <th class="history-sno">S.No</th>
                                    <th>Application No</th>
                                    <th>Date</th>
                                    <th class="history-action">Action</th>
                                </tr>
                            </thead>

                            <tbody id="CompleteHistoryBody">
                            </tbody>
                        </table>
                    </div>
                </div>


                <!-- Total Closed -->
                <div class="history-section history-closed">
                    <div class="history-section-header">
                        <span>Closed</span>
                        <span id="ClosedCount"
                              class="history-count">
                            0
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover history-table">
                            <thead>
                                <tr>
                                    <th class="history-sno">S.No</th>
                                    <th>Application No</th>
                                    <th>Date</th>
                                    <th class="history-action">Action</th>
                                </tr>
                            </thead>

                            <tbody id="ClosedHistoryBody">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script asp-src-include="~/developerjs/Request.js"></script>
    <script asp-src-include="~/developerjs/Token.js"></script>
    <script asp-src-include="~/developerjs/helper_CompletedHistory.js"></script>
    <script asp-src-include="~/developerjs/helper_ClosedHistoryDetails.js"></script>
}
