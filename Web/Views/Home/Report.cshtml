@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user" };
    List<Claim> claims = ViewBag.UserClaims;
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<style>
    .clickable {
    height: 190px;
    width: 190px;
    display: block;
    margin-bottom: 25px;
    }

    .p-4 {
    padding: 1.5rem !important;
    padding-bottom: 4.5rem !important;
    }

    .ui-datepicker-calendar {
    display: none !important;
    }

    #CardReport_tbldatadialog {
        table-layout: auto !important;
        width: 100% !important;
    }

    #CardReport_tbldatadialog th,
    #CardReport_tbldatadialog td {
        white-space: nowrap; /* Optional: prevent line wrap */
        vertical-align: middle;
    }

</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > Dashboard

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="row">
        <div class="card">
            @if (claims.Count > 0 && claims.Any(i => i.Value == "Army Level Reports" || i.Value == "Fmn Level Reports"))
            {
                <div class="row p-3">
                    <div class="card  section_to_report_toPrint p-3" id="section_to_report_toPrint">
                        <div class="row pt-1 SearchTab d-print-none">
                            <div class="form-group row mb-2">
                                <span id="spnclaimId" class="d-none">@(claims.Any(i => i.Value == "Army Level Reports") ? "Army Level Reports" : "Fmn Level Reports")</span>
                                <label class="col-form-label col-md-2 fw-bold">Select Unit Type <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-md-10">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType1" value="1" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                        <label class="form-check-label" for="UnitType1">Unit</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType2" value="2" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                        <label class="form-check-label" for="UnitType2">
                                            Unit(Fmn HQ)
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType3" value="3" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                        <label class="form-check-label" for="UnitType3">Unit(Dte/Branch)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row SearchTab">
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                                <select class="form-select" aria-hidden="true" name="ddlCommand" required id="ddlCommand">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlCorps" required id="ddlCorps">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Div/Sub Area<i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlDiv" required id="ddlDiv">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 unittype">
                                <label class="col-form-label fw-bold">Bde<i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlBde" required id="ddlBde">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 FmnBranch  d-none">
                                <label class="col-form-label fw-bold">Type of Fmn /Branch<i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlFmnBranch" required id="ddlFmnBranch">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 DteBranch d-none">
                                <label class="col-form-label fw-bold">PSO /Dte <i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlPSODte" required id="ddlPSODte">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3 DteBranch d-none">
                                <label class="col-form-label fw-bold">DG / Sub Dte <i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlDgSubDte" required id="ddlDgSubDte">
                                    <option value="">All</option>
                                </select>

                            </div>
                            <div class="col-sm-3">
                                <label class="col-form-label fw-bold">Unit<i class="fas fa-asterisk mand1"></i></label>

                                <select class="form-select" aria-hidden="true" name="ddlUnit" required id="ddlUnit">
                                    <option value="">All</option>
                                </select>

                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (RoleNameList.Contains(ViewBag.Role))
            {
                <div class="row p-3">
                    <div class="card p-3">
                        <div class="row">
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter pink" id="btnRequisition">
                                        <div class="counter-icon">
                                            <i class="fa fa-tasks"></i>
                                        </div>
                                        <span class="counter-value" id="TotRequisition">0</span>
                                        <h3>New Requisition</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter pink" id="btnLostCase">
                                        <div class="counter-icon">
                                            <i class="fa fa-question-circle"></i>
                                        </div>
                                        <span class="counter-value" id="TotLostCases">0</span>
                                        <h3>Lost Cases</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter pink" id="btnMonthlyProcessed">
                                        <div class="counter-icon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <span class="counter-value" id="TotMonthlyProcessed">0</span>
                                        <h3>Monthly Processed Appl</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter pink" id="btnNonFunctionalCard">
                                        <div class="counter-icon">
                                            <i class="fa fa-times-circle"></i>
                                        </div>
                                        <span class="counter-value" id="TotNonFunctionalCard">0</span>
                                        <h3>Non Functional Card</h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter blue" id="btnIssuanceCardReaders">
                                        <div class="counter-icon">
                                            <i class="fa fa-credit-card"></i>
                                        </div>
                                        <h3 style="margin-top:2.0rem!important;">
                                            Issuance of Card Readers
                                        </h3>
                                    </div>
                                </a>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <a href="#" class="clickable">
                                    <div class="counter blue" id="btnLossTransitCases">
                                        <div class="counter-icon">
                                            <i class="fa fa-truck"></i>
                                        </div>
                                        <h3 style="margin-top:2.0rem!important;">
                                            Loss in Transit Cases
                                        </h3>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
    </div>


<div class="modal fade" id="CardReport" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title"><span id="CardReport_lblModelTitle"></span></h4>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer table-hover dataTable" role="grid" id="CardReport_tbldatadialog">
                            <thead></thead>
                        </table>
                    </div>

                </div>
                <div class="col-sm-12" id="msg">
                </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>
<!-- Message Dialog  -->
<div class="modal fade" id="MonthlyProcessedDialog" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="MonthlyProcessedDialogLabel">Choose Reporting Month</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="MonthlyProcessedDialogBody" class="modal-body">
                <div class="col-sm-12">
                    <div class="form-group row mb-2">
                        <label class="col-form-label col-sm-4">Select Month</label>
                        <div class="col-sm-8">
                            <input type="text" id="txtMonthYear" class="form-control readonly dateInputMonthYear" placeholder="MM/YYYY" required />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnMonthlyProcessedDialogOk">Ok</button>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/Report.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />