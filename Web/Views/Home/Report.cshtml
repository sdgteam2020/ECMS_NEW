@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user" };
    List<Claim> claims = ViewBag.UserClaims;
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/report.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > Report &amp; Returns (Cards)
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-card-report-page">
    <div class="containerMain ecms-card-report-container">
        <div class="ecms-card-report-shell">
            <div class="ecms-report-head d-print-none">
                <div class="ecms-report-head-icon">
                    <i class="fa fa-credit-card"></i>
                </div>
                <div>
                    <h2>Report &amp; Returns (Cards)</h2>
                    <p>Card requisition, lost case, monthly processed and non-functional card summary</p>
                </div>
            </div>

            @if (claims.Count > 0 && claims.Any(i => i.Value == "Army Level Reports" || i.Value == "Fmn Level Reports"))
            {
                <div class="ecms-filter-panel section_to_report_toPrint d-print-none" id="section_to_report_toPrint">
                    <div class="row pt-1 SearchTab">
                        <div class="form-group row mb-2 ecms-unit-type-row">
                            <span id="spnclaimId" class="d-none">@(claims.Any(i => i.Value == "Army Level Reports") ? "Army Level Reports" : "Fmn Level Reports")</span>
                            <label class="col-form-label col-md-2 fw-bold">Select Unit Type <i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-md-10 ecms-radio-group">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType1" value="1" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                    <label class="form-check-label" for="UnitType1">Unit</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType2" value="2" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                    <label class="form-check-label" for="UnitType2">Unit(Fmn HQ)</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType3" value="3" @(claims.Any(i => i.Value == "Army Level Reports") ? "" : "disabled") />
                                    <label class="form-check-label" for="UnitType3">Unit(Dte/Branch)</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row SearchTab ecms-filter-grid">
                        <div class="col-sm-3 unittype">
                            <label class="col-form-label fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlCommand" required id="ddlCommand">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 unittype">
                            <label class="col-form-label fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlCorps" required id="ddlCorps">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 unittype">
                            <label class="col-form-label fw-bold">Div/Sub Area<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlDiv" required id="ddlDiv">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 unittype">
                            <label class="col-form-label fw-bold">Bde<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlBde" required id="ddlBde">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 FmnBranch d-none">
                            <label class="col-form-label fw-bold">Type of Fmn /Branch<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlFmnBranch" required id="ddlFmnBranch">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 DteBranch d-none">
                            <label class="col-form-label fw-bold">PSO /Dte <i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlPSODte" required id="ddlPSODte">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3 DteBranch d-none">
                            <label class="col-form-label fw-bold">DG / Sub Dte <i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlDgSubDte" required id="ddlDgSubDte">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <label class="col-form-label fw-bold">Unit<i class="fas fa-asterisk mand1"></i></label>
                            <select class="form-select" name="ddlUnit" required id="ddlUnit">
                                <option value="">All</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (RoleNameList.Contains(ViewBag.Role))
            {
                <div class="ecms-card-report-grid">
                    <div class="ecms-card-report-item">
                        <a href="#" class="clickable">
                            <div class="counter pink ecms-report-counter" id="btnRequisition">
                                <div class="counter-icon">
                                    <i class="fa fa-list-ul"></i>
                                </div>
                                <span class="counter-value" id="TotRequisition">0</span>
                                <h3>New Requisition</h3>
                            </div>
                        </a>
                    </div>
                    <div class="ecms-card-report-item">
                        <a href="#" class="clickable">
                            <div class="counter pink ecms-report-counter" id="btnLostCase">
                                <div class="counter-icon">
                                    <i class="fa fa-question-circle"></i>
                                </div>
                                <span class="counter-value" id="TotLostCases">0</span>
                                <h3>Lost Cases</h3>
                            </div>
                        </a>
                    </div>
                    <div class="ecms-card-report-item">
                        <a href="#" class="clickable">
                            <div class="counter pink ecms-report-counter" id="btnMonthlyProcessed">
                                <div class="counter-icon">
                                    <i class="fa fa-calendar"></i>
                                </div>
                                <span class="counter-value" id="TotMonthlyProcessed">0</span>
                                <h3>Monthly Processed Appl</h3>
                            </div>
                        </a>
                    </div>
                    <div class="ecms-card-report-item">
                        <a href="#" class="clickable">
                            <div class="counter pink ecms-report-counter" id="btnNonFunctionalCard">
                                <div class="counter-icon">
                                    <i class="fa fa-times-circle"></i>
                                </div>
                                <span class="counter-value" id="TotNonFunctionalCard">0</span>
                                <h3>Non Functional Card</h3>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade ecms-card-report-modal" id="CardReport" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span>&times;</span></button>
                <h4 class="modal-title"><span id="CardReport_lblModelTitle"></span></h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <table class="table table-striped table-hover border border-purple" role="grid" id="CardReport_tbldatadialog">
                    </table>
                </div>
                <div class="col-sm-12" id="msg">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-card-report-modal" id="MonthlyProcessedDialog" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="MonthlyProcessedDialogLabel">Choose Reporting Month</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="MonthlyProcessedDialogBody" class="modal-body">
                <div class="col-sm-12">
                    <div class="form-group row mb-2">
                        <label class="col-form-label col-sm-4">Select Month</label>
                        <div class="col-sm-8">
                            <input type="text" id="txtMonthYear" class="form-control readonly dateInputMonthYear" placeholder="MM/YYYY" required />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnMonthlyProcessedDialogOk">Ok</button>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/Report.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
