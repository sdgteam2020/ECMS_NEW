@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Initiate Request DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user" };
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}
<link href="@($"{Cdn}/developercss/requestdashboard.css?v={Ver}")" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                      
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > 
                            @if (ViewBag.PreviousLink == "DashboardUserMgt")
                            {
                                <a href="/Home/DashboardUserMgt" class="mr-2">User Mgt</a>
                            }
                            else
                            {
                                <a href="/Home/SubDashboard" class="mr - 2">I-Card Request</a>
                            }
                        > @ViewBag.Type

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
<span id="Type" name="Type" class="d-none">@ViewBag.Type</span>
    @if (RoleNameList.Contains(ViewBag.Role))
    {
        <div class="row">

            <div class="card p-4">
                <div class="row">

                    @if (ViewBag.Type == "Posting Out")
                    {
                        <div class="col-md-2 col-sm-6">
                            <a href="/Posting/GetPostingOutWithType?Type=MQ==&PostingType=UG9zdGluZ091dA==" class="clickable">
                                <div class="counter blue">
                                    <div class="counter-icon">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <span class="counter-value" id="ToPostingOutOffrs">0</span>
                                    <h3>
                                        Posting Out (Offr<span class="text-lowercase">s</span>)
                                    </h3>

                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-6">
                            <a href="/Posting/GetPostingOutWithType?Type=Mg==&PostingType=UG9zdGluZ091dA==" class="clickable">
                                <div class="counter blue">
                                    <div class="counter-icon">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <span class="counter-value" id="ToPostingOutJCO">0</span>
                                    <h3>
                                        Posting Out (JCO<span class="text-lowercase">s</span>/OR)
                                    </h3>
                                </div>
                            </a>
                        </div>
                    }
                    else if (ViewBag.Type == "Posting In")
                    {
                        <div class="col-md-2 col-sm-6">
                            <a href="/Posting/GetPostingOutWithType?Type=MQ==&PostingType=UG9zdGluZ0lu" class="clickable">
                                <div class="counter blue">
                                    <div class="counter-icon">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <span class="counter-value" id="ToPostingInOffrs">0</span>
                                    <h3>
                                        Posting In (Offr<span class="text-lowercase">s</span>)
                                    </h3>

                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 col-sm-6">
                            <a href="/Posting/GetPostingOutWithType?Type=Mg==&PostingType=UG9zdGluZ0lu" class="clickable">
                                <div class="counter blue">
                                    <div class="counter-icon">
                                        <i class="fa fa-users"></i>
                                    </div>
                                    <span class="counter-value" id="ToPostingInJCO">0</span>
                                    <h3>
                                        Posting In (JCO<span class="text-lowercase">s</span>/OR)
                                    </h3>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
<script src="@($"{Cdn}/developerjs/RequestDashboard.js?v={Ver}")"></script>