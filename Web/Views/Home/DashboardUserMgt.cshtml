@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user", "coordinator", "DteAdmin", "AFSACUser", "RecordUser", "OROUser" };
}
<link asp-href-include="~/developercss/dashboardusermgt.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> &gt; <a href="/Home/Dashboard" class="mr-2">Dashboard</a> &gt; User Management
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-user-mgt-page">
    <div class="containerMain ecms-user-mgt-container">
        @if (RoleNameList.Contains(ViewBag.Role))
        {
            <div class="ecms-user-mgt-shell">
                <div class="ecms-user-mgt-heading">
                    <div class="ecms-user-mgt-heading-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <div>
                        <h2>User Management</h2>
                        <p>Manage users, posting movement, login logs and profile updates</p>
                    </div>
                </div>

                <div class="ecms-user-mgt-grid">
                    <div class="ecms-user-mgt-item">
                        <a href="/Home/RegisterUser" class="clickable">
                            <div class="counter purple ecms-user-counter" id="btnRegisteredUsers">
                                <div class="counter-icon">
                                    <i class="fa fa-users"></i>
                                </div>
                                <span class="counter-value" id="TotRegisterUser">0</span>
                                <h3>Registered Users</h3>
                            </div>
                        </a>
                    </div>

                    <div class="ecms-user-mgt-item">
                        <a href="/Home/RequestDashboard/UG9zdGluZyBJbg==" class="clickable">
                            <div class="counter red ecms-user-counter" id="btnPostingIn">
                                <div class="counter-icon">
                                    <i class="fa fa-sign-in"></i>
                                </div>
                                <span class="counter-value" id="TotPostingIn">0</span>
                                <h3>Posting In</h3>
                            </div>
                        </a>
                    </div>

                    <div class="ecms-user-mgt-item">
                        <a href="/Home/RequestDashboard/UG9zdGluZyBPdXQ=" class="clickable">
                            <div class="counter red ecms-user-counter" id="btnPostingOut">
                                <div class="counter-icon">
                                    <i class="fa fa-sign-out"></i>
                                </div>
                                <span class="counter-value" id="TotPostingOut">0</span>
                                <h3>Posting Out</h3>
                            </div>
                        </a>
                    </div>

                    <div class="ecms-user-mgt-item">
                        <a href="/Log/LoginLog" class="clickable">
                            <div class="counter pink ecms-user-counter no-count" id="btnLoginLogs">
                                <div class="counter-icon">
                                    <i class="fa fa-history"></i>
                                </div>
                                <span class="ecms-action-spacer" aria-hidden="true"></span>
                                <h3 class="counter-title">Login Logs</h3>
                            </div>
                        </a>
                    </div>

                    <div class="ecms-user-mgt-item">
                        <a href="/UserProfile/Profile" class="clickable">
                            <div class="counter pink ecms-user-counter no-count" id="btnUpdateProfile">
                                <div class="counter-icon">
                                    <i class="fa fa-user"></i>
                                </div>
                                <span class="ecms-action-spacer" aria-hidden="true"></span>
                                <h3 class="counter-title">Update Profile</h3>
                            </div>
                        </a>
                    </div>

                    @if (ViewBag.ROFound == 1)
                    {
                        <div class="ecms-user-mgt-item">
                            <a href="/Master/UpdateRecordOffice" class="clickable">
                                <div class="counter pink ecms-user-counter no-count" id="btnUpdateRecordOffice">
                                    <div class="counter-icon">
                                        <i class="fa fa-building"></i>
                                    </div>
                                    <span class="ecms-action-spacer" aria-hidden="true"></span>
                                    <h3 class="counter-title">Update Record Office</h3>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script asp-src-include="~/developerjs/DashboardUserMgt.js"></script>
