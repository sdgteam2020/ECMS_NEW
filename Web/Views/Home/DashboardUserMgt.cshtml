@{
    ViewData["Title"] = "DashBoard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<string> RoleNameList = new List<string>() { "user", "coordinator", "DteAdmin", "AFSACUser", "RecordUser", "OROUser" };
}
<style>
    .clickable {
        height: 190px;
        width: 190px;
        display: block;
    }
</style>

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a>  > User Management

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    @if (RoleNameList.Contains(ViewBag.Role))
    {
        <div class="row">
            <div class="card p-4">
                <div class="row">
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/RegisterUser" class="clickable">
                            <div class="counter purple">
                                <div class="counter-icon">
                                    <i class="fa fa-users"></i>
                                </div>
                                <span class="counter-value" id="TotRegisterUser">0</span>
                                <h3>Registered Users</h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/RequestDashboard/UG9zdGluZyBJbg==" class="clickable">
                            <div class="counter red">
                                <div class="counter-icon">
                                    <i class="fa fa-reply"></i>
                                </div>
                                <span class="counter-value" id="TotPostingIn">0</span>
                                <h3>Posting In</h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Home/RequestDashboard/UG9zdGluZyBPdXQ=" class="clickable">
                            <div class="counter red">
                                <div class="counter-icon">
                                    <i class="fa fa-share"></i>
                                </div>
                                <span class="counter-value" id="TotPostingOut">0</span>
                                <h3>Posting Out</h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/Log/LoginLog" class="clickable">
                            <div class="counter pink">
                                <div class="counter-icon">
                                    <i class="fa fa-address-card"></i>
                                </div>
                                <h3 style="margin-top:3.0rem!important;">
                                    Login Logs
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <a href="/UserProfile/Profile" class="clickable">
                            <div class="counter pink">
                                <div class="counter-icon">
                                    <i class="fa fa-user"></i>
                                </div>
                                <h3 style="margin-top:3.0rem!important;">
                                    Update Profile
                                </h3>
                            </div>
                        </a>
                    </div>
                    @if (ViewBag.ROFound == 1)
                    {
                        <div class="col-md-2 col-sm-6">
                            <a href="/Master/UpdateRecordOffice" class="clickable">
                                <div class="counter pink">
                                    <div class="counter-icon">
                                        <i class="fa fa-user"></i>
                                    </div>
                                    <h3 style="margin-top:3.0rem!important;">
                                        Update Record Office
                                    </h3>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
<script asp-src-include="~/developerjs/DashboardUserMgt.js"></script>