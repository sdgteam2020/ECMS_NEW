@{
    ViewData["Title"] = "Add Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/userprofile_profile.css" rel="stylesheet" />
@if (@ViewBag.Role == "admin")
{
    <header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
        <div class="containerMain">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between">
                    <div class="col-auto">
                        <h1 class="page-header-title">
                            <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                            <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> >Profile Details

                        </h1>
                    </div>
                </div>

            </div>
        </div>
    </header>
}
else
{
    <header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
        <div class="containerMain">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between">
                    <div class="col-auto">
                        <h1 class="page-header-title">
                            <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                            <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2"> User Mgt</a> >Profile Details

                        </h1>
                    </div>
                </div>

            </div>
        </div>
    </header>
}

<div class="containerMain mt-n10">
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <div class="row">
                        <div class="col-xl-12 text-left">
                            <h3>
                                Profile Mapping Details
                                <small class="text-muted"> </small>


                            </h3>
                        </div>


                    </div>
                </div>
                <div class="card-body card-body-min-height">
                    <div class="row">
                        <form action="" id="SaveFormProfile" method="post" name="SaveForm">
                            <div class="row">
                                <span class="d-none" id="spnUserId">0</span>
                                <span class="d-none" id="spnTDMId">0</span>
                                <div class="row">
                                    <div class="col-md-6 ">
                                        <div class="card minheight cardbg mb-2 mt-2">
                                            <div class="seven">
                                                <h1>Unit Mapping Details</h1>
                                            </div>
                                            <div class="mt-2 ml-4 ">

                                                <div class="row">
                                                    <div class="col-sm-6 ">
                                                        <div class="form-group row mb-2">
                                                            <span id="spnUnitIdUserPro" class="d-none"></span>
                                                            <label class="col-form-label col-sm-4 labelprofile">Unit</label>
                                                            <div class="col-sm-8">
                                                                <label id="lblProUnit" class="col-form-label"></label>

                                                            </div>
                                                            @*  <div class="col-sm-2">
                                                            <button type="button" class="btn btn-icon btn-round btn-warning" id="btnProUnitAdd"><i class="fas fa-plus"></i></button>
                                                            </div> *@
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4  labelprofile">SUS No</label>
                                                            <div class="col-sm-8">

                                                                <label id="lblProSusno" class="col-form-label"></label>
                                                                @* <input class="form-control Alphanumeric" placeholder="Enter SUS No" id="txtProSusno" required pattern="^[a-zA-Z0-9 ]*$" maxlength="8" title="Only Alphabets and Numbers allowed" /> *@
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Unit Type</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label " id="lblunittype"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnUnit">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Comd</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label " id="lblProComd"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnUnit">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Corps</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblProCorps"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnUnit">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Div</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblProDiv"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnUnit">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Bde</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblPrBde"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnDteBranch">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">PSO/Dte</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblpso"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnDteBranch">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Dte/Addl Det</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblDg"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 spnFmnBranch">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Fmn Branch</label>
                                                            <div class="col-sm-8">
                                                                <label class="col-form-label" id="lblFmnBranch"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 ">
                                        <div class="card cardbg minheight mb-2 mt-2">
                                            <div class="seven">
                                                <h1>Domain Details</h1>
                                            </div>
                                            <div class="mt-2 ml-4">

                                                <div class="row">
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Mapped Domain ID</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblDomainId" class="col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Army No</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblicno" class="col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Role</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblrole" class="col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Appt</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblAppt" class="lblAppt col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Mapped By</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblMappedBy" class="col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-6 labelprofile">Mapped Date</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblMappedDate" class="col-form-label"></label>

                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 ">
                                        <div class="card cardbg">
                                            <div class="seven">
                                                <h1>Personal information</h1>
                                            </div>
                                            <div class="mt-2 ml-4 p-2">
                                                <div class="row">
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Service No</label>
                                                            <div class="col-sm-4">

                                                                <input class="form-control" placeholder="Enter Army No" id="txtProArmy" required maxlength="8" readonly />
                                                            </div>
                                                            <div class="col-sm-4">
                                                                @* <button type="button" class="btn btn-icon btn-round btn-warning" id="btnProfileSerch"><i class="fas fa-search"></i></button> *@
                                                                @* <button type="button" class="btn btn-primary" id="btngetToken">Get Token</button> *@
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Rank<i class="fas fa-asterisk mand1"></i></label>
                                                            <div class="col-sm-8">

                                                                <select class="form-select full-width" tabindex="-1" name="ddlProRank" required id="ddlProRank">
                                                                    <option value="0">Select Rank </option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Name<i class="fas fa-asterisk mand1"></i></label>
                                                            <div class="col-sm-8">
                                                                <input class="form-control-Alphabets" placeholder="Enter Name" data-toggle="tooltip" id="txtName" required pattern="^[a-zA-Z0-9 ]*$" maxlength="50" title="Only Alphabets and Numbers allowed" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">Appt.</label>
                                                            <div class="col-sm-8">
                                                                <label id="" class="lblAppt col-form-label"></label>
                                                                @* <select class=" js-example-basic-single select2 form-control full-width" tabindex="-1"  name="ddlProAppointment" required id="ddlProAppointment">
                                                                <option value="0">Select Appointment </option>
                                                                </select> *@
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-8 labelprofile">Are you performing the Duties of OC / CO / OC Tps?</label>
                                                            <div class="col-sm-4">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" value="" id="chkIO">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-8 labelprofile">Are you Commanding a Unit/ Sub Unit/ Fmn / Dte?</label>
                                                            <div class="col-sm-4">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" value="" id="chkCO">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
@*                                                     <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-8 labelprofile">
                                                                Are you performing the Duties of CO, Record Office/ Col Records?
                                                            </label>
                                                            <div class="col-sm-4">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" value="" id="chkRO">

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>  *@ 
@*                                                     <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-8 labelprofile">
                                                                Are you performing the Duties of Brig ORO?
                                                            </label>
                                                            <div class="col-sm-4">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" value="" id="chkORO">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div> *@
                                                    <div class="col-sm-4">
                                                        <div class="form-group row mb-2">
                                                            <label class="col-form-label col-sm-4 labelprofile">DSC Token Signature<i class="fas fa-asterisk mand1"></i></label>
                                                            <div class="col-sm-8">
                                                                @* <input id="Thumbprint" class="form-control" readonly /> *@
                                                                <label id="Thumbprint" class="col-form-label"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    </div>
                                    <div class="col-sm-12 text-right mt-2">
                                        <button type="button" class="btn btn-danger mt-4 mr-4" id="btntokenrefresh">
                                            Refresh to Fetch Thumbprint from Token
                                        </button>
                                    <button type="button" class="btn btn-danger mt-4 mr-4" id="btnderegprofile">
                                        Unregister Profile
                                    </button>
                                        <input type="button" class="btn btn-primary mt-4 mr-4" value="Submit" id="btnProfilesave" />
                                    </div>
                                    <div class="col-sm-12 text-center">
                                        <div id="tokenmsg" class="d-grid gap-2 col-4 mx-auto">
                                        </div>
                                    </div>
                                    <div class="col-sm-12" id="msg">
                                    </div>
                                </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="AddNewProfile" tabindex="-1" aria-labelledby="exampleModalLabel" >
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
                    <h5 class="modal-title" id="exampleModalToggleLabel">Update Profile  </h5>
                </div>

                <div class="modal-body">
                </div>

            </div><!-- modal-content -->
        </div><!-- modal-dialog -->
    </div>
</div>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/profile.js"></script>
<script asp-src-include="~/developerjs/token.js"></script>

<div class="modal fade" id="DeRegisterConfirmModal" tabindex="-1" aria-labelledby="exampleModalLabel"  data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Unregister Profile</h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="row fw-bold">
                    Are you Sure you want to Unregister your profile?
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" id="btnDeRegisterConfirmModalSubmit">Yes</button>
            </div>
        </div>
    </div>
</div>