@inject IConfiguration configuration;
@using DataTransferObject.Response
@model DTOPostingOutDetailByIdResponse
@{
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<link href="@($"{Cdn}/developercss/postingin.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<link href="@($"{Cdn}/select2/css/select2.min.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/InitiateRequest" class="mr-2">Request</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> > Posting Out

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span>
            @*<span id="PtoId" class="d-none">0</span>*@
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                       Posting Out Indl Army No
                        <small class="text-muted"><span id="iarmynopostingin"></span></small>
                        
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row g-3 row-deck mb-3">

                @* <div class="card p-4">
                <div class="mt-2">

                </div>
                </div> *@
               
                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <span class="spnToUserID d-none">0</span>
                    <span class="spnRequestId d-none">0</span>
                    <span class="spnTrnFwdId d-none">0</span>

                    <div class="row">
                        <div class="col-md-12 ">
                            <div class="card cardbg minheight mb-2 mt-2">
                                <div class="seven">
                                    <h1>Posting Out</h1>
                                </div>
                                <div class="mt-2 ml-4">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="seven">
                                                <h1>Personal Details</h1>
                                            </div>
                                        <div class="col-sm-12 text-center">
                                            <img src="" id="pstimage" height="180" class=" border border-primary" />
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="form-group row mb-2">
                                                <label class="col-form-label col-sm-4 labelprofile">First Name</label>
                                                <div class="col-sm-8">
                                                    <label id="lblFName" class="col-form-label"></label>
                                                </div>
                                            </div>
                                        </div>
                                            <div class="col-sm-12">
                                                <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">Last Name</label>
                                                    <div class="col-sm-8">
                                                        <label id="lblLName" class="col-form-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        <div class="col-sm-12">
                                            <div class="form-group row mb-2">
                                                <label class="col-form-label col-sm-4 labelprofile">Category</label>
                                                <div class="col-sm-8">
                                                    <label id="lblCategory" class="col-form-label"></label>

                                                </div>

                                            </div>
                                        </div>
                                      
                               
                                        
                                        <div class="col-sm-12">
                                            <div class="form-group row mb-2">
                                                <label class="col-form-label col-sm-4 labelprofile">Status of I Card</label>
                                                <div class="col-sm-8">
                                                    <label id="lblStatusofInds" class="col-form-label"></label>

                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <div class="form-group row mb-2">
                                                    <label class="col-form-label col-sm-4 labelprofile">Appl Id</label>
                                                <div class="col-sm-8">
                                                    <label id="lblApplId" class="col-form-label"></label>
                                                </div>

                                            </div>
                                        </div>
      
                                    </div>
                                    <div class="col-sm-8">
                                        <div class="row">
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Posting Type</label>
                                                        <div class="col-sm-8">
                                                            <label class="form-label">Posting Out</label>

                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Reason</label>
                                                        <div class="col-sm-8">
                                                            <select class="form-select" id="ddlpostingReason" required>
                                                                <option value="">Select One</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">Authority</label>
                                                        <div class="col-sm-8">
                                                            <input type="text" id="txtAuthority" class="form-control form-control-Alphabets" placeholder="Enter Authority" maxlength="50" required />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-group row mb-2">
                                                        <label class="col-form-label col-sm-4 labelprofile">SOS Date</label>
                                                        <div class="col-sm-8">
                                                            <input type="text" id="txtSosDate" class="form-control" autocomplete="off" required />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                <div class="seven">
                                                    <h1>From Unit Details</h1>
                                                </div>
                                                <div class="row">
                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Unit/SUS No</label>
                                                                <div class="col-sm-8">
                                                                    <label id="lblUnitname" class="col-form-label"></label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Regd User Dtls</label>
                                                                <div class="col-sm-8">
                                                                    <label id="lblRegdUser" class="col-form-label"></label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Name</label>
                                                                <div class="col-sm-8">
                                                                    <label id="lblFromName" class="col-form-label"></label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Domain Id</label>
                                                                <div class="col-sm-8">
                                                                    <label id="lblFromDomainId" class="col-form-label"></label>

                                                                </div>

                                                            </div>
                                                        </div>
                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Appt</label>
                                                                <div class="col-sm-8">
                                                                    <label id="lblAppt" class="col-form-label"></label>

                                                                </div>

                                                            </div>
                                                        </div>
                                                </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="seven">
                                                        <h1>To Unit Details</h1>
                                                    </div>
                                                    <div class="row">

                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Unit Name</label>
                                                                <div class="col-sm-8">
                                                                    <input type="text" class="form-control alpha-num-only" id="postingoutUnitName" placeholder="Serch with SUS No" maxlength="50" required />
                                                                    <span class="d-none" id="postingoutUnitId"></span>
                                                                </div>

                                                            </div>
                                                        </div>

                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Army No</label>
                                                                <div class="col-sm-8">
                                                                    <select class="form-select" id="ddlaspnetiserpostout" required>
                                                                        <option value="">Select One</option>

                                                                    </select>

                                                                </div>

                                                            </div>
                                                        </div>

                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Name</label>
                                                                <div class="col-sm-8">
                                                                    <label class="form-label" id="lblToName"></label>

                                                                </div>

                                                            </div>
                                                        </div>

                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Domain Id</label>
                                                                <div class="col-sm-8">
                                                                    <label class="form-label" id="lblToDomainId"></label>

                                                                </div>

                                                            </div>
                                                        </div>

                                                        <div class="col-sm-12">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Appt</label>
                                                                <div class="col-sm-8">
                                                                    <label class="form-label" id="lbltoAppt"></label>

                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-12">
                                                    <div class="seven">
                                                        <h1>Dispatch Details</h1>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-sm-6">
                                                            <div class="form-group row mb-2">
                                                                <label class="col-form-label col-sm-4 labelprofile">Dispatch Date</label>
                                                                <div class="col-sm-8">
                                                                    <input type="text" id="txtDispatchDate" class="form-control"/>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-sm-6">
                                                            <div class="form-group row mb-2">   
                                                                <label class="col-form-label col-sm-4 labelprofile">Ref No Regd SDS</label>
                                                                <div class="col-sm-8">
                                                                    <input type="text" id="txtRefNo" placeholder="Enter Dispatch Date" class="form-control alpha-num-only form-space" placeholder="Enter Ref No Regd SDS" maxlength="20" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                               
                                         </div>


                                    </div>


                                        <div class="col-md-12 text-center mb-4">
                                            <input type="button" class="btn btn-primary" id="btnPostingOut" value="Posting Out" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
               </form>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/pastingin.js?v={configuration["StaticVersion"]}")"></script>
<script src="@($"{Cdn}/developerjs/mtables.js?v={configuration["StaticVersion"]}")"></script>
<script src="@($"{Cdn}/select2/js/select2.min.js?v={configuration["StaticVersion"]}")"></script>