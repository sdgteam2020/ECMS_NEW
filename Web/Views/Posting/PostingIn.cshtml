@using DataTransferObject.Response
@model DTOPostingOutDetailByIdResponse
<link asp-href-include="~/developercss/postingin.css" rel="stylesheet" />
<link asp-href-include="~/select2/css/select2.min.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/InitiateRequest" class="mr-2">Request</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> > Posting Out

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-postingin-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-postingin-shell ecms-card ecms-card-body">

        <span id="SpnTxnId" class="d-none">0</span>

        <div class="ecms-postingin-header ecms-page-title">
            <div class="ecms-postingin-title-wrap">
                <span class="ecms-postingin-title-icon ecms-title-icon">
                    <i class="fa fa-sign-out-alt"></i>
                </span>

                <div>
                    <h3>Posting Out</h3>
                    <p class="ecms-title-subtitle">
                        Record individual posting movement, destination unit and dispatch details
                    </p>
                </div>
            </div>

            <span class="ecms-postingin-armyno badge badge-primary">
                <i class="fa fa-id-card"></i>
                Army No:
                <strong id="iarmynopostingin"></strong>
            </span>
        </div>

        <form action=""
              id="SaveForm"
              method="post"
              name="SaveForm"
              class="ecms-postingin-form">

            <span class="spnToUserID d-none">0</span>
            <span class="spnRequestId d-none">0</span>
            <span class="spnTrnFwdId d-none">0</span>

            <div class="ecms-postingin-grid">

                <!-- Personal Details -->
                <section class="ecms-postingin-profile ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-user"></i>
                        Personal Details
                    </h5>

                    <div class="ecms-postingin-profile-body">

                        <div class="ecms-postingin-photo-wrap">
                            <img src=""
                                 id="pstimage"
                                 class="ecms-postingin-photo"
                                 alt="Individual photograph" />
                        </div>

                        <div class="ecms-postingin-detail-list">

                            <div class="ecms-postingin-detail-row">
                                <span>First Name</span>
                                <strong id="lblFName"></strong>
                            </div>

                            <div class="ecms-postingin-detail-row">
                                <span>Last Name</span>
                                <strong id="lblLName"></strong>
                            </div>

                            <div class="ecms-postingin-detail-row">
                                <span>Category</span>
                                <strong id="lblCategory"></strong>
                            </div>

                            <div class="ecms-postingin-detail-row">
                                <span>Status of I Card</span>
                                <strong id="lblStatusofInds"></strong>
                            </div>

                            <div class="ecms-postingin-detail-row">
                                <span>Appl Id</span>
                                <strong id="lblApplId"></strong>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- Posting workflow -->
                <div class="ecms-postingin-workflow ecms-min-0">

                    <!-- Posting Details -->
                    <section class="ecms-postingin-section ecms-section">
                        <h5 class="ecms-section-title">
                            <i class="fa fa-exchange-alt"></i>
                            Posting Details
                        </h5>

                        <div class="ecms-postingin-section-body ecms-postingin-form-grid">

                            <div class="ecms-postingin-field">
                                <label>Posting Type</label>
                                <div class="ecms-postingin-readonly">
                                    Posting Out
                                </div>
                            </div>

                            <div class="ecms-postingin-field">
                                <label for="ddlpostingReason">Reason</label>
                                <select class="form-select"
                                        id="ddlpostingReason"
                                        required>
                                    <option value="">Select One</option>
                                </select>
                            </div>

                            <div class="ecms-postingin-field">
                                <label for="txtAuthority">Authority</label>
                                <input type="text"
                                       id="txtAuthority"
                                       class="form-control form-control-Alphabets"
                                       placeholder="Enter Authority"
                                       maxlength="50"
                                       required />
                            </div>

                            <div class="ecms-postingin-field">
                                <label for="txtSosDate">SOS Date</label>
                                <input type="text"
                                       id="txtSosDate"
                                       class="form-control"
                                       autocomplete="off"
                                       required />
                            </div>

                        </div>
                    </section>


                    <!-- Unit details -->
                    <div class="ecms-postingin-unit-grid">

                        <!-- From Unit -->
                        <section class="ecms-postingin-section ecms-section">
                            <h5 class="ecms-section-title">
                                <i class="fa fa-building"></i>
                                From Unit Details
                            </h5>

                            <div class="ecms-postingin-section-body ecms-postingin-unit-body">

                                <div class="ecms-postingin-detail-row">
                                    <span>Unit/SUS No</span>
                                    <strong id="lblUnitname"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Regd User Dtls</span>
                                    <strong id="lblRegdUser"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Name</span>
                                    <strong id="lblFromName"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Domain Id</span>
                                    <strong id="lblFromDomainId"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Appt</span>
                                    <strong id="lblAppt"></strong>
                                </div>

                            </div>
                        </section>


                        <!-- To Unit -->
                        <section class="ecms-postingin-section ecms-section">
                            <h5 class="ecms-section-title">
                                <i class="fa fa-map-marker-alt"></i>
                                To Unit Details
                            </h5>

                            <div class="ecms-postingin-section-body ecms-postingin-unit-body">

                                <div class="ecms-postingin-field ecms-postingin-field-inline">
                                    <label for="postingoutUnitName">Unit Name</label>
                                    <div>
                                        <input type="text"
                                               class="form-control alpha-num-only"
                                               id="postingoutUnitName"
                                               placeholder="Search with SUS No"
                                               maxlength="50"
                                               required />
                                        <span class="d-none" id="postingoutUnitId"></span>
                                    </div>
                                </div>

                                <div class="ecms-postingin-field ecms-postingin-field-inline">
                                    <label for="ddlaspnetiserpostout">Army No</label>
                                    <select class="form-select"
                                            id="ddlaspnetiserpostout"
                                            required>
                                        <option value="">Select One</option>
                                    </select>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Name</span>
                                    <strong id="lblToName"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Domain Id</span>
                                    <strong id="lblToDomainId"></strong>
                                </div>

                                <div class="ecms-postingin-detail-row">
                                    <span>Appt</span>
                                    <strong id="lbltoAppt"></strong>
                                </div>

                            </div>
                        </section>

                    </div>


                    <!-- Dispatch Details -->
                    <section class="ecms-postingin-section ecms-section">
                        <h5 class="ecms-section-title">
                            <i class="fa fa-truck"></i>
                            Dispatch Details
                        </h5>

                        <div class="ecms-postingin-section-body ecms-postingin-form-grid">

                            <div class="ecms-postingin-field">
                                <label for="txtDispatchDate">Dispatch Date</label>
                                <input type="text"
                                       id="txtDispatchDate"
                                       class="form-control"
                                       autocomplete="off" />
                            </div>

                            <div class="ecms-postingin-field">
                                <label for="txtRefNo">Ref No Regd SDS</label>
                                <input type="text"
                                       id="txtRefNo"
                                       placeholder="Enter Ref No Regd SDS"
                                       class="form-control alpha-num-only form-space"
                                       maxlength="20" />
                            </div>

                        </div>
                    </section>


                    <div class="ecms-postingin-actions ecms-form-actions">
                        <input type="button"
                               class="btn btn-primary"
                               id="btnPostingOut"
                               value="Posting Out" />
                    </div>

                </div>
            </div>

        </form>

    </div>
</div>

<script asp-src-include="~/developerjs/PostingIn.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/select2/js/select2.min.js"></script>