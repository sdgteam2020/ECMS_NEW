<link asp-href-include="~/developercss/applicationclose.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/InitiateRequest" class="mr-2">Request</a> > <a href="/Home/Request" class="mr-2">Initiate Request</a> > Appl Close
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10 ecms-appclose-page ecms-page ecms-page-full ecms-fit-screen">
    <div class="ecms-appclose-shell ecms-card ecms-card-body">

        <div class="ecms-appclose-header ecms-page-title">
            <div class="ecms-appclose-title-wrap">
                <span class="ecms-appclose-title-icon ecms-title-icon">
                    <i class="fa fa-times-circle"></i>
                </span>

                <div>
                    <h3>Application Close</h3>
                    <p class="ecms-title-subtitle">
                        Review individual details and submit the application closure request
                    </p>
                </div>
            </div>

            <span class="ecms-appclose-armyno badge badge-primary">
                <i class="fa fa-id-card"></i>
                Army No:
                <strong id="iarmynopostingin"></strong>
            </span>
        </div>

        <form action=""
              id="SaveForm"
              method="post"
              name="SaveForm"
              class="ecms-appclose-form">

            <div class="ecms-appclose-grid">

                <!-- Personal Details -->
                <section class="ecms-appclose-profile ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-user"></i>
                        Personal Details
                    </h5>

                    <div class="ecms-appclose-profile-body">

                        <div class="ecms-appclose-photo-wrap">
                            <img src=""
                                 id="pstimage"
                                 class="ecms-appclose-photo"
                                 alt="Individual photograph" />
                        </div>

                        <div class="ecms-appclose-detail-list">

                            <div class="ecms-appclose-detail-row">
                                <span>First Name</span>
                                <strong id="lblFName"></strong>
                            </div>

                            <div class="ecms-appclose-detail-row">
                                <span>Last Name</span>
                                <strong id="lblLName"></strong>
                            </div>

                            <div class="ecms-appclose-detail-row">
                                <span>Category</span>
                                <strong id="lblCategory"></strong>
                            </div>

                            <div class="ecms-appclose-detail-row">
                                <span>Status of I Card</span>
                                <strong id="lblStatusofInds"></strong>
                            </div>

                            <div class="ecms-appclose-detail-row">
                                <span>Appl Id</span>
                                <strong id="lblApplId"></strong>
                            </div>

                        </div>
                    </div>
                </section>


                <!-- Application Close Details -->
                <section class="ecms-appclose-details ecms-section ecms-min-0">
                    <h5 class="ecms-section-title">
                        <i class="fa fa-lock"></i>
                        Appl Close Details
                    </h5>

                    <div class="ecms-appclose-details-body">

                        <div class="ecms-appclose-control-row">
                            <label>Posting Type</label>

                            <div class="ecms-appclose-readonly">
                                Appl Close
                            </div>
                        </div>

                        <div class="ecms-appclose-control-row">
                            <label for="ddlpostingReason">Reason</label>

                            <div class="ecms-appclose-field-wrap">
                                <select class="form-select full-width"
                                        id="ddlpostingReason"
                                        required>
                                    <option value="">Select One</option>
                                </select>
                            </div>
                        </div>

                        <div class="ecms-appclose-control-row">
                            <label for="txtAuthority">Authority</label>

                            <div class="ecms-appclose-field-wrap">
                                <input type="text"
                                       id="txtAuthority"
                                       class="form-control form-control-Alphabets"
                                       placeholder="Enter Authority"
                                       maxlength="50"
                                       required />
                            </div>
                        </div>

                        <div class="ecms-appclose-control-row ecms-appclose-remarks-row">
                            <label for="txtremarks">Remarks</label>

                            <div class="ecms-appclose-field-wrap">
                                <input type="text"
                                       id="txtremarks"
                                       class="form-control alpha-num-only"
                                       maxlength="50"
                                       placeholder="Enter Remarks" />
                            </div>
                        </div>

                        <div class="ecms-appclose-actions ecms-form-actions">
                            <input type="button"
                                   class="btn btn-danger"
                                   id="btnApplicationClose"
                                   value="Appl Close" />
                        </div>

                    </div>
                </section>

            </div>

        </form>

    </div>
</div>

<script asp-src-include="~/developerjs/apllclose.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>