@model IEnumerable<DataTransferObject.Response.DTOPostingOutDetilsResponse>

@{
    ViewData["Title"] = "GetPostingOut";

    string pageTitle = "Posting Details";
    string pageSubTitle = "Posting movement records and dispatch status";
    string postingIcon = "fa fa-exchange";

    if (ViewBag.Type == 1 && ViewBag.PostingType == "PostingOut")
    {
        pageTitle = "Posting Out Offrs Details";
        pageSubTitle = "Officer posting out records with dispatch detail status";
        postingIcon = "fa fa-sign-out";
    }
    else if (ViewBag.Type == 2 && ViewBag.PostingType == "PostingOut")
    {
        pageTitle = "Posting Out JCOs/OR Details";
        pageSubTitle = "JCOs/OR posting out records with dispatch detail status";
        postingIcon = "fa fa-sign-out";
    }
    else if (ViewBag.Type == 1 && ViewBag.PostingType == "PostingIn")
    {
        pageTitle = "Posting In (Offrs) Details";
        pageSubTitle = "Officer posting in records and movement status";
        postingIcon = "fa fa-sign-in";
    }
    else if (ViewBag.Type == 2 && ViewBag.PostingType == "PostingIn")
    {
        pageTitle = "Posting In (JCOs/OR) Details";
        pageSubTitle = "JCOs/OR posting in records and movement status";
        postingIcon = "fa fa-sign-in";
    }
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/getpostingoutwithtype.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        @if (ViewBag.Type == 1 && ViewBag.PostingType == "PostingOut")
                        {
                            <div><a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2">User Management</a> > <a href="/Home/RequestDashboard/UG9zdGluZyBPdXQ=" class="mr-2">Posting Out</a> > Posting Out Offrs</div>
                        }
                        else if (ViewBag.Type == 2 && ViewBag.PostingType == "PostingOut")
                        {
                            <div><a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2">User Management</a> > <a href="/Home/RequestDashboard/UG9zdGluZyBPdXQ=" class="mr-2">Posting Out</a> > Posting Out JCOs/OR</div>
                        }
                        else if (ViewBag.Type == 1 && ViewBag.PostingType == "PostingIn")
                        {
                            <div><a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2">User Management</a> > <a href="/Home/RequestDashboard/UG9zdGluZyBJbg==" class="mr-2">Posting In</a> > Posting In Offrs</div>
                        }
                        else if (ViewBag.Type == 2 && ViewBag.PostingType == "PostingIn")
                        {
                            <div><a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2">User Management</a> > <a href="/Home/RequestDashboard/UG9zdGluZyBJbg==" class="mr-2">Posting In</a> > Posting In JCOs/OR</div>
                        }
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-posting-type-page">
    <div class="ecms-posting-container">
        <div class="card mb-3 ecms-posting-shell">
            <div class="card-header ecms-posting-heading">
                <div class="ecms-posting-heading-icon">
                    <i class="@postingIcon"></i>
                </div>
                <div>
                    <h3>@pageTitle</h3>
                    <small>@pageSubTitle</small>
                </div>
            </div>

            <div class="card-body card-body-min-height ecms-posting-body">
                <div class="ecms-posting-toolbar">
                    <h6 class="ecms-total-records mb-0">
                        <span>Total Records</span>
                        <label id="lblTotal">0</label>
                    </h6>
                    <div class="ecms-toolbar-actions">
                        @* <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-sm mr-2"><i class="fa fa-plus mr-1 font-weight-700"></i>Add</button> *@
                    </div>
                </div>

                <div class="ecms-posting-table-wrap">
                    <table class="table table-striped table-hover border border-purple ecms-posting-table" role="grid" id="tbldata"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-posting-modal" id="AddDispatchDetails" tabindex="-1" aria-labelledby="exampleModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">
                    <i class="fa fa-truck mr-2"></i>Add Dispatch Details
                </h5>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <form action="" id="SaveDispatchDetails" name="SaveDispatchDetails" method="post">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group ecms-form-group">
                                <label for="txtDispatchDate" class="fw-bold">Dispatch Date<i class="fas fa-asterisk mand1"></i></label>
                                <input type="text" id="txtDispatchDate" placeholder="Select dispatch date" class="form-control alpha-num-only" autocomplete="off" required />
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group ecms-form-group">
                                <label for="txtRefNo" class="fw-bold">Ref No Regd SDS<i class="fas fa-asterisk mand1"></i></label>
                                <input type="text" id="txtRefNo" class="form-control" placeholder="Enter reference number" maxlength="20" required />
                            </div>
                        </div>
                        <div class="col-sm-12 text-right ecms-modal-actions">
                            <input type="button" class="btn btn-outline-primary" value="Save" id="btnDispatchDetailsAddButton" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/GetPostingOutWithType.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
