@inject IConfiguration configuration;
@{
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}
<link href="@($"{Cdn}/developercss/appcloselist.css?v={Ver}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <div>
                            <a href="/Home/Index" class="mr-2">Home</a> >
                            <a href="/Home/Dashboard" class="mr-2">Dashboard</a> >
                            <a href="/Home/SubDashboard" class="mr - 2">I-Card Request</a> >@ViewBag.Title
                        </div>
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span class="d-none" id="spnapplyFor">@ViewBag.applyFor</span>
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        @ViewBag.Title
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height">
            <div class="row">
                <div class="col-xl-12">
                    <table id="tbldata" class="table table-striped table-hover border border-purple">
                    </table>
                </div>
            </div>
        </div><!-- Row End -->
    </div>
</div>

@section Scripts{
    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
    <script src="@($"{Cdn}/developerjs/appcloselist.js?v={Ver}")"></script>
}