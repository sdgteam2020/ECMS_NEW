<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/appcloselist.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <div>
                            <a href="/Home/Index" class="mr-2">Home</a> &gt;
                            <a href="/Home/Dashboard" class="mr-2">Dashboard</a> &gt;
                            <a href="/Home/SubDashboard" class="mr-2">I-Card Request</a> &gt; @ViewBag.Title
                        </div>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="ecms-page-full ecms-fit-screen ecms-footer-safe ecms-appclose-page">
    <span class="d-none" id="spnapplyFor">@ViewBag.applyFor</span>

    <div class="ecms-card ecms-appclose-card">
        <div class="ecms-card-body ecms-appclose-card-body">
            <div class="ecms-page-title ecms-appclose-title d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3 ecms-min-0">
                    <div class="ecms-title-icon" aria-hidden="true">
                        <i class="fa fa-times-circle"></i>
                    </div>
                    <div class="ecms-min-0">
                        <h2>@ViewBag.Title</h2>
                        <p class="ecms-title-subtitle">Closed application records and authorization summary</p>
                    </div>
                </div>

            </div>

            <section class="ecms-section ecms-appclose-section" aria-labelledby="closedRecordsTitle">
                <h3 class="ecms-section-title" id="closedRecordsTitle">
                    <i class="fa fa-list" aria-hidden="true"></i>
                    <span>Closed Application Records</span>
                </h3>

                <div class="ecms-dt-wrap ecms-min-0">
                    <table id="tbldata"
                           class="table table-striped table-hover ecms-dt-table ecms-appclose-table"
                           aria-label="Closed application records">
                    </table>
                </div>
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="~/Views/Shared/_DataTableJS.cshtml" />
    <script asp-src-include="~/developerjs/appcloselist.js"></script>
}
