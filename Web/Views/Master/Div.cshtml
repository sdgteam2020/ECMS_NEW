@{
    ViewData["Title"] = "Div";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/div.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Div / Branch / SubArea Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-div-page">
    <div class="ecms-div-shell">
        <div class="ecms-div-titlebar">
            <div class="ecms-div-title-wrap">
                <span class="ecms-div-title-icon"><i class="fa fa-sitemap"></i></span>
                <div>
                    <h3>Div / Branch / SubArea Details</h3>
                    <p>Create, update and manage division / branch / sub area records</p>
                </div>
            </div>
            <span class="ecms-div-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-div-form-card">
            <span id="SpnTxnId" class="d-none">0</span>
            <span class="spnBdeCatId d-none">0</span>

            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="ecms-div-form-grid">
                    <div class="ecms-div-field">
                        <label class="ecms-div-label" for="ddlCommand">
                            <i class="fa fa-university"></i>
                            Comd / PSO
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <select class="form-select full-width"
                                name="ddlCommand"
                                required
                                id="ddlCommand">
                            <option value="0">Select Comd / PSO</option>
                        </select>
                    </div>

                    <div class="ecms-div-field">
                        <label class="ecms-div-label" for="ddlCorps">
                            <i class="fa fa-map-marker"></i>
                            Corps / Dte / Area
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <select class="form-select full-width"
                                name="ddlCorps"
                                required
                                id="ddlCorps">
                            <option value="0">Select Corps / Dte / Area</option>
                        </select>
                    </div>

                    <div class="ecms-div-field">
                        <label class="ecms-div-label" for="txtDivName">
                            <i class="fa fa-code-fork"></i>
                            Div / Branch / Sub Area
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric"
                               placeholder="Enter Div"
                               id="txtDivName"
                               maxlength="20"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-div-actions" id="msg">
                        <input type="button" class="btn btn-outline-primary ecms-div-save" value="Save" id="btnsave" />
                        <button type="button" id="btnReset" class="btn btn-outline-danger ecms-div-reset">Reset</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="ecms-div-table-card">
            <div class="ecms-div-table-title">
                <span><i class="fa fa-list"></i> Div / Branch / SubArea Records</span>
            </div>

            <div class="ecms-div-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/Div.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
