@{
    ViewData["Title"] = "Div";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/div.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Div / Branch / SubArea Details
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span>
             
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Div / Branch / SubArea Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="row">
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select full-width"  name="ddlCommand" required id="ddlCommand">
                                    <option value="0">Select Comd / PSO </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <span class="spnBdeCatId d-none">0</span>
                            <label class="col-form-label col-sm-6 fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select full-width"  name="ddlCorps" required id="ddlCorps">
                                    <option value="0">Select Corps / Dte / Area </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Div  /Branch / Sub Area<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <input class="form-control Alphanumeric" placeholder="Enter Div" id="txtDivName" maxlength="20" required pattern="^[a-zA-Z0-9 ]*$" title="Only Alphabets and Numbers allowed" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-12">
                        <div class="col-sm-12" id="msg">
                        <div class="col-sm-12 d-flex justify-content-end">
                            <input type="button" class="btn btn-outline-primary mr-2" value="Save" id="btnsave"  />
                            <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                        </div>
                        </div>
                    </div>
                </div>
            </form>
            <div class="col-xl-12">
                <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                    <h6 class="mb-3 mb-md-0">
                        &nbsp;
                    </h6>
                    <div>
                        &nbsp;
                    </div>
                </div>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/Div.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />