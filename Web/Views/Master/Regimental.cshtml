@{
    ViewData["Title"] = "Create Draft";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-10">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Regt Centre

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Regt Centre  Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body" style="min-height:150px;">
            <div class="row">
                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            Total Regimental Centre  <span id="lblTotal" class="ml-3 border border-light b px-2 py-1">0</span>
                        </h6>
                        <div>
                            <button type="button" id="btnAddRegimental" class="btn btn-outline-success font-weight-600 btn-sm">Add Regt Centre</button>
                            @* <button type="button" id="btnMultiDelete" class="btn btn-outline-danger font-weight-600 btn-sm">Delete</button> *@
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table border border-purple table-striped no-footer dataTable table-hover" role="grid" id="tblData">
                            <thead>
                                <tr>
                                    <th class="noExport d-none"></th>
                                    <th class="wd-40-f">S No</th>
                                    <th class="nowrap">Regimental Centre </th>
                                    <th class="nowrap">Abbreviation</th>
                                    <th class="nowrap">Location</th>
                                    <th class="nowrap">Arms / Service</th>
                                    <th class="nowrap">Unit</th>
                                    <th class="noExport nowrap">Action</th>
                                </tr>
                            </thead>
                            <tbody id="DetailBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/regimental.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="AddNewRegimental" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Enter Regimental Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="SaveRegimental" name="SaveRegimental" method="post">
                        <div class="row">
                            <span class="d-none" id="spnRegId">0</span>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name of Regt Center<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Enter Regimental" id="txtName" oninput="this.value = this.value.toUpperCase();" name="txtName" maxlength="50" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Regt Center is required." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Abbreviation<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Enter Abbreviation" id="txtAbbreviation" name="txtAbbreviation" oninput="this.value = this.value.toUpperCase()" maxlength="10" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Abbreviation is required." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Location<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1" style="height:auto!important;" name="txtLocation" id="txtLocation" rows="2" maxlength="50" data-val-maxlength="Maximum length of Location is 50 character." data-val-maxlength-max="50" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtLocation" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name of Arms, Service & Corps <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlArmType" id="ddlArmType" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Arms, Service & Corps is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Arms</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmType" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="form-group row mb-2">
                                <span id="spnUnitMapId" class="d-none">0</span>
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Type SUS No" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnSaveRegimental" />
                                <button type="button" id="btnResetRegimental" class="btn btn-outline-danger">Reset</button>
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>

                    <div class="col-sm-12" id="msg">
                    </div>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>