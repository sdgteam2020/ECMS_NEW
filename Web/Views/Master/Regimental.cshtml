@{
    ViewData["Title"] = "Regt Centre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/regimental.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Regt Centre Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-regimental-page">
    <div class="ecms-regimental-shell">
        <div class="ecms-regimental-titlebar">
            <div class="ecms-regimental-title-wrap">
                <span class="ecms-regimental-title-icon"><i class="fa fa-flag"></i></span>
                <div>
                    <h3>Regt Centre Details</h3>
                    <p>Create, update and manage regimental centre records</p>
                </div>
            </div>
            <span class="ecms-regimental-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-regimental-toolbar-card">
            <div class="ecms-regimental-toolbar-text">
                <span class="ecms-regimental-toolbar-icon"><i class="fa fa-list"></i></span>
                <div>
                    <h5>Regimental Centre Records</h5>
                    <p>View all regimental centres and add new centre mapping</p>
                </div>
            </div>
            <button type="button" id="btnAddRegimental" class="btn btn-outline-success font-weight-600 btn-sm ecms-regimental-add-btn">
                <i class="fa fa-plus"></i>
                Add Regt Centre
            </button>
        </div>

        <div class="ecms-regimental-table-card">
            <div class="ecms-regimental-table-title">
                <span><i class="fa fa-table"></i> Regt Centre Records</span>
            </div>

            <div class="ecms-regimental-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/regimental.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade ecms-regimental-modal" id="AddNewRegimental" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-regimental-modal-title-wrap">
                    <span class="ecms-regimental-modal-icon"><i class="fa fa-flag"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">Enter Regimental Details</h5>
                        <small>Fill regimental centre, arms/service and unit mapping details</small>
                    </div>
                </div>
                <button type="button" class="close ecms-regimental-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fa fa-times"></i></span>
                </button>
            </div>
            <div class="modal-body">
                <form action="" id="SaveRegimental" name="SaveRegimental" method="post">
                    <div class="ecms-regimental-modal-grid">
                        <div class="ecms-regimental-modal-field">
                            <label class="ecms-regimental-modal-label" for="txtName">
                                <i class="fa fa-building"></i>
                                Name of Regtl Center
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control1 js-uppercase"
                                   placeholder="Enter Regimental"
                                   id="txtName"
                                   name="txtName"
                                   maxlength="50"
                                   data-val="true"
                                   data-val-regex="Regimental name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed."
                                   data-val-required="Regt Center is required."
                                   data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-regimental-modal-field">
                            <label class="ecms-regimental-modal-label" for="txtAbbreviation">
                                <i class="fa fa-font"></i>
                                Abbreviation
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <input class="form-control1 js-uppercase"
                                   placeholder="Enter Abbreviation"
                                   id="txtAbbreviation"
                                   name="txtAbbreviation"
                                   maxlength="10"
                                   data-val="true"
                                   data-val-regex="Abbreviation name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed."
                                   data-val-required="Abbreviation is required."
                                   data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-regimental-modal-field ecms-regimental-modal-field-wide">
                            <label class="ecms-regimental-modal-label" for="txtLocation">
                                <i class="fa fa-map-marker"></i>
                                Location
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <textarea class="form-control1 textarea-auto-height"
                                      name="txtLocation"
                                      id="txtLocation"
                                      rows="2"
                                      maxlength="50"
                                      data-val-maxlength="Maximum length of Location is 50 character."
                                      data-val-maxlength-max="50"
                                      data-val="true"
                                      data-val-regex="Location must contain at least one alphabet. Only A-Z, a-z, 0-9, &, -, /, (, ), dot, comma and single space allowed."
                                      data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/().,\-]+(?: [A-Za-z0-9&\/().,\-]+)*$"></textarea>
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtLocation" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-regimental-modal-field">
                            <label class="ecms-regimental-modal-label" for="ddlArmType">
                                <i class="fa fa-shield"></i>
                                Name of Arms, Service & Corps
                                <i class="fas fa-asterisk mand1"></i>
                            </label>
                            <select class="form-select" name="ddlArmType" id="ddlArmType" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Arms, Service & Corps is required." data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Arms</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmType" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-regimental-modal-field">
                            <label class="ecms-regimental-modal-label" for="txtUnitName">
                                <i class="fa fa-search"></i>
                                SUS No
                            </label>
                            <input class="form-control alpha-num-only"
                                   placeholder="Type SUS No"
                                   id="txtUnitName"
                                   name="txtUnitName"
                                   data-val="true"
                                   data-val-regex="This special chars not allowed for security reasons."
                                   data-val-regex-pattern="^[\w ]*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-regimental-modal-actions">
                            <input type="button" class="btn btn-outline-primary" value="Save" id="btnSaveRegimental" />
                            <button type="button" id="btnResetRegimental" class="btn btn-outline-danger">Reset</button>
                        </div>

                        <div class="ecms-regimental-message" id="msg"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
