@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Bde";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link href="@($"{Cdn}/developercss/bde.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Bde Details

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Bde Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="row">
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select full-width"  name="ddlCommand" required id="ddlCommand">
                                    <option value="0">Select Comd / PSO </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select full-width"  name="ddlCorps" required id="ddlCorps">
                                    <option value="0">Select Corps / Dte / Area </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Div  /Branch / SubArea<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <select class="form-select full-width"  name="ddlDiv" required id="ddlDiv">
                                    <option value="0">Select Div  /Branch / SubArea </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-6 fw-bold">Bde<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-6">
                                <input class="form-control Alphanumeric" placeholder="Enter Bde" id="txtBdeName" maxlength="20" required pattern="^[a-zA-Z0-9 ]*$" title="Only Alphabets and Numbers allowed" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2">
                        <div class="col-sm-12 text-right">
                            <input type="button" class="btn btn-outline-primary  " value="Save" id="btnsave" />
                            <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                        </div>
                        <div class="col-sm-12" id="msg">
                        </div>
                    </div>
                </div>
            </form>
            <div class="col-xl-12">
                <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                    <h6 class="mb-3 mb-md-0">
                        &nbsp;
                    </h6>
                    <div>
                        &nbsp;
                    </div>
                </div>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/mtables.js?v={configuration["StaticVersion"]}")"></script>
<script src="@($"{Cdn}/developerjs/bde.js?v={configuration["StaticVersion"]}")"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />