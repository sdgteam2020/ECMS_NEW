@{
    ViewData["Title"] = "Afsac Cell Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/afsaccellmapping.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10 ecms-afsac-cell-breadcrumb">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Afsac Cell Mapping Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain mt-n10 ecms-afsac-cell-page">
    <div class="ecms-afsac-shell">
        <div class="ecms-afsac-title-card">
            <div class="ecms-title-left">
                <div class="ecms-title-icon">
                    <i class="fa fa-link"></i>
                </div>
                <div>
                    <h3>Afsac Cell Mapping Details</h3>
                    <p>Create, update and manage AFSAC cell linked domain personnel mapping</p>
                </div>
            </div>
            <span class="ecms-title-pill">
                <i class="fa fa-database mr-1"></i> MASTER
            </span>
        </div>

        <div class="ecms-afsac-sub-card">
            <div class="ecms-title-left">
                <div class="ecms-sub-icon">
                    <i class="fa fa-list"></i>
                </div>
                <div>
                    <h5>Afsac Cell Mapping Records</h5>
                    <p>View AFSAC cell mapped domain ID and personnel details</p>
                </div>
            </div>
            <button type="button" id="btnAdd" class="btn ecms-btn-add">
                <i class="fa fa-plus mr-1"></i>Add Afsac Cell Mapping
            </button>
        </div>

        <div class="ecms-afsac-table-card">
            <div class="ecms-section-bar">
                <i class="fa fa-table mr-1"></i>Afsac Cell Mapping Records
            </div>

            <div class="ecms-afsac-table-wrap">
                <span id="SpnTxnId" class="d-none">0</span>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata"></table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/AfsacCellMapping.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade ecms-afsac-modal" id="AddNewAfsacCellMapping" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header ecms-modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-icon"><i class="fa fa-link"></i></span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">Enter Afsac Cell Mapping Details</h5>
                        <p>Fill AFSAC cell SUS number and linked domain personnel details</p>
                    </div>
                </div>
                <button type="button" class="close ecms-modal-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form action="" id="SaveAfsacCellMapping" name="SaveAfsacCellMapping" method="post">
                    <div class="ecms-modal-grid">
                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-search"></i></span>
                                SUS No
                            </label>
                            <input class="form-control alpha-num-only"
                                   placeholder="Type SUS No"
                                   id="txtUnitName"
                                   name="txtUnitName"
                                   data-val="true"
                                   data-val-regex="This special chars not allowed for security reasons."
                                   data-val-regex-pattern="^[\w ]*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="ecms-form-field">
                            <label class="ecms-form-label">
                                <span><i class="fa fa-user"></i></span>
                                Linked Domain ID &amp; Pers Details
                            </label>
                            <select class="form-select full-width"
                                    name="ddlTDMId"
                                    id="ddlTDMId"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Domain Id</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                        </div>
                    </div>

                    <div class="ecms-modal-actions">
                        <input type="button" class="btn ecms-btn-save" value="Save" id="btnAfsacCellMappingAdd" />
                        <button type="button" id="btnAfsacCellMappingReset" class="btn ecms-btn-reset">Reset</button>
                    </div>

                    <div class="col-sm-12" id="msg"></div>
                </form>
            </div>
        </div>
    </div>
</div>
