@{
    ViewData["Title"] = "Afsac Cell Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/afsaccellmapping.css" rel="stylesheet" asp-append-version="true" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between w-100">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars"></i></span>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span class="mx-1">&gt;</span>
                        <span>Afsac Cell Mapping Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="container-fluid ecms-page ecms-page-full ecms-fit-screen ecms-afsac-page">
    <div class="card ecms-card">
        <div class="ecms-card-body">
            <section class="ecms-page-title d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3 ecms-min-0">
                    <span class="ecms-title-icon" aria-hidden="true">
                        <i class="fa fa-link"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h3>Afsac Cell Mapping Details</h3>
                        <p class="ecms-title-subtitle">Create, update and manage AFSAC cell linked domain personnel mapping</p>
                    </div>
                </div>

                <button type="button" id="btnAdd" class="btn btn-success flex-shrink-0">
                    <i class="fa fa-plus mr-1"></i>
                    Add Afsac Cell Mapping
                </button>
            </section>

            <section class="ecms-section ecms-afsac-records">
                <h4 class="ecms-section-title">
                    <i class="fa fa-table" aria-hidden="true"></i>
                    Afsac Cell Mapping Records
                </h4>

                <div class="ecms-dt-wrap">
                    <span id="SpnTxnId" class="d-none">0</span>
                    <table id="tbldata"
                           class="table table-striped table-hover dataTable ecms-dt-table"
                           role="grid"
                           aria-label="Afsac Cell Mapping Records"></table>
                </div>
            </section>
        </div>
    </div>
</main>

<div class="modal fade" id="AddNewAfsacCellMapping" tabindex="-1"
     aria-labelledby="afsacCellModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-afsac-modal-title-wrap">
                    <span class="ecms-afsac-modal-title-icon" aria-hidden="true">
                        <i class="fa fa-link"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h5 class="modal-title" id="afsacCellModalLabel">Enter Afsac Cell Mapping Details</h5>
                        <p class="ecms-afsac-modal-subtitle">Fill AFSAC cell SUS number and linked domain personnel details</p>
                    </div>
                </div>

                <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal"
                        aria-label="Close" title="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form id="SaveAfsacCellMapping" name="SaveAfsacCellMapping" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="txtUnitName" class="form-label ecms-afsac-field-label">
                                <span class="ecms-afsac-field-icon" aria-hidden="true">
                                    <i class="fa fa-search"></i>
                                </span>
                                SUS No
                            </label>
                            <input class="form-control alpha-num-only"
                                   placeholder="Type SUS No"
                                   id="txtUnitName"
                                   name="txtUnitName"
                                   autocomplete="off"
                                   data-val="true"
                                   data-val-regex="This special chars not allowed for security reasons."
                                   data-val-regex-pattern="^[\w ]*$" />
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="txtUnitName"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="ddlTDMId" class="form-label ecms-afsac-field-label">
                                <span class="ecms-afsac-field-icon" aria-hidden="true">
                                    <i class="fa fa-user"></i>
                                </span>
                                Linked Domain ID &amp; Pers Details
                            </label>
                            <select class="form-select full-width"
                                    name="ddlTDMId"
                                    id="ddlTDMId"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Domain Id</option>
                            </select>
                            <span class="text-danger field-validation-valid"
                                  data-valmsg-for="ddlTDMId"
                                  data-valmsg-replace="true"></span>
                        </div>
                    </div>

                    <div class="ecms-afsac-modal-actions">
                        <input type="button" class="btn btn-primary" value="Save" id="btnAfsacCellMappingAdd" />
                        <button type="button" id="btnAfsacCellMappingReset" class="btn btn-danger">Reset</button>
                    </div>

                    <div id="msg"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />
<script asp-src-include="~/developerjs/AfsacCellMapping.js" asp-append-version="true"></script>
