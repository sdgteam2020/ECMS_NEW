@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Afsac Cell Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<link href="@($"{Cdn}/developercss/afsaccellmapping.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Afsac Cell Mapping

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Afsac Cell Mapping  Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height">
            <div class="row">
                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            &nbsp;
                        </h6>
                        <div>
                            <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-md"><i class="fa fa-plus mr-1 font-weight-700" ></i>Add Afsac Cell Mapping</button>
                        </div>
                    </div>
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/AfsacCellMapping.js?v={configuration["StaticVersion"]}")"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="AddNewAfsacCellMapping" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Enter Afsac Cell Mapping Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="SaveAfsacCellMapping" name="SaveAfsacCellMapping" method="post">
                        <div class="row">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <input class="form-control alpha-num-only" placeholder="Type SUS No" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Linked Domain ID & Pers Details</label>
                                <div class="col-sm-8">
                                    <select class="form-select full-width"  name="ddlTDMId" id="ddlTDMId" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Domain Id</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnAfsacCellMappingAdd" />
                                <button type="button" id="btnAfsacCellMappingReset" class="btn btn-outline-danger">Reset</button>
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>

                    <div class="col-sm-12" id="msg">
                    </div>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>