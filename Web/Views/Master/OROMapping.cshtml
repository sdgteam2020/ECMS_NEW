@inject IConfiguration configuration;
@{
    ViewData["Title"] = "ORO Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}

<link href="@($"{Cdn}/select2/css/select2.min.css?v={Ver}")" rel="stylesheet" />
<link href="@($"{Cdn}/developercss/oromapping.css?v={Ver}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > ORO Mapping

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        ORO Mapping  Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row">
                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            &nbsp;
                        </h6>
                        <div>
                            <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-md"><i class="fa fa-plus mr-1 font-weight-700" ></i>Add ORO Mapping</button>
                             

                        </div>
                    </div>
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/mtables.js?v={Ver}")"></script>
<script src="@($"{Cdn}/developerjs/OROMapping.js?v={Ver}")"></script>
<script src="@($"{Cdn}/select2/js/select2.min.js?v={Ver}")"></script>


<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="AddNewOROMapping" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Enter Officer Record Office Mapping Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="SaveOROMapping" name="SaveOROMapping" method="post">
                        <div class="row">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Record Office<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlRO" id="ddlRO" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Record Office is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Record Office</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlRO" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Select Arms</label>
                                <div class="col-sm-8">
                                    <select class="form-control" multiple="" placeholder="Select Arms"   name="ddlArmedIdList" id="ddlArmedIdList" data-val="true" data-val-regex="This special chars and space not allowed for security reasons.">
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmedIdList" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Select Rank</label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlRank" id="ddlRank" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Rank</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlRank" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <input class="form-control alpha-num-only" placeholder="Type SUS No" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Linked Domain ID & Pers Details</label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlTDMId" id="ddlTDMId" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Domain Id</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnOROMappingAdd" />
                                <button type="button" id="btnOROMappingReset" class="btn btn-outline-danger">Reset</button>
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>

                    <div class="col-sm-12" id="msg">
                    </div>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>