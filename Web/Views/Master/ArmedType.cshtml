@{
    ViewData["Title"] = "Arms, Service & Corps";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/DeveloperCSS/armedtype.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row g-0 align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Arms, Service &amp; Corps</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-fluid ecms-page ecms-page-full ecms-fit-screen ecms-armedtype-page">
    <div class="card ecms-card ecms-armedtype-shell">
        <div class="card-body ecms-card-body d-flex flex-column gap-2 h-100 ecms-min-0">

            <div class="ecms-page-title ecms-armedtype-titlebar d-flex align-items-center justify-content-between flex-wrap gap-2 flex-shrink-0">
                <div class="d-flex align-items-center gap-2 ecms-min-0">
                    <span class="ecms-title-icon">
                        <i class="fa fa-shield-alt"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h3>Arms, Service &amp; Corps</h3>
                        <p class="ecms-title-subtitle">Create, update and manage arms/service/corps records</p>
                    </div>
                </div>

                <span class="badge bg-primary ecms-badge ecms-armedtype-pill">
                    <i class="fa fa-database"></i>
                    Master
                </span>
            </div>

            <div class="ecms-section ecms-form-section ecms-armedtype-form-section flex-shrink-0">
                <span id="SpnTxnId" class="d-none">0</span>

                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row g-2 align-items-end">

                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label ecms-armedtype-label" for="txtArmedName">
                                <i class="fa fa-shield-alt"></i>
                                <span>Arms / Service</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <input class="form-control Alphanumeric ecms-armedtype-control"
                                   placeholder="Enter Armed"
                                   id="txtArmedName"
                                   maxlength="100"
                                   required
                                   pattern="^[a-zA-Z0-9 ]*$"
                                   title="Only Alphabets and Numbers allowed" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label ecms-armedtype-label" for="txtAbbreviation">
                                <i class="fa fa-font"></i>
                                <span>Abbreviation</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <input class="form-control Alphanumeric js-uppercase ecms-armedtype-control"
                                   placeholder="Enter Abbreviation"
                                   id="txtAbbreviation"
                                   maxlength="10"
                                   required
                                   pattern="^[A-Z0-9 ]*$"
                                   title="Only UpperCase Alphabets and Numbers allowed" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label ecms-armedtype-label" for="ddlArmedCat">
                                <i class="fa fa-tags"></i>
                                <span>Type</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <select class="form-select full-width ecms-armedtype-control"
                                    name="ddlArmedCat"
                                    required
                                    id="ddlArmedCat">
                                <option value="0">Please Select</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-xl-2">
                            <label class="form-label ecms-armedtype-label">
                                <i class="fa fa-crosshairs"></i>
                                <span>Infantry</span>
                                <i class="fas fa-asterisk mand1"></i>
                            </label>

                            <div class="ecms-armedtype-radio-box d-flex flex-wrap gap-2">
                                <div class="form-check form-check-inline ecms-radio-pill ecms-armedtype-radio">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="radioInf"
                                           id="radioInfyes">
                                    <label class="form-check-label" for="radioInfyes">Yes</label>
                                </div>

                                <div class="form-check form-check-inline ecms-radio-pill ecms-armedtype-radio">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="radioInf"
                                           id="radioInfno">
                                    <label class="form-check-label" for="radioInfno">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-2">
                            <div class="ecms-form-actions ecms-armedtype-actions d-flex gap-2 justify-content-xl-end">
                                <input type="button" class="btn btn-outline-primary ecms-armedtype-save" value="Save" id="btnsave" />
                                <input type="button" class="btn btn-outline-danger ecms-armedtype-reset" value="Reset" id="btnReset" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="ecms-armedtype-message" id="msg"></div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="ecms-section ecms-armedtype-table-section d-flex flex-column flex-grow-1 ecms-min-0">
                <div class="ecms-section-title flex-shrink-0">
                    <i class="fa fa-list"></i>
                    <span>Arms / Service &amp; Corps Records</span>
                </div>

                <div class="ecms-armedtype-table-wrap ecms-dt-wrap flex-grow-1 ecms-min-0">
                    <table class="table table-striped table-hover border border-purple dataTable ecms-armedtype-datatable ecms-dt-table"
                           role="grid"
                           id="tbldata">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- IMPORTANT: Original script order restored. These files contain required globals used by armedtype.js. -->
<script asp-src-include="~/DeveloperJS/mtables.js"></script>
<script asp-src-include="~/DeveloperJS/command.js"></script>
<script asp-src-include="~/DeveloperJS/ArmedType.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />
