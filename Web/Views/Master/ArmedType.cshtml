@{
    ViewData["Title"] = "Arms, Service & Corps";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/armedtype.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Arms, Service & Corps</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-armedtype-page">
    <div class="ecms-armedtype-shell">
        <div class="ecms-armedtype-titlebar">
            <div class="ecms-armedtype-title-wrap">
                <span class="ecms-armedtype-title-icon"><i class="fa fa-shield"></i></span>
                <div>
                    <h3>Arms, Service & Corps</h3>
                    <p>Create, update and manage arms/service/corps records</p>
                </div>
            </div>
            <span class="ecms-armedtype-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-armedtype-form-card">
            <span id="SpnTxnId" class="d-none">0</span>

            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="ecms-armedtype-form-grid">
                    <div class="ecms-armedtype-field">
                        <label class="ecms-armedtype-label" for="txtArmedName">
                            <i class="fa fa-shield"></i>
                            Arms / Service
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric ecms-armedtype-control"
                               placeholder="Enter Armed"
                               id="txtArmedName"
                               maxlength="100"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-armedtype-field">
                        <label class="ecms-armedtype-label" for="txtAbbreviation">
                            <i class="fa fa-font"></i>
                            Abbreviation
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric js-uppercase ecms-armedtype-control"
                               placeholder="Enter Abbreviation"
                               id="txtAbbreviation"
                               maxlength="10"
                               required
                               pattern="^[A-Z0-9 ]*$"
                               title="Only UpperCase Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-armedtype-field">
                        <label class="ecms-armedtype-label" for="ddlArmedCat">
                            <i class="fa fa-tags"></i>
                            Type
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <select class="form-select full-width ecms-armedtype-control"
                                name="ddlArmedCat"
                                required
                                id="ddlArmedCat">
                            <option value="0">Please Select</option>
                        </select>
                    </div>

                    <div class="ecms-armedtype-field">
                        <label class="ecms-armedtype-label">
                            <i class="fa fa-crosshairs"></i>
                            Infantry
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <div class="ecms-armedtype-radio-box">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       name="radioInf"
                                       id="radioInfyes">
                                <label class="form-check-label" for="radioInfyes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       name="radioInf"
                                       id="radioInfno">
                                <label class="form-check-label" for="radioInfno">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="ecms-armedtype-actions">
                        <input type="button" class="btn btn-outline-primary ecms-armedtype-save" value="Save" id="btnsave" />
                        <input type="button" class="btn btn-outline-danger ecms-armedtype-reset" value="Reset" id="btnReset" />
                    </div>

                    <div class="ecms-armedtype-message" id="msg"></div>
                </div>
            </form>
        </div>

        <div class="ecms-armedtype-table-card">
            <div class="ecms-armedtype-table-title">
                <span><i class="fa fa-list"></i> Arms / Service & Corps Records</span>
            </div>

            <div class="ecms-armedtype-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/command.js"></script>
<script asp-src-include="~/developerjs/armedtype.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />
