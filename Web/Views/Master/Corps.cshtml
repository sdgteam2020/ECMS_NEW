@{
    ViewData["Title"] = "Corps";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/corps.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Corps / Dte / Area Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-corps-page">
    <div class="ecms-corps-shell">
        <div class="ecms-corps-titlebar">
            <div class="ecms-corps-title-wrap">
                <span class="ecms-corps-title-icon"><i class="fa fa-sitemap"></i></span>
                <div>
                    <h3>Corps / Dte / Area Details</h3>
                    <p>Create, update and manage corps / directorate / area records</p>
                </div>
            </div>
            <span class="ecms-corps-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-corps-form-card">
            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="ecms-corps-form-grid">
                    <div class="ecms-corps-field">
                        <label class="ecms-corps-label" for="ddlCommand">
                            <i class="fa fa-university"></i>
                            Select Comd / PSO
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <select class="form-select full-width"
                                tabindex="-1"
                                name="ddlCommand"
                                required
                                id="ddlCommand">
                            <option value="0">Select Comd</option>
                        </select>
                    </div>

                    <div class="ecms-corps-field">
                        <label class="ecms-corps-label" for="txtCoprsName">
                            <i class="fa fa-map-marker"></i>
                            Enter Corps / Dte / Area
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric"
                               placeholder="Enter Corps / Dte / Area"
                               id="txtCoprsName"
                               maxlength="20"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-corps-actions">
                        <input type="button" class="btn btn-outline-primary ecms-corps-save" value="Save" id="btnsave" />
                        <button type="button" id="btnReset" class="btn btn-outline-danger ecms-corps-reset">Reset</button>
                        <div id="msg" class="ecms-corps-msg"></div>
                    </div>
                </div>
            </form>
        </div>

        <div class="ecms-corps-table-card">
            <div class="ecms-corps-table-title">
                <span><i class="fa fa-list"></i> Corps / Dte / Area Records</span>
            </div>

            <div class="ecms-corps-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/corps.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
