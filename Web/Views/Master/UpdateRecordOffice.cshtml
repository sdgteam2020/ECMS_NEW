@{
    ViewData["Title"] = "Add Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link asp-href-include="~/developercss/updaterecordoffice.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> > <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > <a href="/Home/DashboardUserMgt" class="mr-2"> User Mngt</a> >Update Mapping

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="row">
        <div class="col-6 UpdateMapping">
            <div class="card h-100">
                <div class="card-header">
                    <div class="row">
                        <div class="col-xl-12 text-left">
                            <h3>
                                Update Mapping in Record Office
                                <small class="text-muted"> </small>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="card-body card-body-min-height" >
                    <form action="" id="UpdateRecordOffice" method="post" name="UpdateRecordOffice">
                        <div class="row">
                            <span class="d-none" id="spnRecordOfficeId">@ViewBag.ROId</span>
                            <span class="d-none" id="spnUnitMapId">@ViewBag.UnitId</span>
                            <span class="d-none" id="spnOldTDMId">@ViewBag.TDMId</span>
                            <div class="mt-2 ml-4 ">
                                <div class="row">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Record Office</label>
                                        <div class="col-sm-8">
                                            <label id="lblROName" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4  labelprofile">Abbreviation</label>
                                        <div class="col-sm-8">
                                            <label id="lblROAbbreviation" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelprofile">Name of Arms, Service & Corps</label>
                                        <div class="col-sm-8">
                                            <label class="col-form-label " id="lblArms"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 fw-bold">Message for RO</label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control1" style="height:auto!important;" name="txtMessage" id="txtMessage" rows="3" maxlength="150" data-val-maxlength="Maximum length of Message is 150 character." data-val-maxlength-max="150" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                            <span class="text-danger field-validation-valid" data-valmsg-for="txtMessage" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 fw-bold">Select Domain Id <i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select"  tabindex="-1"  name="ddlTDMId" id="ddlTDMId" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Domain Id is required." data-val-regex-pattern="^[\d]+$">
                                            </select>
                                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 text-center mt-2">
                                <input type="button" class="btn btn-primary mt-4 mr-4" value="Submit" id="btnROUpdate" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/UpdateRecordOffice.js"></script>
