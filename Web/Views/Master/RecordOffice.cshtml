@{
    ViewData["Title"] = "Record Office";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/recordoffice.css" rel="stylesheet" asp-append-version="true" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <span class="page-header-icon"><i class="fa fa-bars" aria-hidden="true"></i></span>
                        <a href="/Master/DashboardMaster">Dashboard</a>
                        <span aria-hidden="true">&gt;</span>
                        <span>Record Office Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="containerMain ecms-page ecms-page-full ecms-recordoffice-page">
    <section class="card ecms-card ecms-recordoffice-shell">
        <div class="ecms-card-body ecms-recordoffice-shell-body">
            <div class="ecms-page-title d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2 ecms-min-0">
                    <span class="ecms-title-icon" aria-hidden="true">
                        <i class="fa fa-address-book"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h3>Record Office Details</h3>
                        <p class="ecms-title-subtitle">Create, update and manage record office, arms/service and linked domain details</p>
                    </div>
                </div>

                <button type="button"
                        id="btnAdd"
                        class="btn btn-success btn-sm d-inline-flex align-items-center gap-2 ecms-recordoffice-add-btn">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    <span>Add Record Office</span>
                </button>
            </div>

            <section class="ecms-section ecms-recordoffice-records">
                <div class="ecms-section-title">
                    <i class="fa fa-table" aria-hidden="true"></i>
                    <span>Record Office Records</span>
                </div>

                <div class="ecms-dt-wrap ecms-recordoffice-table-wrap">
                    <table id="tbldata"
                           class="table table-striped table-hover ecms-dt-table"
                           role="grid"
                           aria-label="Record office records">
                    </table>
                </div>
            </section>
        </div>
    </section>
</main>

<div class="modal fade" id="AddNewRecordOffice" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered ecms-modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-modal-title-wrap">
                    <span class="ecms-modal-title-icon" aria-hidden="true">
                        <i class="fa fa-address-book"></i>
                    </span>
                    <div>
                        <h5 class="modal-title" id="exampleModalLabel">Add Record Office Details</h5>
                        <p class="ecms-modal-subtitle" id="recordOfficeModalSubtitle">
                            Fill record office, arms/service, message and linked domain mapping details
                        </p>
                    </div>
                </div>

                <button type="button"
                        class="close"
                        data-bs-dismiss="modal"
                        data-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <form action="" id="SaveRecordOffice" name="SaveRecordOffice" method="post">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label ecms-label-with-icon" for="txtName">
                                <span class="ecms-label-icon"><i class="fa fa-building" aria-hidden="true"></i></span>
                                <span>Name of Record Office</span>
                                <span class="mand1" aria-hidden="true">*</span>
                            </label>
                            <input class="form-control form-control1"
                                   placeholder="Enter Record Office"
                                   id="txtName"
                                   name="txtName"
                                   maxlength="50"
                                   autocomplete="off"
                                   data-val="true"
                                   data-val-regex="Record Office name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed."
                                   data-val-required="Record Office is required."
                                   data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label ecms-label-with-icon" for="txtAbbreviation">
                                <span class="ecms-label-icon"><i class="fa fa-font" aria-hidden="true"></i></span>
                                <span>Abbreviation</span>
                                <span class="mand1" aria-hidden="true">*</span>
                            </label>
                            <input class="form-control form-control1"
                                   placeholder="Enter Abbreviation"
                                   id="txtAbbreviation"
                                   name="txtAbbreviation"
                                   maxlength="15"
                                   autocomplete="off"
                                   data-val="true"
                                   data-val-regex="Record Office Abbreviation name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed."
                                   data-val-required="Abbreviation is required."
                                   data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label ecms-label-with-icon" for="ddlArmType">
                                <span class="ecms-label-icon"><i class="fa fa-shield" aria-hidden="true"></i></span>
                                <span>Name of Arms, Service &amp; Corps</span>
                                <span class="mand1" aria-hidden="true">*</span>
                            </label>
                            <select class="form-select"
                                    name="ddlArmType"
                                    id="ddlArmType"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-required="Arms, Service & Corps is required."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Arms</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmType" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label ecms-label-with-icon" for="txtUnitName">
                                <span class="ecms-label-icon"><i class="fa fa-search" aria-hidden="true"></i></span>
                                <span>SUS No</span>
                            </label>
                            <input class="form-control alpha-num-only"
                                   placeholder="Type SUS No"
                                   id="txtUnitName"
                                   name="txtUnitName"
                                   autocomplete="off"
                                   data-val="true"
                                   data-val-regex="This special chars not allowed for security reasons."
                                   data-val-regex-pattern="^[\w ]*$" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label ecms-label-with-icon" for="txtMessage">
                                <span class="ecms-label-icon"><i class="fa fa-comment" aria-hidden="true"></i></span>
                                <span>Message for RO</span>
                            </label>
                            <textarea class="form-control form-control1 ecms-recordoffice-message-control"
                                      name="txtMessage"
                                      id="txtMessage"
                                      rows="3"
                                      maxlength="150"
                                      placeholder="Enter message for Record Office"
                                      data-val-maxlength="Maximum length of Message is 150 character."
                                      data-val-maxlength-max="150"
                                      data-val="true"
                                      data-val-regex="Message must contain at least one alphabet. Only A-Z, a-z, 0-9, &, -, /, (, ), dot, comma and single space allowed."
                                      data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/().,\-]+(?: [A-Za-z0-9&\/().,\-]+)*$"></textarea>
                            <span class="text-danger field-validation-valid" data-valmsg-for="txtMessage" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label ecms-label-with-icon" for="ddlTDMId">
                                <span class="ecms-label-icon"><i class="fa fa-link" aria-hidden="true"></i></span>
                                <span>Linked Domain ID &amp; Pers Details</span>
                            </label>
                            <select class="form-select"
                                    name="ddlTDMId"
                                    id="ddlTDMId"
                                    data-val="true"
                                    data-val-regex="This special chars not allowed for security reasons."
                                    data-val-regex-pattern="^[\d]+$">
                                <option value="0">Select Domain Id</option>
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                        </div>

                        <div class="col-12">
                            <div class="ecms-form-actions justify-content-end pt-1">
                                <input type="button"
                                       class="btn btn-primary px-4"
                                       value="Save"
                                       id="btnRecordOfficeAdd" />
                                <button type="button"
                                        id="btnRecordOfficeReset"
                                        class="btn btn-danger px-4">
                                    Reset
                                </button>
                            </div>
                        </div>

                        <div class="col-12 ecms-recordoffice-message" id="msg"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/mtables.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
<script asp-src-include="~/developerjs/RecordOffice.js" asp-append-version="true"></script>
