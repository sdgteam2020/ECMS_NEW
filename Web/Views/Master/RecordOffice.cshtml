@{
    ViewData["Title"] = "Record Office";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/recordoffice.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Record Office
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <span id="ArmedIdForORO" class="d-none">@ViewBag.ArmedIdForORO</span>
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Record Office  Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height" >
            <div class="row">
                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                           @*  Total Record Office  <span id="lblTotal" class="ml-3 border border-light b px-2 py-1">0</span> *@
                        </h6>
                        <div>
                            <button type="button" id="btnAdd" class="btn btn-outline-success font-weight-600 btn-md"><i class="fa fa-plus mr-1 font-weight-700" ></i>Add Record Office</button>
                        </div>
                    </div>
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>  
<script asp-src-include="~/developerjs/mtables.js"></script>
<script asp-src-include="~/developerjs/RecordOffice.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />

<div class="modal fade" id="AddNewRecordOffice" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Enter Record Office Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form action="" id="SaveRecordOffice" name="SaveRecordOffice" method="post">
                        <div class="row">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name of Record Office<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Enter Record Office" id="txtName" name="txtName" maxlength="50" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Record Office is required." data-val-regex-pattern="^[\w ]+$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Abbreviation<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Enter Abbreviation" id="txtAbbreviation" name="txtAbbreviation" maxlength="15" data-val="true" data-val-regex="This special chars and space not allowed for security reasons." data-val-required="Abbreviation is required." data-val-regex-pattern="^[\w ]+$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Name of Arms, Service & Corps <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlArmType" id="ddlArmType" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Arms, Service & Corps is required." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Arms</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlArmType" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Message for RO</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1 textarea-auto-height" name="txtMessage" id="txtMessage" rows="3" maxlength="150" data-val-maxlength="Maximum length of Message is 150 character." data-val-maxlength-max="150" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtMessage" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">SUS No</label>
                                <div class="col-sm-8">
                                    <input class="form-control" placeholder="Type SUS No" id="txtUnitName" name="txtUnitName" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w ]*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitName" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Linked Domain ID & Pers Details</label>
                                <div class="col-sm-8">
                                    <select class="form-select"   name="ddlTDMId" id="ddlTDMId" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\d]+$">
                                        <option value="0">Select Domain Id</option>
                                    </select>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="ddlTDMId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-right">
                                <input type="button" class="btn btn-outline-primary" value="Save" id="btnRecordOfficeAdd" />
                                <button type="button" id="btnRecordOfficeReset" class="btn btn-outline-danger">Reset</button>
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </form>

                    <div class="col-sm-12" id="msg">
                    </div>
                </div>
            </div>

        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>