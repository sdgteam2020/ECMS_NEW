@{
    ViewData["Title"] = "Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/appointment.css" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Appointment
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Appointment Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height">
            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="row">
                    <div class="col-xl-3">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-4 fw-bold">Enter Appointment<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-8">
                                <input class="form-control1" placeholder="Enter Appointment" id="txtAppointment" name="txtAppointment" maxlength="50" data-val="true" data-val-regex="Appointment name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Appointment name is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                                <span class="text-danger field-validation-valid" data-valmsg-for="txtAppointment" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-4 fw-bold">Abbreviation</label>
                            <div class="col-sm-8">
                                <input class="form-control1" placeholder="Enter Appointment" id="txtAbbreviation" name="txtAbbreviation" maxlength="20" data-val="true" data-val-regex="Abbreviation name must contain at least one alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Abbreviation name is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Za-z])[A-Za-z0-9&\/()\-]+(?: [A-Za-z0-9&\/()\-]+)*$" />
                                <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="form-group row mb-2">
                            <label class="col-form-label col-sm-4 fw-bold">Approve<i class="fas fa-asterisk mand1"></i></label>
                            <div class="col-sm-8">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsApproved" id="IsApprovedYes" value="true" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="IsApprovedYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="IsApproved" id="IsApprovedNo" value="false" data-val-regex-pattern="^[\w]*$">
                                    <label class="form-check-label" for="IsApprovedNo">No</label>
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" id="Approved-error"></span>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="col-sm-12 text-right">
                            <input type="button" class="btn btn-outline-primary " value="Save" id="btnsave" />
                            <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                        </div>
                    </div>
                </div>
            </form> 
            <div class="col-xl-12">
                <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                    <h6 class="mb-3 mb-md-0">
                        &nbsp;
                    </h6>
                    <div>
                        &nbsp;
                    </div>
                </div>
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/Appointment.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />