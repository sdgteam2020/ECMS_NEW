@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Unit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = Environment.GetEnvironmentVariable("AFSAC__CDN");
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link href="@($"{Cdn}/developercss/unit.css?v={configuration["StaticVersion"]}")" rel="stylesheet" />
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Unit

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Unit Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>


        <div class="card-body card-body-min-height" >
            <div class="row">
                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Name<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control1 textarea-auto-height js-uppercase" placeholder="Enter Unit" id="txtUnitDesc" name="txtUnitDesc" rows="2" maxlength="100" data-val="true" data-val-regex="Unit name must contain at least one capital alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Unit Name is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Z])[A-Z0-9&\/()\-]+(?: [A-Z0-9&\/()\-]+)*$"></textarea>
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtUnitDesc" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">
                                    Unit Abbreviation<i class="fas fa-asterisk mand1"></i>
                                </label>
                                <div class="col-sm-8">
                                    <input class="form-control1 js-uppercase" placeholder="Abbreviation as Per Unit Name to be Displayed on I-Card" id="txtAbbreviation" name="txtAbbreviation" maxlength="10" data-val="true" data-val-regex="Unit Abbreviation must contain at least one capital alphabet. Only A-Z, 0-9, & - / ( ) and single space allowed." data-val-required="Unit Abbreviation is required." data-val-regex-pattern="^(?![0-9 ]+$)(?=.*[A-Z])[A-Z0-9&\/()\-]+(?: [A-Z0-9&\/()\-]+)*$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtAbbreviation" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Verify<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="IsVerify" value="true" id="isverifyyes" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="isverifyyes">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="IsVerify" value="false" id="isverifyno" data-val-regex-pattern="^[\w]*$">
                                        <label class="form-check-label" for="isverifyno">
                                            No
                                        </label>
                                    </div>
                                    <span class="text-danger field-validation-valid" id="IsVerify-error"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit SUS No<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control1 isNumerictxt" placeholder="Enter SUS No" id="txtSusno" name="txtSusno" minlength="7" maxlength="7" data-val="true" data-val-regex="Enter valid 7 digit SUS No. 0000000 is not allowed." data-val-required="SUS No is required." data-val-regex-pattern="^(?!0{7}$)\d{7}$" />
                                    <span class="text-danger field-validation-valid" data-valmsg-for="txtSusno" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Suffix<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8 d-flex">
                                    <div class="col-sm-6">
                                        <input class="form-control-Alphabets js-uppercase" placeholder="Enter Suffix" id="txtSuffix" name="txtSuffix" maxlength="1" data-val="true" data-val-regex="Only capital letters Y, H, A, L, W, X, F, M, P, K, N allowed." data-val-required="Suffix is required." data-val-regex-pattern="^(?=.*[A-Z])[YHALWXFMPKN]$" />
                                        <span class="text-danger field-validation-valid" data-valmsg-for="txtSuffix" data-valmsg-replace="true"></span>
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="button" class="btn btn-outline-primary " value="Save" id="btnsave" />
                                        <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            &nbsp;
                        </h6>
                        <div class="d-flex">
                            &nbsp;
                        </div>
                    </div>
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="@($"{Cdn}/developerjs/Unit.js?v={configuration["StaticVersion"]}")"></script>
<script src="@($"{Cdn}/developerjs/commandvalidation.js?v={configuration["StaticVersion"]}")"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />