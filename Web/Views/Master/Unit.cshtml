@{
    ViewData["Title"] = "Unit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Unit

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3 ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Unit Details
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>


        <div class="card-body card-body-min-height" >
            <div class="row">
                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit Name<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control Alphanumeric" placeholder="Enter Unit" id="txtUnitDesc" maxlength="100" required pattern="^[a-zA-Z0-9 ]*$" title="Only Alphabets and Numbers allowed" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">
                                    Unit Abbreviation<i class="fas fa-asterisk mand1"></i>
                                </label>
                                <div class="col-sm-8">
                                    <input class="form-control Alphanumeric" placeholder="Abbreviation as Per Unit Name to be Displayed on I-Card" id="txtAbbreviation" maxlength="10" required pattern="^[a-zA-Z0-9 ]*$" title="Only Alphabets and Numbers allowed" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Unit SUS No<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control1 isNumerictxt" placeholder="Enter SUS No" id="txtSusno" minlength="7" maxlength="7" required pattern="^[0-9]+$" title="Only Numbers allowed" />
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Suffix<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8 d-flex">
                                    <div class="col-sm-6">
                                        <input class="form-control-Alphabets" placeholder="Enter Suffix" id="txtSuffix" maxlength="1" required pattern="^[a-zA-Z]*$" title="Only Alphabets allowed" />
                                    </div>
                                    <div class="col-sm-6">
                                        <input type="button" class="btn btn-outline-primary " value="Save" id="btnsave" />
                                        <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="col-sm-12 text-left">
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            @* Total Command <span id="lblTotal" class="ml-3 border border-light b px-2 py-1">0</span> *@
                        </h6>
                        <div class="d-flex">
                            @* <input class="btn-outline-light form-control ml-2" placeholder="Search SUS No" id="txtSerachunit" maxlength="10" pattern="^[a-zA-Z]*$" /> *@
                        </div>
                    </div>
                    <table class="table border border-purple table-striped no-footer table-hover" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/Unit.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />