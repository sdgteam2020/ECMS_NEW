@{
    ViewData["Title"] = "Unit Mapping Change Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .containerMain {
        margin-left: 10%;
        margin-right: 10%;
    }

    .faulty {
        background-color: #044C92;
        text-align: center;
        padding: 0.5rem !important;
        margin-right: 0.25rem !important;
        border: hidden;
        font-weight: 400 !important;
        color: #fff !important;
        width: 170px;
        height: 60px;
    }

    .modal.left .modal-dialog, .modal.right .modal-dialog {
        position: fixed;
        margin: auto;
        width: 700px;
        height: 100%;
        text-align: left;
        -webkit-transform: translate3d(0%, 0, 0);
        -ms-transform: translate3d(0%, 0, 0);
        -o-transform: translate3d(0%, 0, 0);
        transform: translate3d(0%, 0, 0);
    }
    .labelUnit{
        font-weight: 700 !important;
    }

    .h-90 {
        height: 90% !important;
    }
</style>
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content pt-5">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        @if (ViewBag.RoleName == "admin")
                        {
                            <div><a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> >  Unit Move Request</div>
                        }
                        else
                        {
                            <div><a href="/Home/Index" class="mr-2">Home</a> >  <a href="/Home/Dashboard" class="mr-2">Dashboard</a> > Unit Move Request</div>
                        }
                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card ">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Profile Mapping Details
                        <small class="text-muted"> </small>


                    </h3>
                </div>


            </div>
        </div>
        <div class="card-body" >
            <div class="row g-3 row-deck mb-3">
                <form action="" id="SaveMapUnitChange" method="post" name="SaveMapUnitChange">
                    <div class="row">
                        <span class=" d-none" id="spnMapUnitChangeRequestId">@(ViewBag.MapUnitChangeRequestId ?? 0)</span>
                        <span class=" d-none" id="spnUnitMapId">@ViewBag.MapUnitId</span>
                        <span class=" d-none" id="spnRoleName">@ViewBag.RoleName</span>
                       
                        
                        <div class="col-sm-6">

                            <div class="card p-1 mb-2 alert alert-primary">
                                    <div class="mb-1 d-flex justify-content-between align-items-center">
                                        <div class="text-start ml-2 labelUnit">
                                            Unit Name - <label id="lblUnit" class="col-form-label"></label> (<label id="lblSUSNo" class="col-form-label"></label>)
                                        </div>

                                    </div>
                                </div>
                            
                            <div class="card h-90">
                                <div class="card-header">
                                    <div class="row">
                                        <div class="col-xl-12 text-left">
                                            <h3>
                                                Current Hierarchy
                                                <small class="text-muted"> </small>


                                            </h3>
                                        </div>


                                    </div>
                                </div>
                               
                                <div class="p-4">
                                    <div class="form-group row mb-0">
                                        <label class="col-form-label col-sm-5 labelUnit">Unit Type</label>
                                        <div class="col-sm-7">
                                            <label id="lblUnitType" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-UnitType">
                                        <label class="col-form-label col-sm-5 labelUnit">Comd / PSO</label>
                                        <div class="col-sm-7">
                                            <label id="lblComd" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-UnitType">
                                        <label class="col-form-label col-sm-5 labelUnit">Corps / Dte / Area</label>
                                        <div class="col-sm-7">
                                            <label id="lblCorps" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-UnitType">
                                        <label class="col-form-label col-sm-5 labelUnit">Div / Sub Area</label>
                                        <div class="col-sm-7">
                                            <label id="lblDiv" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-UnitType">
                                        <label class="col-form-label col-sm-5 labelUnit">Bde</label>
                                        <div class="col-sm-7">
                                            <label id="lblBde" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-FmnBranch">
                                        <label class="col-form-label col-sm-5 labelUnit">Fmn / Branch</label>
                                        <div class="col-sm-7">
                                            <label id="lblFmnBranch" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-DteBranch">
                                        <label class="col-form-label col-sm-5 labelUnit">PSO / Dte </label>
                                        <div class="col-sm-7">
                                            <label id="lblPSODte" class="col-form-label"></label>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-0 ExistingCh-DteBranch">
                                        <label class="col-form-label col-sm-5 labelUnit">DG / Sub Dte</label>
                                        <div class="col-sm-7">
                                            <label id="lblDgSubDte" class="col-form-label"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">

                            <div class="card p-1 mb-2 alert alert-info mt-2">
                                    <div class="mb-1 d-flex justify-content-between align-items-center">

                                    <div class="text-start ml-2 labelUnit">
                                            Request By - <label id="lblRequestBy" class="col-form-label"></label>
                                        </div>
                                    </div>
                                </div>

                            <div class="card h-90">
                                   
                                <div class="card-header">
                                    <div class="row">
                                        <div class="col-xl-12 text-left">
                                            <h3>
                                                Unit Hierarchy Recalibration
                                                <small class="text-muted"> </small>


                                            </h3>
                                        </div>


                                    </div>
                                </div>
                                <div class="p-4">
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelUnit">Select Unit Type <i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType1" value="1" checked>
                                                <label class="form-check-label" for="UnitType1">Unit</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType2" value="2">
                                                <label class="form-check-label" for="UnitType2">
                                                    Fmn HQ
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="UnitTyperdi" id="UnitType3" value="3">
                                                <label class="form-check-label" for="UnitType3">Dte/Sub Dte Branch</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 unittype">
                                        <label class="col-form-label col-sm-4 labelUnit">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlCommand" required id="ddlCommand">
                                                <option value="0">Select Comd / PSO </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-4 unittype">
                                        <label class="col-form-label col-sm-4 labelUnit">Corps / Dte / Area<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlCorps" required id="ddlCorps">
                                                <option value="0">Select Corps / Dte / Area </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 unittype">
                                        <label class="col-form-label col-sm-4 labelUnit">Div/Sub Area<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlDiv" required id="ddlDiv">
                                                <option value="0">Select One </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 unittype">
                                        <label class="col-form-label col-sm-4 labelUnit">Bde<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlBde" required id="ddlBde">
                                                <option value="0">Select Bde </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 FmnBranch  d-none">
                                        <label class="col-form-label col-sm-4 labelUnit">Type of Fmn /Branch<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlFmnBranch" required id="ddlFmnBranch">
                                                <option value="1">Select Fmn/Branch </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 DteBranch d-none">
                                        <label class="col-form-label col-sm-4 labelUnit">PSO /Dte <i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlPSODte" required id="ddlPSODte">
                                                <option value="1">Select DG / Sub Dte </option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 DteBranch d-none">
                                        <label class="col-form-label col-sm-4 labelUnit">DG / Sub Dte <i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <select class="form-select" style="width: 100%;" aria-hidden="true" name="ddlDgSubDte" required id="ddlDgSubDte">
                                                <option value="1">Select DG / Sub Dte</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2">
                                        <label class="col-form-label col-sm-4 labelUnit">Remark<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control1" style="height:auto!important;" name="txtRemark" id="txtRemark" rows="3" maxlength="100" oninput="this.value = this.value.toUpperCase();" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="100" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-required="Remark is required." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                            <span class="text-danger field-validation-valid" data-valmsg-for="txtRemark" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                    <div class="form-group row mb-2 AdminRemark d-none">
                                        <label class="col-form-label col-sm-4 labelUnit">Admin Remark<i class="fas fa-asterisk mand1"></i></label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control1" style="height:auto!important;" name="txtAdminRemark" id="txtAdminRemark" rows="3" maxlength="100" oninput="this.value = this.value.toUpperCase();" data-val-maxlength="Maximum length of Message is 100 character." data-val-maxlength-max="100" data-val="true" data-val-regex="This special chars not allowed for security reasons." data-val-regex-pattern="^[\w\&\.\-\; ]*$"></textarea>
                                            <span class="text-danger field-validation-valid" data-valmsg-for="txtAdminRemark" data-valmsg-replace="true"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 text-center mb-4 mt-4">
                                        <input type="button" class="btn btn-primary" id="btnReject" value="Reject" />
                                        <input type="button" class="btn btn-primary" id="btnAccept" value="Accept and Update Mapping" />
                                        <input type="button" class="btn btn-primary" id="btnSubmit" value="Submit" />
                                    </div>
                                </div>
                                </div>

                            
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script asp-src-include="~/developerjs/MapUnitChangeRequest.js"></script>
<script asp-src-include="~/developerjs/mtables.js"></script>