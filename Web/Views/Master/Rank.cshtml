@{
    ViewData["Title"] = "Rank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/rank.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Rank Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-rank-page">
    <div class="ecms-rank-shell">
        <div class="ecms-rank-titlebar">
            <div class="ecms-rank-title-wrap">
                <span class="ecms-rank-title-icon"><i class="fa fa-star"></i></span>
                <div>
                    <h3>Rank Details</h3>
                    <p>Create, update, arrange and manage rank records</p>
                </div>
            </div>
            <span class="ecms-rank-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-rank-form-card">
            <span id="SpnTxnId" class="d-none">0</span>

            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="ecms-rank-form-grid">
                    <div class="ecms-rank-field">
                        <label class="ecms-rank-label" for="txtRank">
                            <i class="fa fa-star"></i>
                            Rank
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric ecms-rank-control"
                               placeholder="Enter Rank"
                               id="txtRank"
                               maxlength="50"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-rank-field">
                        <label class="ecms-rank-label" for="txtAbbreviation">
                            <i class="fa fa-font"></i>
                            Abbreviation
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric ecms-rank-control"
                               placeholder="Enter Abbreviation"
                               id="txtAbbreviation"
                               maxlength="30"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-rank-field">
                        <label class="ecms-rank-label" for="ddlRankType">
                            <i class="fa fa-users"></i>
                            Rank Type
                            <i class="fas fa-asterisk mand1"></i>
                        </label>
                        <select class="form-select ecms-rank-control"
                                name="ddlRankType"
                                required
                                id="ddlRankType">
                            <option value="">Select Rank Type</option>
                            <option value="1">Offrs</option>
                            <option value="2">JCO/OR</option>
                        </select>
                    </div>

                    <div class="ecms-rank-actions" id="msg">
                        <input type="button" class="btn btn-outline-primary ecms-rank-save" value="Save" id="btnsave" />
                        <input type="button" class="btn btn-outline-danger ecms-rank-reset" value="Reset" id="btnReset" />
                    </div>
                </div>
            </form>
        </div>

        <div class="ecms-rank-table-card">
            <div class="ecms-rank-table-title">
                <span><i class="fa fa-list"></i> Rank Records</span>
            </div>

            <div class="ecms-rank-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/rank.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />
