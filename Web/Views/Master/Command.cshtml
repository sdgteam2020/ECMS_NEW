@{
    ViewData["Title"] = "Create Draft";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link asp-href-include="~/css/hierarchy.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/command.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row g-0 align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a>
                        <span>&gt;</span>
                        <span>Comd / PSO Details</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-fluid ecms-page ecms-page-full ecms-fit-screen ecms-command-page">
    <div class="card ecms-card ecms-command-shell">
        <div class="card-body ecms-card-body d-flex flex-column gap-2 h-100 ecms-min-0">

            <div class="ecms-page-title ecms-command-titlebar d-flex align-items-center justify-content-between flex-wrap gap-2 flex-shrink-0">
                <div class="d-flex align-items-center gap-2 ecms-min-0">
                    <span class="ecms-title-icon">
                        <i class="fa fa-university"></i>
                    </span>
                    <div class="ecms-min-0">
                        <h3>Comd / PSO Sectt</h3>
                        <p class="ecms-title-subtitle">Create, update, arrange and manage command / PSO records</p>
                    </div>
                </div>

                <span class="badge bg-primary ecms-badge ecms-command-pill">
                    <i class="fa fa-database"></i>
                    Master
                </span>
            </div>

            <div class="ecms-section ecms-form-section ecms-command-form-section flex-shrink-0">
                <span id="SpnTxnId" class="d-none">0</span>

                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row g-2 align-items-end">

                        <div class="col-12 col-md-6 col-xl-5">
                            <label class="form-label ecms-command-label" for="txtComandName">
                                <i class="fa fa-sitemap"></i>
                                <span>Comd / PSO</span>
                                <i class="fa fa-asterisk mand1"></i>
                            </label>

                            <input class="form-control Alphanumeric"
                                   placeholder="Enter Comd"
                                   id="txtComandName"
                                   maxlength="50"
                                   required
                                   pattern="^[a-zA-Z0-9 ]*$"
                                   title="Only Alphabets and Numbers allowed" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-5">
                            <label class="form-label ecms-command-label" for="txtAbbreviation">
                                <i class="fa fa-font"></i>
                                <span>Abbreviation</span>
                                <i class="fa fa-asterisk mand1"></i>
                            </label>

                            <input class="form-control Alphanumeric js-uppercase"
                                   placeholder="Enter Abbreviation"
                                   id="txtAbbreviation"
                                   maxlength="20"
                                   required
                                   pattern="^[A-Z0-9 ]*$"
                                   title="Only UpperCase Alphabets and Numbers allowed" />
                        </div>

                        <div class="col-12 col-xl-2">
                            <div class="ecms-form-actions ecms-command-actions d-flex gap-2 justify-content-xl-end">
                                <input type="button" class="btn btn-primary" value="Save" id="btnsave" />
                                <button type="button" id="btnReset" class="btn btn-danger">Reset</button>
                                <div id="msg" class="ecms-command-msg"></div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="ecms-section ecms-command-table-section d-flex flex-column flex-grow-1 ecms-min-0">
                <div class="ecms-section-title flex-shrink-0">
                    <i class="fa fa-list"></i>
                    <span>Command / PSO Records</span>
                </div>

                <div class="ecms-command-table-wrap flex-grow-1 ecms-min-0">
                    <table class="table table-striped table-hover table-bordered dataTable ecms-command-datatable" role="grid" id="tbldata">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade ecms-command-modal" id="treeview" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-dialog-centered ecms-modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">
                    Hierarchy Chart
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row g-0 flex-row flex-nowrap ecms-scroll-x">
                        <div class="col-12 text-center">
                            <div class="tree" id="tree">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/command.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
