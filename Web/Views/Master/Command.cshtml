@{
    ViewData["Title"] = "Create Draft";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link asp-href-include="~/css/hierarchy.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/command.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> <span>&gt;</span> Comd / PSO Details
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="containerMain ecms-command-page">
    <div class="ecms-command-shell">
        <div class="ecms-command-titlebar">
            <div class="ecms-command-title-wrap">
                <span class="ecms-command-title-icon"><i class="fa fa-university"></i></span>
                <div>
                    <h3>Comd / PSO Sectt</h3>
                    <p>Create, update, arrange and manage command / PSO records</p>
                </div>
            </div>
            <span class="ecms-command-pill"><i class="fa fa-database"></i> Master</span>
        </div>

        <div class="ecms-command-form-card">
            <span id="SpnTxnId" class="d-none">0</span>

            <form action="" id="SaveForm" method="post" name="SaveForm">
                <div class="ecms-command-form-grid">
                    <div class="ecms-command-field">
                        <label class="ecms-command-label" for="txtComandName">
                            <i class="fa fa-sitemap"></i>
                            Comd / PSO
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric"
                               placeholder="Enter Comd"
                               id="txtComandName"
                               maxlength="50"
                               required
                               pattern="^[a-zA-Z0-9 ]*$"
                               title="Only Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-command-field">
                        <label class="ecms-command-label" for="txtAbbreviation">
                            <i class="fa fa-font"></i>
                            Abbreviation
                            <i class="fa fa-asterisk mand1"></i>
                        </label>
                        <input class="form-control Alphanumeric js-uppercase"
                               placeholder="Enter Abbreviation"
                               id="txtAbbreviation"
                               maxlength="20"
                               required
                               pattern="^[A-Z0-9 ]*$"
                               title="Only UpperCase Alphabets and Numbers allowed" />
                    </div>

                    <div class="ecms-command-actions">
                        <input type="button" class="btn btn-outline-primary ecms-command-save" value="Save" id="btnsave" />
                        <button type="button" id="btnReset" class="btn btn-outline-danger ecms-command-reset">Reset</button>
                        <div id="msg" class="ecms-command-msg"></div>
                    </div>
                </div>
            </form>
        </div>

        <div class="ecms-command-table-card">
            <div class="ecms-command-table-title">
                <span><i class="fa fa-list"></i> Command / PSO Records</span>
            </div>

            <div class="ecms-command-table-wrap">
                <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-command-modal" id="treeview" tabindex="-1" aria-labelledby="exampleModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div class="ecms-command-modal-title">
                    <span><i class="fa fa-sitemap"></i></span>
                    <h5 class="modal-title" id="exampleModalLabel">Hierarchy Chart</h5>
                </div>
                <button type="button" class="close ecms-command-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="scrolling-wrapper row flex-row flex-nowrap">
                        <div class="col-md-12 text-center">
                            <div class="tree" id="tree">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>

<script asp-src-include="~/developerjs/command.js"></script>
<script asp-src-include="~/developerjs/commandvalidation.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
