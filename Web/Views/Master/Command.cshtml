@inject IConfiguration configuration;
@{
    ViewData["Title"] = "Create Draft";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Cdn = (await CdnHealthService.GetStaticBaseUrlAsync())?.TrimEnd('/');
    string Ver = configuration["StaticVersion"];
}
<link href="@($"{Cdn}/css/hierarchy.css?v={Ver}")" rel="stylesheet" />
<link href="@($"{Cdn}/developercss/command.css?v={Ver}")" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"> <i class="fa fa-bars"></i></div>
                        <a href="/Master/DashboardMaster" class="mr-2">Dashboard</a> > Comd / PSO Details

                    </h1>
                </div>
            </div>

        </div>
    </div>
</header>
<div class="containerMain mt-n10">
    <div class="card mb-3">
        <div class="card-header">

            <span id="SpnTxnId" class="d-none">0</span> 
            <div class="row">
                <div class="col-xl-12 text-left">
                    <h3>
                        Comd / PSO Sectt
                        <small class="text-muted"></small>
                    </h3>
                </div>
            </div>
        </div>
        <div class="card-body card-body-min-height">
            <div class="row">
                <form action="" id="SaveForm" method="post" name="SaveForm">
                    <div class="row">
                        <div class="col-sm-5">
                            <div class="form-group row mb-2">
                                <label class="col-form-label col-sm-4 fw-bold">Comd / PSO<i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">
                                    <input class="form-control Alphanumeric" placeholder="Enter Comd" id="txtComandName" maxlength="50" required pattern="^[a-zA-Z0-9 ]*$" title="Only Alphabets and Numbers allowed" />
                                </div>

                            </div>
                        </div>
                        <div class="col-sm-5">
                            <div class="form-group row mb-2">

                                <label class="col-form-label col-sm-4 fw-bold">Abbreviation <i class="fas fa-asterisk mand1"></i></label>
                                <div class="col-sm-8">

                                    <input class="form-control Alphanumeric js-uppercase" placeholder="Enter Abbreviation" id="txtAbbreviation" maxlength="20" required pattern="^[A-Z0-9 ]*$" title="Only UpperCase Alphabets and Numbers allowed" />
                                </div>

                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="col-sm-12 text-left">
                                <input type="button" class="btn btn-outline-primary " value="Save" id="btnsave" />
                                <button type="button" id="btnReset" class="btn btn-outline-danger">Reset</button>
                            </div>
                            <div class="col-sm-12" id="msg">
                            </div>
                        </div>
                    </div>
                </form>
                <div class="col-xl-12">
                    <div class="mb-2 d-md-flex justify-content-md-between align-items-md-center">
                        <h6 class="mb-3 mb-md-0">
                            &nbsp;
                        </h6>
                        <div>
                            &nbsp;
                        </div>
                    </div>
                    <table class="table table-striped table-hover border border-purple" role="grid" id="tbldata">
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="treeview" tabindex="-1" aria-labelledby="exampleModalLabel" >
    <div class="modal-dialog modal-dialog-centered modal-xl " role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Hierarchy Chart</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close"><span >&times;</span></button>
            </div>
            <div class="modal-body ">   
                <div class="container-fluid">
                    <div class="scrolling-wrapper row flex-row flex-nowrap">
                        <div class="col-md-12 text-center">
                            <div class="tree" id="tree">
                            </div>
                    </div>
                </div>
            </div>
            </div>
        </div><!-- modal-content -->
    </div><!-- modal-dialog -->
</div>
<script src="@($"{Cdn}/developerjs/command.js?v={Ver}")"></script>
<script src="@($"{Cdn}/developerjs/commandvalidation.js?v={Ver}")"></script>

<partial name="~/Views/Shared/_DataTableJS.cshtml" />