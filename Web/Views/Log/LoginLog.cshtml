@model IEnumerable<DataTransferObject.Response.DTOLoginLogResponse>

@{
    ViewData["Title"] = "LoginLog";
}

<link asp-href-include="~/css/offrstimeline.css" rel="stylesheet" />
<link asp-href-include="~/css/horizontaltimeline.css" rel="stylesheet" />
<partial name="~/Views/Shared/_DataTableCSS.cshtml" />
<link asp-href-include="~/developercss/loginlog.css" rel="stylesheet" />

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10 ecms-page-crumb-header">
    <div class="containerMain">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="fa fa-bars"></i></div>
                        <a href="/Home/Index" class="mr-2">Home</a> &gt;
                        <a href="/Home/Dashboard" class="mr-2">Dashboard</a> &gt;
                        <a href="/Home/DashboardUserMgt" class="mr-2">User Mgt</a> &gt; Login Log
                    </h1>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="ecms-loginlog-page ecms-page ecms-page-full">
    <div class="container-fluid ecms-loginlog-container">
        <div class="card ecms-card ecms-card-body ecms-loginlog-shell">
            <div class="ecms-page-title ecms-loginlog-heading d-flex align-items-center">
                <span class="ecms-title-icon ecms-loginlog-heading-icon">
                    <i class="fa fa-history" aria-hidden="true"></i>
                </span>
                <div class="ecms-loginlog-heading-copy">
                    <h3>All Users in Your Unit</h3>
                    <p class="ecms-title-subtitle">View user details and login activity history</p>
                </div>
            </div>

            <div class="card-body ecms-loginlog-body">
                <div class="ecms-form-section ecms-loginlog-toolbar">
                    <div class="ecms-loginlog-toolbar-left">
                        <span class="ecms-filter-icon"><i class="fa fa-filter" aria-hidden="true"></i></span>
                        <span class="ecms-filter-title">Filter Login History</span>
                    </div>

                    <div class="ecms-date-filter d-flex">
                        <div class="ecms-date-field">
                            <label class="form-label" for="FmDate">From</label>
                            <input type="text" class="form-control" id="FmDate" autocomplete="off" readonly />
                        </div>
                        <div class="ecms-date-field">
                            <label class="form-label" for="ToDate">To</label>
                            <input type="text" class="form-control" id="ToDate" autocomplete="off" readonly />
                        </div>
                    </div>
                </div>

                <section class="ecms-section ecms-loginlog-table-section" aria-labelledby="loginLogDirectoryTitle">
                    <div class="ecms-section-title" id="loginLogDirectoryTitle">
                        <i class="fa fa-users mr-1" aria-hidden="true"></i>
                        User Login Directory
                    </div>

                    <div class="ecms-dt-wrap ecms-loginlog-table-wrap">
                        <table class="table table-striped table-hover dataTable ecms-dt-table" role="grid" id="tbldatatabledata">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Domain ID</th>
                                    <th>Army No</th>
                                    <th>Rank</th>
                                    <th>Name</th>
                                    <th>View Login History</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.RoleName)</td>
                                        <td class="DomainID">@Html.DisplayFor(modelItem => item.DomainID)</td>
                                        <td class="ArmyNo">@Html.DisplayFor(modelItem => item.ArmyNo)</td>
                                        <td class="RankName">@Html.DisplayFor(modelItem => item.RankName)</td>
                                        <td class="Name">@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>
                                            <span class="d-none" id="AspNetUsersId">@Html.DisplayFor(modelItem => item.AspNetUsersId)</span>
                                            <button type="button"
                                                    class="cls-btnhistory btn btn-icon btn-round btn-warning mr-1"
                                                    title="View Login History"
                                                    aria-label="View login history">
                                                <i class="fas fa-history" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ecms-loginlog-modal" id="modalLoginLog" aria-labelledby="exampleModalToggleLabel" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog ecms-modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalToggleLabel">
                    <span class="ecms-modal-title-icon"><i class="fa fa-clock" aria-hidden="true"></i></span>
                    <span>Login History of <span class="loginlodetails"></span></span>
                </h5>
                <button type="button"
                        class="btn-close"
                        data-dismiss="modal"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="ecms-form-section ecms-loginlog-modal-toolbar">
                    <div class="ecms-loginlog-modal-toolbar-title">
                        <i class="fa fa-stream" aria-hidden="true"></i>
                        Login Activity Timeline
                    </div>
                    <div id="loginLogExportActions" class="ecms-loginlog-export-actions" aria-label="Login history export actions"></div>
                </div>

                <div class="ecms-loginlog-export-source" aria-hidden="true">
                    <table class="table dataTable" role="grid" id="tbldata">
                        <thead>
                            <tr>
                                <th>Role Name</th>
                                <th>Domain ID</th>
                                <th>Service No</th>
                                <th>Rank Name</th>
                                <th>Name</th>
                                <th>Login On</th>
                                <th>Login IP</th>
                            </tr>
                        </thead>
                        <tbody id="DataBoady"></tbody>
                    </table>
                </div>

                <div class="ecms-timeline-row">
                    <div class="timeline timeline-line-solid" id="timelineData"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script asp-src-include="~/developerjs/loginlog.js"></script>
<partial name="~/Views/Shared/_DataTableJS.cshtml" />
